<section class="fullwidth-section coming-soon-banner-section" id="coming-soon">
  <div class="container text-center">
    <span class="banner-tag red-text">OFFICIAL LAUNCHING SOON • Q4 2026</span>

    <h2 class="banner-title">
      PT CHAIN ASIA CONECT <br /><span class="red-text">Is Preparing For Full Operational Launch</span>
    </h2>

    <p class="banner-text">
      We are actively preparing our physical service ecosystem, long-term B2B supply chain infrastructure, and strategic partnerships across Indonesia and the Asian region. Stay tuned for our official grand launch.
    </p>

    <div class="banner-actions">
      <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="btn-red-large">
        <span>Get Priority B2B Access (WhatsApp)</span>
      </a>
      <a href="mailto:info@chainasiaconect.company" class="btn-outline-large">
        <span>info@chainasiaconect.company</span>
      </a>
    </div>
  </div>
</section>

<style>
  .coming-soon-banner-section {
    background: linear-gradient(rgba(10, 10, 12, 0.85), rgba(10, 10, 12, 0.92)), url('/images/ornate-bg.jpg') center/cover no-repeat;
    padding: 3.5rem 0;
    border-top: 1px solid rgba(239, 68, 68, 0.4);
    border-bottom: 1px solid rgba(239, 68, 68, 0.4);
    color: #ffffff;
  }

  .text-center {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .banner-tag {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
    color: #ef4444;
  }

  .banner-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .banner-title .red-text {
    color: #ef4444;
  }

  .banner-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #e2e8f0;
    margin-bottom: 1.75rem;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-red-large {
    padding: 0.75rem 1.75rem;
    background: #dc2626;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.925rem;
    border-radius: 4px;
    transition: background var(--transition-smooth);
  }

  .btn-red-large:hover {
    background: #b91c1c;
  }

  .btn-outline-large {
    padding: 0.75rem 1.75rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.925rem;
    border-radius: 4px;
    transition: all var(--transition-smooth);
  }

  .btn-outline-large:hover {
    border-color: #ef4444;
    color: #ef4444;
  }

  @media (max-width: 640px) {
    .banner-actions {
      flex-direction: column;
    }
  }
</style>

