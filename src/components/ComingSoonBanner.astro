---
---

<section class="fullwidth-section expansion-banner-section" id="expansion-banner">
  <div class="container text-center">
    <div class="neu-card-raised banner-neu-box">
      <div class="neu-pill-inset banner-badge-neu">
        <span class="neu-dot red-dot"></span>
        <span class="banner-tag red-text" data-i18n="banner_tag">STRATEGIC EXPANSION & ENTERPRISE SCALING</span>
      </div>

      <h2 class="banner-title" data-i18n="banner_title">
        PT CHAIN ASIA CONECT <br /><span class="red-text">Strategic Expansion & Enterprise Scaling Phase</span>
      </h2>

      <p class="banner-text" data-i18n="banner_desc">
        As a principal business entity focused on sustainable diversification and enterprise scaling, we are open for strategic B2B collaborations in integrated supply chain infrastructure, high-precision medical machinery engineering & 3D PACS software licensing, and new regional branch operations across Indonesia and Asia.
      </p>

      <div class="banner-actions">
        <a href="mailto:sales@chainasiaconect.company" class="neu-btn-primary">
          <span data-i18n="btn_partnership">Inquire Strategic Partnership (sales@chainasiaconect.company)</span>
        </a>
        <a href="mailto:info@chainasiaconect.company" class="neu-btn-secondary">
          <span data-i18n="btn_contact">info@chainasiaconect.company</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .expansion-banner-section {
    background: #edf2f7;
    padding: 4.5rem 0;
    border-top: 1px solid rgba(203, 213, 225, 0.7);
    border-bottom: 1px solid rgba(203, 213, 225, 0.7);
  }

  .text-center {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Solid Neumorphic Raised Card */
  .banner-neu-box {
    background: #edf2f7;
    border-radius: 16px;
    padding: 3rem 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 
      9px 9px 22px rgba(166, 175, 195, 0.5),
      -9px -9px 22px rgba(255, 255, 255, 0.95);
  }

  /* Inset Badge */
  .banner-badge-neu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #edf2f7;
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(203, 213, 225, 0.7);
    box-shadow: 
      inset 2px 2px 5px rgba(166, 175, 195, 0.5),
      inset -2px -2px 5px rgba(255, 255, 255, 0.9);
    margin-bottom: 1rem;
  }

  .neu-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .red-dot {
    background: #dc2626;
  }

  .banner-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .banner-title {
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .banner-title .red-text {
    color: #dc2626;
  }

  .banner-text {
    font-size: 1.025rem;
    line-height: 1.75;
    color: #475569;
    margin-bottom: 2rem;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .neu-btn-primary {
    padding: 0.85rem 1.6rem;
    background: #dc2626;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.925rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 
      4px 4px 10px rgba(220, 38, 38, 0.35),
      -2px -2px 6px rgba(255, 255, 255, 0.8);
    transition: all 0.2s ease;
  }

  .neu-btn-primary:hover {
    background: #b91c1c;
    box-shadow: 
      2px 2px 6px rgba(220, 38, 38, 0.4),
      inset 1px 1px 2px rgba(0, 0, 0, 0.2);
    transform: translateY(1px);
  }

  .neu-btn-secondary {
    padding: 0.85rem 1.6rem;
    background: #edf2f7;
    color: #334155;
    font-weight: 700;
    font-size: 0.925rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid rgba(203, 213, 225, 0.7);
    box-shadow: 
      3px 3px 8px rgba(166, 175, 195, 0.35),
      -3px -3px 8px rgba(255, 255, 255, 0.9);
    transition: all 0.2s ease;
  }

  .neu-btn-secondary:hover {
    color: #dc2626;
    background: #ffffff;
    box-shadow: 
      1px 1px 4px rgba(166, 175, 195, 0.4),
      inset 1px 1px 2px rgba(255, 255, 255, 1);
  }

  @media (max-width: 640px) {
    .banner-neu-box {
      padding: 2rem 1.25rem;
    }
    .banner-actions {
      flex-direction: column;
      width: 100%;
    }
    .neu-btn-primary,
    .neu-btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>

