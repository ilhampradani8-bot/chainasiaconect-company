<section class="fullwidth-section coming-soon-banner-section" id="coming-soon">
  <div class="container text-center">
    <span class="banner-tag red-text">OFFICIAL LAUNCHING SOON • Q4 2026</span>

    <h2 class="banner-title">
      PT CHAIN ASIA CONECT <br /><span class="red-text">Is Preparing For Full Operational Launch</span>
    </h2>

    <p class="banner-text">
      We are actively preparing our physical service ecosystem, long-term B2B supply chain infrastructure, and strategic partnerships across Indonesia and the Asian region. Stay tuned for our official grand launch.
    </p>

    <div class="banner-actions">
      <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="btn-red-large">
        <span>Get Priority B2B Access (WhatsApp)</span>
      </a>
      <a href="mailto:info@chainasiaconect.company" class="btn-outline-large">
        <span>info@chainasiaconect.company</span>
      </a>
    </div>
  </div>
</section>

<style>
  .coming-soon-banner-section {
    background: #f8fafc;
    padding: 5.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .text-center {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .banner-tag {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .banner-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-body);
    margin-bottom: 2.25rem;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-red-large {
    padding: 0.85rem 1.85rem;
    background: var(--red-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 4px;
    transition: background var(--transition-smooth);
  }

  .btn-red-large:hover {
    background: var(--red-dark);
  }

  .btn-outline-large {
    padding: 0.85rem 1.85rem;
    background: #ffffff;
    border: 1px solid var(--border-light);
    color: var(--text-dark);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 4px;
    transition: border-color var(--transition-smooth);
  }

  .btn-outline-large:hover {
    border-color: var(--red-primary);
    color: var(--red-primary);
  }

  @media (max-width: 640px) {
    .banner-actions {
      flex-direction: column;
    }
  }
</style>
