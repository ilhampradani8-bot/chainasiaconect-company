---
---

<section class="fullwidth-section hero-classic" id="hero">
  <div class="container">
    <div class="editorial-grid">
      <!-- Left Hero Text Content -->
      <div class="hero-editorial">
        <div class="classic-badge">
          <span class="classic-badge-dot"></span>
          <span>PT CHAIN ASIA CONECT • WE ARE LAUNCHING SOON</span>
        </div>

        <h1 class="hero-heading">
          Ekosistem Rantai Pasok <br /><span class="gold-text">& Layanan Fisik Terintegrasi</span>
        </h1>

        <div class="gold-divider-small"></div>

        <p class="hero-lead">
          PT CHAIN ASIA CONECT mengukuhkan langkah transformasi strategis berorientasi keberlanjutan usaha fisik di wilayah <strong>Krui, Pesisir Barat, Lampung</strong>. Mengintegrasikan keandalan Rantai Pasok (<em>Supply Chain</em>) dan nilai tambah layanan fisik yang stabil dan terukur.
        </p>

        <!-- Subscription Form Fullwidth Style -->
        <div class="subscribe-wrapper">
          <form class="classic-form" id="hero-notify-form">
            <input type="email" placeholder="Email bisnis Anda untuk akses kemitraan..." required class="classic-input" id="hero-email-input" />
            <button type="submit" class="btn-classic btn-classic-filled">
              <span>Dapatkan Akses</span>
            </button>
          </form>
          <div class="form-feedback" id="hero-form-notice">
            🔒 Informasi kemitraan B2B & operasional resmi akan dikirimkan secara terbatas.
          </div>
        </div>
      </div>

      <!-- Right Editorial Image Visual -->
      <div class="hero-visual-frame">
        <div class="image-wrapper-classic">
          <img src="/images/CAC-LOGO.jpg" alt="PT CHAIN ASIA CONECT Official Emblem" class="hero-main-img" />
          <div class="image-gold-border"></div>
        </div>
        <div class="visual-caption">
          <span class="caption-title gold-text">PT CHAIN ASIA CONECT</span>
          <span class="caption-subtitle">Terdaftar Resmi Kemenkumham RI & NIB 0709260109599</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('hero-notify-form');
  const notice = document.getElementById('hero-form-notice');

  if (form && notice) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('hero-email-input') as HTMLInputElement;
      if (input && input.value) {
        notice.innerHTML = `<span style="color: #10b981; font-weight: 600;">✓ Terima kasih! Email <strong>${input.value}</strong> telah didaftarkan dalam daftar prioritas mitra.</span>`;
        input.value = '';
      }
    });
  }
</script>

<style>
  .hero-classic {
    padding: 7rem 0 6rem 0;
    background: radial-gradient(circle at 10% 20%, rgba(212, 175, 55, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(13, 16, 28, 0.9) 0%, transparent 50%);
  }

  .hero-heading {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    margin: 1.5rem 0 1rem 0;
    line-height: 1.15;
  }

  .hero-lead {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .subscribe-wrapper {
    margin-top: 2rem;
  }

  .classic-form {
    display: flex;
    gap: 0.75rem;
    max-width: 580px;
  }

  .classic-input {
    flex: 1;
    background: rgba(13, 16, 28, 0.9);
    border: 1px solid var(--border-classic);
    padding: 0.9rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-primary);
    outline: none;
    transition: all var(--transition-smooth);
  }

  .classic-input:focus {
    border-color: var(--gold-primary);
    box-shadow: 0 0 15px var(--gold-glow);
  }

  .form-feedback {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
  }

  /* Right Visual Frame */
  .hero-visual-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .image-wrapper-classic {
    position: relative;
    width: 100%;
    max-width: 440px;
    padding: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-classic);
  }

  .hero-main-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
    filter: brightness(0.95);
  }

  .image-gold-border {
    position: absolute;
    inset: 6px;
    border: 1px solid var(--gold-primary);
    pointer-events: none;
    opacity: 0.6;
  }

  .visual-caption {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .caption-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .caption-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .classic-form {
      flex-direction: column;
    }
  }
</style>
