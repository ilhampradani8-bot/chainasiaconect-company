---

<section class="fullwidth-section hero-section-clean" id="hero">
  <div class="container hero-container-clean">
    <!-- Pure English Text Content (No Image in Hero 1) -->
    <div class="hero-content-clean">
      <span class="hero-tag-text red-text">PT CHAIN ASIA CONECT • WE ARE LAUNCHING SOON</span>

      <h1 class="hero-title-clean">
        Supply Chain Solutions <br /><span class="red-text">& Real Business Ecosystem</span>
      </h1>

      <p class="hero-lead-clean">
        PT CHAIN ASIA CONECT solidifies a strategic transformation towards sustainable physical business operations in <strong>Krui, Pesisir Barat, Lampung</strong>. Integrating supply chain reliability with stable and measurable real physical value.
      </p>

      <!-- Clean Subscription Input (No Capsule Card) -->
      <div class="subscribe-clean">
        <form class="clean-form" id="hero-notify-form">
          <input type="email" placeholder="Enter your corporate email..." required class="clean-input" id="hero-email-input" />
          <button type="submit" class="btn-red-clean">
            <span>Get Access</span>
          </button>
        </form>
        <div class="form-notice-clean" id="hero-form-notice">
          🔒 Official B2B partnership & operational updates will be delivered exclusively.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('hero-notify-form');
  const notice = document.getElementById('hero-form-notice');

  if (form && notice) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('hero-email-input') as HTMLInputElement;
      if (input && input.value) {
        notice.innerHTML = `<span style="color: #16a34a; font-weight: 600;">✓ Thank you! Email <strong>${input.value}</strong> has been registered for priority access.</span>`;
        emailInput.value = '';
      }
    });
  }
</script>

<style>
  .hero-section-clean {
    padding: 5rem 0 4rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
  }

  .hero-container-clean {
    max-width: 900px;
  }

  .hero-content-clean {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-tag-text {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .hero-title-clean {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    margin: 0.5rem 0 1.25rem 0;
    line-height: 1.15;
    color: var(--text-dark);
  }

  .hero-lead-clean {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-body);
    margin-bottom: 2.25rem;
  }

  .subscribe-clean {
    width: 100%;
  }

  .clean-form {
    display: flex;
    gap: 0.75rem;
    max-width: 580px;
  }

  .clean-input {
    flex: 1;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-dark);
    outline: none;
    border-radius: 4px;
  }

  .clean-input:focus {
    border-color: var(--red-primary);
  }

  .btn-red-clean {
    padding: 0.75rem 1.75rem;
    background: var(--red-primary);
    color: #ffffff;
    border: none;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    transition: background var(--transition-smooth);
  }

  .btn-red-clean:hover {
    background: var(--red-dark);
  }

  .form-notice-clean {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-top: 0.65rem;
  }

  @media (max-width: 640px) {
    .clean-form {
      flex-direction: column;
    }
  }
</style>
