---
---

<section class="hero-section" id="hero">
  <!-- Dynamic Glow Gradients -->
  <div class="hero-bg-glow glow-1"></div>
  <div class="hero-bg-glow glow-2"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Launching Soon Badge -->
      <div class="badge animate-float">
        <span class="badge-dot"></span>
        <span>PT CHAIN ASIA CONECT • LAUNCHING SOON</span>
      </div>

      <!-- Main Heading -->
      <h1 class="hero-title">
        Solusi Rantai Pasok <span class="gradient-text">& Ekosistem Usaha Riil</span> Terintegrasi
      </h1>

      <!-- Description based on detail.txt -->
      <p class="hero-subtitle">
        PT CHAIN ASIA CONECT hadir melakukan transformasi usaha strategis di kawasan <strong>Krui, Pesisir Barat</strong>. Berfokus pada keandalan Rantai Pasok (<em>Supply Chain</em>), integrasi nilai usaha fisik, dan kemitraan B2B yang solid.
      </p>

      <!-- Legal Summary Badges -->
      <div class="legal-summary-card glass-card">
        <div class="legal-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg>
          <span>Entitas Resmi Terdaftar Legal | PT Perorangan (1 Sept 2026)</span>
        </div>
        <div class="legal-grid">
          <div class="legal-item">
            <span class="legal-label">SK Kemenkumham</span>
            <strong class="legal-val">AHU-A117353.AH.01.30.Tahun 2026</strong>
          </div>
          <div class="legal-item">
            <span class="legal-label">NIB (KBLI 62193)</span>
            <strong class="legal-val">0709260109599</strong>
          </div>
          <div class="legal-item">
            <span class="legal-label">NPWP Perusahaan</span>
            <strong class="legal-val">10.000.000.1-094.6336</strong>
          </div>
        </div>
      </div>

      <!-- Subscription / Action Box -->
      <div class="hero-action-box">
        <form class="hero-subscribe-form" id="notify-form">
          <div class="input-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mail-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <input type="email" placeholder="Masukkan email bisnis untuk akses awal..." required class="hero-email-input" id="hero-email" />
          </div>
          <button type="submit" class="btn btn-primary">
            <span>Dapatkan Akses Kemitraan</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>
        <p class="form-notice" id="form-notice">
          🔒 Kami menjaga privasi Anda. Informasi resmi peluncuran akan dikirimkan secara eksklusif.
        </p>
      </div>
    </div>

    <!-- Right Side Visual Banner Frame -->
    <div class="hero-visual">
      <div class="image-frame glass-card">
        <div class="corner-embellishment top-left"></div>
        <div class="corner-embellishment bottom-right"></div>
        <img src="/images/CAC-LOGO.jpg" alt="PT CHAIN ASIA CONECT Corporate Visual" class="hero-banner-img" />
        
        <div class="image-overlay-card glass-card">
          <div class="overlay-stat">
            <div class="stat-number">100%</div>
            <div class="stat-label">Komitmen Kemitraan B2B</div>
          </div>
          <div class="overlay-divider"></div>
          <div class="overlay-stat">
            <div class="stat-number">Krui</div>
            <div class="stat-label">Pesisir Barat, Lampung</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('notify-form');
  const notice = document.getElementById('form-notice');

  if (form && notice) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('hero-email') as HTMLInputElement;
      if (emailInput && emailInput.value) {
        notice.innerHTML = `<span style="color: #10b981; font-weight: 600;">✓ Terima kasih! Email <strong>${emailInput.value}</strong> telah terdaftar. Kami akan menghubungi Anda segera saat peluncuran.</span>`;
        emailInput.value = '';
      }
    });
  }
</script>

<style>
  .hero-section {
    position: relative;
    padding: 5rem 0 6rem 0;
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }

  .glow-1 {
    top: 5%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: rgba(6, 182, 212, 0.15);
  }

  .glow-2 {
    bottom: 10%;
    right: -10%;
    width: 550px;
    height: 550px;
    background: rgba(16, 185, 129, 0.12);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    font-weight: 800;
    margin: 1.5rem 0 1rem 0;
    line-height: 1.12;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .legal-summary-card {
    width: 100%;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .legal-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary-light);
    margin-bottom: 0.85rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .legal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .legal-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .legal-label {
    font-size: 0.725rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .legal-val {
    font-size: 0.825rem;
    color: var(--text-main);
    font-weight: 600;
    word-break: break-word;
  }

  .hero-action-box {
    width: 100%;
  }

  .hero-subscribe-form {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .input-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .mail-icon {
    position: absolute;
    left: 1.2rem;
    color: var(--text-dim);
    pointer-events: none;
  }

  .hero-email-input {
    width: 100%;
    padding: 0.95rem 1.2rem 0.95rem 3.2rem;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: #ffffff;
    outline: none;
    transition: all var(--transition-fast);
  }

  .hero-email-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.25);
  }

  .form-notice {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  /* Right Side Image Frame */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .image-frame {
    position: relative;
    width: 100%;
    max-width: 460px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 12px;
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
    border: 1px solid var(--border-glow);
  }

  .hero-banner-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 8px);
    display: block;
    filter: brightness(0.95) contrast(1.05);
  }

  .image-overlay-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: rgba(7, 9, 19, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .overlay-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--primary-light);
  }

  .stat-label {
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  .overlay-divider {
    width: 1px;
    height: 30px;
    background: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
    }
    .legal-grid {
      grid-template-columns: 1fr;
    }
    .hero-subscribe-form {
      flex-direction: column;
    }
    .hero-visual {
      margin-top: 2rem;
    }
  }
</style>
