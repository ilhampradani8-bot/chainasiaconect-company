---
---

<section class="fullwidth-section hero-section-lux" id="hero">
  <!-- Subtle gradient & soft blur layer behind text on the left -->
  <div class="hero-bg-overlay"></div>

  <div class="hero-container-lux">
    <div class="hero-content-lux">
      <span class="hero-tag-text red-text">PT CHAIN ASIA CONECT • ENTERPRISE EXPANSION & BUSINESS DEVELOPMENT</span>

      <h1 class="hero-title-lux">
        Supply Chain Solutions <br /><span class="red-text">& Real Business Ecosystem</span>
      </h1>

      <p class="hero-lead-lux" data-i18n="hero_lead">
        PT CHAIN ASIA CONECT solidifies a strategic transformation towards sustainable physical business operations across Indonesia & the Asian region. Integrating supply chain reliability with stable and measurable real physical value.
      </p>

      <!-- Hero Action Buttons -->
      <div class="hero-actions-lux">
        <a href="/contact" class="btn-more-red" data-i18n="hero_btn_consult">
          <span>Consult Business Solutions →</span>
        </a>
        <a href="/scf" class="btn-secondary-clean" data-i18n="hero_btn_scf">
          <span>SCF Platform (Coming Soon)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section-lux {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 94vh;
    padding: clamp(8.5rem, 14vh, 11rem) 0 clamp(5.5rem, 11vh, 8rem) 0;
    display: flex;
    align-items: center;
    background-image: url('/Gemini_Generated_Image_pj03k2pj03k2pj03.jpeg');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    border-bottom: none;
    box-sizing: border-box;
    overflow: hidden;
    will-change: transform;
    transform-origin: center top;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.78) 0%,
      rgba(255, 255, 255, 0.48) 38%,
      rgba(255, 255, 255, 0.12) 65%,
      transparent 100%
    );
    z-index: 0;
    pointer-events: none;
    will-change: opacity;
  }

  .hero-container-lux {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-left: clamp(1.5rem, 6vw, 5.5rem);
    padding-right: clamp(1.5rem, 4vw, 3rem);
    box-sizing: border-box;
  }

  /* Clean Left-Corner Typography (No Box/Card) */
  .hero-content-lux {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 780px;
    background: transparent;
    padding: 0;
    border: none;
    box-shadow: none;
    will-change: transform, opacity;
    transform-origin: left center;
  }

  .hero-tag-text {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9);
  }

  .hero-title-lux {
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 800;
    margin: 0.35rem 0 1.25rem 0;
    line-height: 1.15;
    color: var(--text-dark);
    letter-spacing: -0.02em;
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.9);
  }

  .hero-lead-lux {
    font-size: clamp(1.05rem, 1.8vw, 1.18rem);
    line-height: 1.8;
    color: var(--text-body);
    margin: 0 0 2.25rem 0;
    max-width: 700px;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  }

  .hero-actions-lux {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-more-red {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.85rem;
    background: #dc2626;
    color: #ffffff !important;
    font-weight: 800;
    font-size: 0.95rem;
    border-radius: 50px;
    border: 1px solid #b91c1c;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(185, 28, 28, 0.45), 0 2px 4px rgba(0, 0, 0, 0.15);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    transition: all 0.25s ease;
  }

  .btn-more-red:hover {
    background: #b91c1c;
    border-color: #991b1b;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(185, 28, 28, 0.6), 0 3px 6px rgba(0, 0, 0, 0.2);
  }

  .btn-secondary-clean {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.85rem;
    background: #ffffff;
    color: #0f172a !important;
    font-weight: 800;
    font-size: 0.95rem;
    border-radius: 50px;
    border: 1.5px solid #94a3b8;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1), 0 1px 3px rgba(0, 0, 0, 0.05);
    transition: all 0.25s ease;
  }

  .btn-secondary-clean:hover {
    background: #f8fafc;
    border-color: #dc2626;
    color: #dc2626 !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(220, 38, 38, 0.2), 0 2px 6px rgba(15, 23, 42, 0.08);
  }

  @media (max-width: 768px) {
    .hero-section-lux {
      padding: 6.85rem 0 3.75rem 0;
      min-height: auto;
      background-position: center;
    }

    .hero-container-lux {
      padding-left: 1.15rem;
      padding-right: 1.15rem;
    }

    .hero-bg-overlay {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .hero-tag-text {
      font-size: clamp(0.72rem, 2.7vw, 0.82rem);
      line-height: 1.4;
      margin-bottom: 0.5rem;
    }

    .hero-title-lux {
      font-size: clamp(1.85rem, 6.8vw, 2.85rem);
      line-height: 1.2;
      margin-bottom: 1rem;
    }

    .hero-lead-lux {
      font-size: clamp(0.95rem, 3.6vw, 1.08rem);
      line-height: 1.65;
      margin-bottom: 1.75rem;
    }

    .hero-actions-lux {
      flex-direction: column;
      width: 100%;
      gap: 0.75rem;
    }

    .hero-actions-lux .btn-more-red,
    .hero-actions-lux .btn-secondary-clean {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      justify-content: center;
      padding: 0.85rem 1.25rem;
    }
  }
</style>

<script>
  function setupHeroSlowmoParallax() {
    const hero = document.getElementById('hero');
    const heroContent = document.querySelector<HTMLElement>('.hero-content-lux');
    if (!hero) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    let isTicking = false;

    function onScroll() {
      if (!isTicking) {
        window.requestAnimationFrame(() => {
          const scrollY = Math.max(0, window.pageYOffset || document.documentElement.scrollTop);
          const heroHeight = hero.offsetHeight || 600;

          // Parallax calculation active while hero is visible or being covered
          if (scrollY <= heroHeight + 120) {
            // Hero section moves down at 45% of scroll speed (so it recedes slowly - slow motion!)
            const heroTranslateY = scrollY * 0.45;
            hero.style.transform = `translate3d(0, ${heroTranslateY}px, 0)`;

            if (heroContent) {
              // Typography moves at a subtle separate rate and gracefully dims & scales
              const textTranslateY = scrollY * 0.12;
              const scale = Math.max(0.92, 1 - (scrollY / heroHeight) * 0.08);
              const opacity = Math.max(0.15, 1 - (scrollY / (heroHeight * 0.72)) * 0.85);

              heroContent.style.transform = `translate3d(0, ${textTranslateY}px, 0) scale(${scale})`;
              heroContent.style.opacity = `${opacity}`;
            }
          }
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    // Initial calculation on load
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroSlowmoParallax);
  } else {
    setupHeroSlowmoParallax();
  }
</script>
