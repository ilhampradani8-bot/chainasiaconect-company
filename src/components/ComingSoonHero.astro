---
---

<section class="fullwidth-section hero-section-lux" id="hero">
  <!-- Lux background image layer -->
  <div class="hero-bg-overlay"></div>

  <div class="container hero-container-lux">
    <div class="hero-content-lux">
      <span class="hero-tag-text red-text">PT CHAIN ASIA CONECT • ENTERPRISE EXPANSION & BUSINESS DEVELOPMENT</span>

      <h1 class="hero-title-lux">
        Supply Chain Solutions <br /><span class="red-text">& Real Business Ecosystem</span>
      </h1>

      <p class="hero-lead-lux" data-i18n="hero_lead">
        PT CHAIN ASIA CONECT solidifies a strategic transformation towards sustainable physical business operations across Indonesia & the Asian region. Integrating supply chain reliability with stable and measurable real physical value.
      </p>

      <!-- Hero Action Buttons with Neumorphism -->
      <div class="hero-actions-lux" style="display: flex; align-items: center; gap: 1.25rem; margin-top: 2rem; flex-wrap: wrap;">
        <a href="/contact" class="btn-more-red" data-i18n="hero_btn_consult">
          <span>Consult Business Solutions →</span>
        </a>
        <a href="/scf" class="btn-secondary-clean" data-i18n="hero_btn_scf">
          <span>SCF Platform (Coming Soon)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section-lux {
    position: relative;
    padding: 6rem 0;
    background-image: url('/images/lux-bg.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--border-light);
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.92);
    z-index: 0;
  }

  .hero-container-lux {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero-content-lux {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-tag-text {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .hero-title-lux {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    margin: 0.5rem 0 1rem 0;
    line-height: 1.15;
    color: var(--text-dark);
  }

  .hero-lead-lux {
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text-body);
  }

  @media (max-width: 768px) {
    .hero-section-lux {
      padding: 4rem 0;
    }
  }
</style>
