---
---

<section class="fullwidth-section direktur-section-clean" id="leadership">
  <div class="container">
    <div class="leadership-header-clean">
      <span class="section-tag-clean red-text">BOARD OF DIRECTORS & EXECUTIVE LEADERSHIP</span>
      <h2 class="section-title-clean">
        Executive Governance <span class="red-text">& Entity Leadership</span>
      </h2>
      <p class="section-subtitle-clean">
        Driven by strategic vision, legal compliance, and operational excellence across regional physical business ecosystems.
      </p>
    </div>

    <!-- 2 Directors Text Layout (Clean Editorial) -->
    <div class="directors-stack">
      <!-- Director 01: President Director -->
      <div class="director-block">
        <div class="director-meta">
          <span class="director-num red-text">DIRECTOR 01</span>
          <span class="director-badge">President Director</span>
        </div>

        <div class="director-main">
          <h3 class="owner-name-clean">Ilham Pradani, S.H. (Cand.)</h3>
          <span class="owner-title-clean">President Director & Founder (Direktur Utama)</span>

          <p class="owner-quote-clean">
            “The strategic decision to expand into the real physical business sector represents a measured and sustainability-driven transformation. Through alignment of corporate identity philosophy and professional operational standards, the company is committed to becoming a reliable strategic partner supporting local and regional industrial growth.”
          </p>

          <div class="owner-info-clean">
            <div class="info-row">
              <span class="info-label">Executive Email:</span>
              <a href="mailto:ilhampradani@chainasiaconect.company" class="info-link red-text">ilhampradani@chainasiaconect.company</a>
            </div>
            <div class="info-row">
              <span class="info-label">Founder Website:</span>
              <a href="https://ilhampradani.me" target="_blank" rel="noopener" class="info-link">https://ilhampradani.me</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Director 02: Financial Director (Putri Wulan, S.T.) -->
      <div class="director-block">
        <div class="director-meta">
          <span class="director-num red-text">DIRECTOR 02</span>
          <span class="director-badge badge-finance">Financial Director</span>
        </div>

        <div class="director-main">
          <h3 class="owner-name-clean">Putri Wulan, S.T.</h3>
          <span class="owner-title-clean">Financial Director (Direktur Keuangan)</span>

          <p class="owner-quote-clean">
            “Overseeing financial governance, capital allocation, re-investment reserves, and ethical profit distribution. Directing institutional financial compliance and managing company assets with complete transparency and social responsibility.”
          </p>

          <div class="owner-info-clean">
            <div class="info-row">
              <span class="info-label">Executive Email:</span>
              <a href="mailto:wulanputri@chainasiaconect.company" class="info-link red-text">wulanputri@chainasiaconect.company</a>
            </div>
            <div class="info-row">
              <span class="info-label">Executive Standing:</span>
              <strong class="info-val">Financial Director & Executive Board Member</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .direktur-section-clean {
    background: #ffffff;
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .leadership-header-clean {
    max-width: 800px;
    margin-bottom: 2.5rem;
  }

  .section-tag-clean {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .section-title-clean {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .section-subtitle-clean {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  /* 2 Directors Stack */
  .directors-stack {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .director-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .director-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .director-num {
    font-size: 0.775rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .director-badge {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    background: #fef2f2;
    color: var(--red-primary);
    border-radius: 4px;
  }

  .director-badge.badge-finance {
    background: #f8fafc;
    color: var(--red-primary);
    border: 1px solid var(--border-light);
  }

  .owner-name-clean {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .owner-title-clean {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-top: 0.2rem;
    display: block;
  }

  .owner-quote-clean {
    font-size: 1rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--text-body);
    margin: 1rem 0 1.25rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--red-primary);
    max-width: 900px;
  }

  .owner-info-clean {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    width: 100%;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .info-label {
    width: 170px;
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .info-val {
    font-weight: 600;
    color: var(--text-dark);
  }

  .info-link {
    font-weight: 600;
    color: var(--text-dark);
    text-decoration: none;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .info-link.red-text {
    color: var(--red-primary);
  }

  @media (max-width: 640px) {
    .info-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
    .info-label {
      width: 100%;
    }
  }
</style>
