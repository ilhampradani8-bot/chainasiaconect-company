<section class="fullwidth-section direktur-section-clean" id="leadership">
  <div class="container">
    <div class="editorial-grid">
      <!-- Left Column: Owner Photo (Clean photo, no card/frame box) -->
      <div class="direktur-photo-clean">
        <img src="/images/hero-owner.jpg" alt="Ilham Pradani - Chief Executive Officer of PT CHAIN ASIA CONECT" class="photo-clean" />
      </div>

      <!-- Right Column: Biography (Pure English text, no capsule cards) -->
      <div class="direktur-text-clean">
        <span class="section-tag-clean red-text">EXECUTIVE LEADERSHIP</span>

        <h2 class="owner-name-clean">Ilham Pradani</h2>
        <span class="owner-title-clean">Chief Executive Officer & Entity Owner</span>

        <p class="owner-quote-clean">
          “The strategic decision to expand into the real physical business sector in Krui, Pesisir Barat, represents a measured and sustainability-driven transformation. Through alignment of corporate identity philosophy and professional operational standards, the company is committed to becoming a reliable strategic partner supporting local and regional industrial growth.”
        </p>

        <div class="owner-info-clean">
          <div class="info-row">
            <span class="info-label">Business Entity:</span>
            <strong class="info-val">PT CHAIN ASIA CONECT</strong>
          </div>
          <div class="info-row">
            <span class="info-label">Owner Website:</span>
            <a href="https://ilhampradani.me" target="_blank" rel="noopener" class="info-link red-text">https://ilhampradani.me</a>
          </div>
          <div class="info-row">
            <span class="info-label">Executive Email:</span>
            <a href="mailto:hello@ilhampradani.me" class="info-link">hello@ilhampradani.me</a>
          </div>
          <div class="info-row">
            <span class="info-label">Legal Status:</span>
            <span class="info-val">SK Kemenkumham AHU-A117353.AH.01.30.Tahun 2026</span>
          </div>
        </div>

        <div class="owner-actions-clean">
          <a href="https://ilhampradani.me" target="_blank" rel="noopener" class="btn-text-link red-text">
            <span>Owner Full Profile (ilhampradani.me) →</span>
          </a>
          <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="btn-red-simple">
            <span>Contact Executive (WhatsApp)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .direktur-section-clean {
    background: #ffffff;
    padding: 5rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .direktur-photo-clean {
    display: flex;
    justify-content: center;
  }

  .photo-clean {
    width: 100%;
    max-width: 380px;
    height: 440px;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  .direktur-text-clean {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-tag-clean {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .owner-name-clean {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.1;
  }

  .owner-title-clean {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .owner-quote-clean {
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.75;
    color: var(--text-body);
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--red-primary);
  }

  .owner-info-clean {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    margin-bottom: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.925rem;
  }

  .info-label {
    width: 130px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .info-val, .info-link {
    font-weight: 600;
  }

  .owner-actions-clean {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-text-link {
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .btn-red-simple {
    padding: 0.65rem 1.4rem;
    background: var(--red-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 4px;
    transition: background var(--transition-smooth);
  }

  .btn-red-simple:hover {
    background: var(--red-dark);
  }

  @media (max-width: 768px) {
    .info-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
    .info-label {
      width: 100%;
    }
  }
</style>
