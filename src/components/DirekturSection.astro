<section class="fullwidth-section direktur-section-clean" id="leadership">
  <div class="container">
    <div class="editorial-grid">
      <!-- Left Column: Owner Photo (Raw, unedited image display) -->
      <div class="direktur-photo-clean">
        <img src="/images/hero-owner.jpg" alt="Ilham Pradani, S.H. - President Director of PT CHAIN ASIA CONECT" class="photo-raw" />
      </div>

      <!-- Right Column: Biography -->
      <div class="direktur-text-clean">
        <span class="section-tag-clean red-text">CORPORATE LEADERSHIP</span>

        <h2 class="owner-name-clean">Ilham Pradani, S.H.</h2>
        <span class="owner-title-clean">President Director & Founder</span>

        <p class="owner-quote-clean">
          “The strategic decision to expand into the real physical business sector represents a measured and sustainability-driven transformation. Through alignment of corporate identity philosophy and professional operational standards, the company is committed to becoming a reliable strategic partner supporting local and regional industrial growth.”
        </p>

        <div class="owner-info-clean">
          <div class="info-row">
            <span class="info-label">Business Entity:</span>
            <strong class="info-val">PT CHAIN ASIA CONECT</strong>
          </div>
          <div class="info-row">
            <span class="info-label">Corporate Title:</span>
            <strong class="info-val">President Director (Direktur Utama)</strong>
          </div>
          <div class="info-row">
            <span class="info-label">Owner Website:</span>
            <a href="https://ilhampradani.me" target="_blank" rel="noopener" class="info-link red-text">https://ilhampradani.me</a>
          </div>
          <div class="info-row">
            <span class="info-label">Executive Email:</span>
            <a href="mailto:hello@ilhampradani.me" class="info-link">hello@ilhampradani.me</a>
          </div>
          <div class="info-row">
            <span class="info-label">Legal Decree:</span>
            <span class="info-val">SK Kemenkumham AHU-A117353.AH.01.30.Year 2026</span>
          </div>
        </div>

        <div class="owner-actions-clean">
          <a href="https://ilhampradani.me" target="_blank" rel="noopener" class="btn-text-link red-text">
            <span>Owner Full Profile (ilhampradani.me) →</span>
          </a>
          <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="btn-red-simple">
            <span>Contact Executive (WhatsApp)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Who is Next CFO Section (Clean SVG & Text) -->
    <div class="cfo-expansion-block">
      <div class="cfo-svg-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <div class="cfo-content">
        <h3 class="cfo-title">Who is Next CFO?</h3>
        <p class="cfo-desc">
          As PT CHAIN ASIA CONECT expands its physical business ecosystem and regional supply chain networks, we are actively structuring our Executive Board. We welcome strategic Chief Financial Officer (CFO) leadership inquiries and institutional advisory partnerships.
        </p>
        <a href="mailto:sales@chainasiaconect.company" class="cfo-link red-text">
          <span>Inquire Executive Recruitment & Board Relations →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .direktur-section-clean {
    background: #ffffff;
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .direktur-photo-clean {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* Raw photo display without artificial layout frame/crop */
  .photo-raw {
    max-width: 100%;
    max-height: 480px;
    height: auto;
    width: auto;
    display: block;
  }

  .direktur-text-clean {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-tag-clean {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .owner-name-clean {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.1;
  }

  .owner-title-clean {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .owner-quote-clean {
    font-size: 1rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--text-body);
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--red-primary);
  }

  .owner-info-clean {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .info-label {
    width: 140px;
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .info-val {
    font-weight: 600;
    color: var(--text-dark);
  }

  .info-link {
    font-weight: 600;
    color: var(--text-dark);
  }

  .info-link.red-text {
    color: var(--red-primary);
  }

  .owner-actions-clean {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-text-link {
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .btn-red-simple {
    padding: 0.6rem 1.3rem;
    background: var(--red-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 4px;
    transition: background var(--transition-smooth);
  }

  .btn-red-simple:hover {
    background: var(--red-dark);
  }

  /* Who is Next CFO Expansion Block */
  .cfo-expansion-block {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .cfo-svg-wrapper {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cfo-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cfo-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .cfo-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 820px;
  }

  .cfo-link {
    font-weight: 700;
    font-size: 0.875rem;
    margin-top: 0.2rem;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .cfo-expansion-block {
      flex-direction: column;
      gap: 0.75rem;
    }
    .info-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
    .info-label {
      width: 100%;
    }
  }
</style>


