      <div class="executive-pill">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Direktur Utama: <strong>Ilham Pradani</strong></span>
      </div>
      <div class="legal-badge-list" style="margin-top: 0.85rem;">
        <span class="legal-pill">NIB 0709260109599</span>
        <span class="legal-pill">KBLI 62193</span>
        <span class="legal-pill">SK: AHU-A117353</span>
      </div>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-col">
      <h4 class="footer-heading">Navigasi Utama</h4>
      <ul class="footer-links">
        <li><a href="#hero">Beranda & Overview</a></li>
        <li><a href="#filosofi">Filosofi Identitas (CHAIN)</a></li>
        <li><a href="#pilar">Pilar Integrasi Usaha</a></li>
        <li><a href="#legalitas">Legalitas & SK Kemenkumham</a></li>
        <li><a href="https://ilhampradani.me" target="_blank" rel="noopener">Website Owner (Ilham Pradani)</a></li>
      </ul>
    </div>

    <!-- Column 3: Contact & Direct Communication -->
    <div class="footer-col">
      <h4 class="footer-heading">Kontak Resmi Perusahaan</h4>
      <ul class="footer-info-list">
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <div class="email-stack">
            <a href="mailto:info@chainasiaconect.company">info@chainasiaconect.company</a>
            <a href="mailto:sales@chainasiaconect.company">sales@chainasiaconect.company</a>
            <a href="mailto:hello@ilhampradani.me" class="owner-email">hello@ilhampradani.me</a>
          </div>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="wa-link">
            WhatsApp: +62 889-7107-1138
          </a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Kawasan Krui, Pesisir Barat, Lampung & DKI Jakarta, Indonesia</span>
        </li>
      </ul>
    </div>

    <!-- Column 4: Newsletter / Subscription -->
    <div class="footer-col">
      <h4 class="footer-heading">Pemberitahuan Peluncuran</h4>
      <p class="footer-subtext">Dapatkan info resmi pembukaan kemitraan B2B & layanan fisik terbaru kami.</p>
