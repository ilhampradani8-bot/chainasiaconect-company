  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <div class="copyright">
        © 2026 <strong>PT CHAIN ASIA CONECT</strong> | Owner: <a href="https://ilhampradani.me" target="_blank" rel="noopener" style="color: var(--primary-light);">Ilham Pradani</a>. Hak Cipta Dilindungi Undang-Undang.
      </div>
      <div class="footer-legal-links">
        <a href="https://www.chainasiaconect.company" target="_blank" rel="noopener">www.chainasiaconect.company</a>
        <a href="#legalitas">SK: AHU-A117353</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: #04050a;
    border-top: 1px solid var(--border-color);
    padding-top: 4rem;
    overflow: hidden;
    margin-top: auto;
  }

  .footer-glow-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(6, 182, 212, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.3fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    width: 38px;
    height: 38px;
    border-radius: 6px;
    border: 1px solid var(--border-glow);
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .executive-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    color: var(--text-main);
  }

  .legal-badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .legal-pill {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--primary-light);
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--primary-light);
  }

  .footer-info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .footer-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer-info-list svg {
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .email-stack {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .email-stack a {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .email-stack a:hover {
    color: var(--primary-light);
  }

  .owner-email {
    font-size: 0.8rem;
    color: var(--text-dim) !important;
  }

  .wa-link {
    color: #10b981 !important;
    font-weight: 600;
  }

  .footer-subtext {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .footer-subscribe-form {
    display: flex;
    gap: 0.5rem;
  }

  .subscribe-input {
    flex: 1;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.65rem 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: #ffffff;
    outline: none;
  }

  .subscribe-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.2);
  }

  .subscribe-btn {
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
  }

  .footer-bottom {
    background: #020306;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem 0;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .footer-legal-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-legal-links a {
    color: var(--text-dim);
    transition: color var(--transition-fast);
  }

  .footer-legal-links a:hover {
    color: var(--text-muted);
  }

  @media (max-width: 992px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
