<footer class="footer" id="contact">
  <div class="container footer-top">
    <!-- Column 1: Brand & Executive Vision -->
    <div class="footer-col footer-brand">
      <div class="footer-logo">
        <img src="/images/CAC-LOGO.jpg" alt="PT CHAIN ASIA CONECT Logo" class="footer-logo-img" />
        <span class="footer-brand-title">PT CHAIN ASIA CONECT</span>
      </div>
      <p class="footer-desc">
        Dedicated to strengthening supply chain networks and physical business value addition in Krui, Pesisir Barat. Backed by executive leadership and complete legal standing.
      </p>
      <div class="executive-tag">
        <span>Chief Executive Officer: <strong class="red-text">Ilham Pradani</strong></span>
      </div>
      <div class="legal-badge-list">
        <span class="legal-pill">NIB 0709260109599</span>
        <span class="legal-pill">KBLI 62193</span>
        <span class="legal-pill">SK: AHU-A117353</span>
      </div>
    </div>

    <!-- Column 2: Quick Links (English) -->
    <div class="footer-col">
      <h4 class="footer-heading">Navigation</h4>
      <ul class="footer-links">
        <li><a href="#hero">Home & Overview</a></li>
        <li><a href="#leadership">Leadership (Ilham Pradani)</a></li>
        <li><a href="#philosophy">Brand Philosophy (CHAIN)</a></li>
        <li><a href="#legal">Legal Verification</a></li>
        <li><a href="https://ilhampradani.me" target="_blank" rel="noopener">Website Owner (Ilham Pradani)</a></li>
      </ul>
    </div>

    <!-- Column 3: Contact & Direct Communication (English) -->
    <div class="footer-col">
      <h4 class="footer-heading">Official Contact</h4>
      <ul class="footer-info-list">
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <div class="email-stack">
            <a href="mailto:info@chainasiaconect.company">info@chainasiaconect.company</a>
            <a href="mailto:sales@chainasiaconect.company">sales@chainasiaconect.company</a>
            <a href="mailto:hello@ilhampradani.me" class="owner-email">hello@ilhampradani.me</a>
          </div>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="wa-link">
            WhatsApp: +62 889-7107-1138
          </a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Krui Area, Pesisir Barat, Lampung & DKI Jakarta, Indonesia</span>
        </li>
      </ul>
    </div>

    <!-- Column 4: Newsletter -->
    <div class="footer-col">
      <h4 class="footer-heading">Launch Notifications</h4>
      <p class="footer-subtext">Get official updates on B2B partnership openings & physical service releases.</p>
      <form class="footer-subscribe-form" onsubmit="event.preventDefault(); alert('Thank you! Your email has been registered.');">
        <input type="email" placeholder="Your business email..." required class="subscribe-input" />
        <button type="submit" class="btn-red subscribe-btn" aria-label="Submit Email">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <div class="copyright">
        © 2026 <strong>PT CHAIN ASIA CONECT</strong> | Owner: <a href="https://ilhampradani.me" target="_blank" rel="noopener" class="red-text">Ilham Pradani</a>. All rights reserved.
      </div>
      <div class="footer-legal-links">
        <a href="https://www.chainasiaconect.company" target="_blank" rel="noopener">www.chainasiaconect.company</a>
        <a href="#legal">SK: AHU-A117353</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: #ffffff;
    border-top: 1px solid var(--border-light);
    padding-top: 3.5rem;
    margin-top: auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 1.1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .footer-logo-img {
    width: 32px;
    height: 32px;
    object-fit: cover;
    border-radius: 2px;
    border: none !important;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 0.85rem;
  }

  .executive-tag {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .legal-badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .legal-pill {
    font-size: 0.675rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    background: var(--bg-light);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    color: var(--text-muted);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1.1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-body);
    transition: color var(--transition-smooth);
  }

  .footer-links a:hover {
    color: var(--red-primary);
  }

  .footer-info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-body);
  }

  .email-stack {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .email-stack a {
    color: var(--text-body);
    transition: color var(--transition-smooth);
  }

  .email-stack a:hover {
    color: var(--red-primary);
  }

  .owner-email {
    font-size: 0.8rem;
    color: var(--text-muted) !important;
  }

  .wa-link {
    color: #16a34a !important;
    font-weight: 700;
  }

  .footer-subtext {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }

  .footer-subscribe-form {
    display: flex;
    gap: 0.4rem;
  }

  .subscribe-input {
    flex: 1;
    background: var(--bg-light);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 0.55rem 0.85rem;
    font-size: 0.825rem;
    color: var(--text-dark);
    outline: none;
  }

  .subscribe-input:focus {
    border-color: var(--red-primary);
  }

  .subscribe-btn {
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 4px;
  }

  .footer-bottom {
    background: var(--bg-light);
    border-top: 1px solid var(--border-light);
    padding: 1rem 0;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-legal-links {
    display: flex;
    gap: 1rem;
  }

  .footer-legal-links a {
    color: var(--text-muted);
  }

  .footer-legal-links a:hover {
    color: var(--red-primary);
  }

  @media (max-width: 992px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
