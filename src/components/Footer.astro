<style>
  .footer {
    position: relative;
    background: #ffffff;
    border-top: 1px solid var(--border-light);
    padding-top: 3.5rem;
    margin-top: auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr 1.25fr;
    gap: 2.25rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .footer-logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 0.85rem;
  }

  .executive-tag {
    font-size: 0.825rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .legal-badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .legal-pill {
    font-size: 0.675rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    background: var(--bg-light);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    color: var(--text-muted);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1.1rem;
  }

  /* Banking Partner OCBC Box */
  .banking-partner-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .banking-label {
    font-size: 0.775rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .ocbc-logo {
    height: 38px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-body);
    transition: color var(--transition-smooth);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--red-primary);
  }

  .footer-info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.825rem;
    color: var(--text-body);
  }

  .email-stack {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .email-stack a {
    color: var(--text-dark);
    transition: color var(--transition-smooth);
    text-decoration: none;
    font-size: 0.825rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .email-stack a:hover {
    color: var(--red-primary);
  }

  .footer-bottom {
    background: var(--bg-light);
    border-top: 1px solid var(--border-light);
    padding: 1rem 0;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-legal-links {
    display: flex;
    gap: 1rem;
  }

  .footer-legal-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-legal-links a:hover {
    color: var(--red-primary);
  }

  @media (max-width: 992px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-bottom: 2rem;
    }
    .footer-brand-title {
      font-size: clamp(0.9rem, 3.8vw, 1.05rem);
      overflow-wrap: anywhere;
    }
    .footer-desc {
      font-size: clamp(0.8rem, 3.2vw, 0.875rem);
      overflow-wrap: anywhere;
    }
    .executive-tag {
      font-size: clamp(0.75rem, 3vw, 0.825rem);
      overflow-wrap: anywhere;
    }
    .footer-heading {
      font-size: clamp(0.85rem, 3.5vw, 0.95rem);
      margin-bottom: 0.75rem;
    }
    .footer-links a {
      font-size: clamp(0.8rem, 3.2vw, 0.875rem);
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .email-stack a {
      font-size: clamp(0.75rem, 3.2vw, 0.825rem);
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.65rem;
      text-align: center;
      font-size: clamp(0.7rem, 2.8vw, 0.8rem);
    }
    .footer-legal-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.4rem 0.75rem;
    }
  }
</style>
