<footer class="footer" id="kontak">
  <div class="footer-glow-bg"></div>

  <div class="container footer-top">
    <!-- Column 1: Brand & Strategic Vision -->
    <div class="footer-col footer-brand">
      <div class="footer-logo">
        <img src="/images/CAC-LOGO.jpg" alt="PT CHAIN ASIA CONECT" class="footer-logo-img" onerror="this.style.display='none';" />
        <span class="footer-brand-title">PT CHAIN ASIA CONECT</span>
      </div>
      <p class="footer-desc">
        Hadir untuk memperkuat ekosistem jaringan rantai pasok (supply chain) dan nilai tambah layanan bisnis di wilayah Krui, Pesisir Barat. Berkomitmen menjadi mitra strategis yang andal dan berstandar profesional.
      </p>
      <div class="legal-badge-list">
        <span class="legal-pill">NIB 0709260109599</span>
        <span class="legal-pill">KBLI 62193</span>
        <span class="legal-pill">SK Kemenkumham AHU-A117353</span>
      </div>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-col">
      <h4 class="footer-heading">Navigasi Utama</h4>
      <ul class="footer-links">
        <li><a href="#hero">Beranda & Overview</a></li>
        <li><a href="#filosofi">Filosofi Identitas (CHAIN)</a></li>
        <li><a href="#pilar">Pilar Integrasi Usaha</a></li>
        <li><a href="#legalitas">Legalitas & SK Kemenkumham</a></li>
      </ul>
    </div>

    <!-- Column 3: Corporate Info & Address -->
    <div class="footer-col">
      <h4 class="footer-heading">Fokus Operasional</h4>
      <ul class="footer-info-list">
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Kawasan Krui, Pesisir Barat, Lampung & DKI Jakarta, Indonesia</span>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <span>info@chainasiaconect.com</span>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <span>@chainasiaconect</span>
        </li>
      </ul>
    </div>

    <!-- Column 4: Newsletter / Launch Subscription -->
    <div class="footer-col">
      <h4 class="footer-heading">Pemberitahuan Peluncuran</h4>
      <p class="footer-subtext">Dapatkan informasi pembukaan jaringan kemitraan B2B & layanan fisik terbaru kami.</p>
      <form class="footer-subscribe-form" onsubmit="event.preventDefault(); alert('Terima kasih! Email Anda telah terdaftar.');">
        <input type="email" placeholder="Email bisnis Anda..." required class="subscribe-input" />
        <button type="submit" class="btn btn-primary subscribe-btn" aria-label="Submit Email">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <div class="copyright">
        © 2026 <strong>PT CHAIN ASIA CONECT</strong>. Hak Cipta Dilindungi Undang-Undang.
      </div>
      <div class="footer-legal-links">
        <a href="#legalitas">Privasi</a>
        <a href="#legalitas">Syarat & Ketentuan</a>
        <a href="#legalitas">AHU-A117353.AH.01.30.Tahun 2026</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: #04050a;
    border-top: 1px solid var(--border-color);
    padding-top: 4rem;
    overflow: hidden;
    margin-top: auto;
  }

  .footer-glow-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(6, 182, 212, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    width: 38px;
    height: 38px;
    border-radius: 6px;
    border: 1px solid var(--border-glow);
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .legal-badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .legal-pill {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--primary-light);
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--primary-light);
  }

  .footer-info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer-info-list svg {
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .footer-subtext {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .footer-subscribe-form {
    display: flex;
    gap: 0.5rem;
  }

  .subscribe-input {
    flex: 1;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.65rem 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: #ffffff;
    outline: none;
  }

  .subscribe-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.2);
  }

  .subscribe-btn {
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
  }

  .footer-bottom {
    background: #020306;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem 0;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .footer-legal-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-legal-links a {
    color: var(--text-dim);
    transition: color var(--transition-fast);
  }

  .footer-legal-links a:hover {
    color: var(--text-muted);
  }

  @media (max-width: 992px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
