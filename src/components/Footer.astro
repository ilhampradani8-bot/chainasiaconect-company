<style>
  .footer-reveal-spacer {
    display: block;
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  /* Apple iPhone / iTunes / iOS Pure Black Parallax Footer */
  .footer {
    position: relative;
    background: #000000;
    background: linear-gradient(180deg, #121216 0%, #000000 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 4.5rem;
    color: #86868b;
    box-sizing: border-box;
  }

  .footer.is-fixed-parallax {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1;
    pointer-events: auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1.2fr 1.25fr;
    gap: 2.75rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .footer-logo-img {
    height: 42px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #f5f5f7;
    letter-spacing: -0.01em;
  }

  .footer-desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: #86868b;
    margin-bottom: 1.1rem;
  }

  .executive-tag {
    font-size: 0.84rem;
    font-weight: 500;
    margin-bottom: 1rem;
    line-height: 1.6;
    color: #a1a1a6;
  }

  /* Clean Non-Card Meta Text */
  .legal-meta-clean {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.76rem;
    color: #86868b;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .meta-sep {
    color: #424245;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: #f5f5f7;
    margin-bottom: 1.25rem;
    letter-spacing: 0.01em;
  }

  /* Direct Transparent OCBC Logo (No Box/Card) */
  .banking-partner-clean {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .banking-label {
    font-size: 0.78rem;
    color: #86868b;
    font-weight: 600;
  }

  .ocbc-logo-clean {
    height: 38px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: #a1a1a6;
    transition: color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  .footer-info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .footer-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.84rem;
    color: #86868b;
  }

  .email-stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .email-stack a {
    color: #f5f5f7;
    transition: color 0.2s ease;
    text-decoration: none;
    font-size: 0.84rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .email-stack a:hover {
    color: #ef4444;
  }

  .footer-bottom {
    background: #000000;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 0;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #86868b;
  }

  .footer-bottom-container .copyright {
    color: #86868b;
  }

  .footer-legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal-links a {
    color: #86868b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal-links a:hover {
    color: #f5f5f7;
  }

  @media (max-width: 992px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: 3.5rem;
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-bottom: 2.25rem;
    }
    .footer-brand-title {
      font-size: clamp(0.95rem, 3.8vw, 1.15rem);
      overflow-wrap: anywhere;
    }
    .footer-desc {
      font-size: clamp(0.82rem, 3.2vw, 0.88rem);
      overflow-wrap: anywhere;
    }
    .executive-tag {
      font-size: clamp(0.78rem, 3vw, 0.84rem);
      overflow-wrap: anywhere;
    }
    .footer-heading {
      font-size: clamp(0.88rem, 3.5vw, 0.95rem);
      margin-bottom: 0.75rem;
    }
    .footer-links a {
      font-size: clamp(0.82rem, 3.2vw, 0.88rem);
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .email-stack a {
      font-size: clamp(0.78rem, 3.2vw, 0.84rem);
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }
    .footer-bottom-container {
      flex-direction: column;
      gap: 0.65rem;
      text-align: center;
      font-size: clamp(0.72rem, 2.8vw, 0.8rem);
    }
    .footer-legal-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.4rem 0.75rem;
    }
  }
</style>

<script>
  function setupFooterParallax() {
    const footer = document.getElementById('footer-main');
    const spacer = document.getElementById('footer-reveal-spacer');
    if (!footer || !spacer) return;

    function syncFooterHeight() {
      const footerHeight = footer.offsetHeight;
      const viewportHeight = window.innerHeight;

      // Fixed reveal parallax: active on desktop only when footer fits nicely in viewport
      if (window.innerWidth > 768 && footerHeight <= viewportHeight) {
        footer.classList.add('is-fixed-parallax');
        spacer.style.height = `${footerHeight}px`;
        spacer.style.display = 'block';
      } else {
        // Natural document flow on mobile to prevent viewport clipping and scroll traps
        footer.classList.remove('is-fixed-parallax');
        spacer.style.height = '0px';
        spacer.style.display = 'none';
      }
    }

    if (window.ResizeObserver) {
      new ResizeObserver(syncFooterHeight).observe(footer);
    }
    window.addEventListener('resize', syncFooterHeight, { passive: true });
    syncFooterHeight();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFooterParallax);
  } else {
    setupFooterParallax();
  }
</script>
