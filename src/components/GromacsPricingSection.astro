            </svg>
            <span data-i18n="gromacs_t2_net">1 Gbps Dedicated Port & Priority Bandwidth</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t2_gromacs">Pre-installed GROMACS, CUDA & Slurm Tools</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t2_access">Full Root, IPMI/KVM & Automated Backups</span>
          </li>
        </ul>

        <div class="tier-action">
          <a href="mailto:sales@chainasiaconect.company?subject=Inquiry%20Advanced%20MD%20Workspace%20($1,100/mo)" class="btn-tier-outline">
            <span data-i18n="gromacs_btn_order">Order Dedicated Server →</span>
          </a>
        </div>
      </div>

      <!-- Tier 3: $1,300 (Featured / Purchased Dedicated Specification) -->
      <div class="pricing-card card-featured">
        <div class="featured-badge-bar">
          <span class="featured-pill-text" data-i18n="gromacs_badge_pop">★ RECOMMENDED SPECIFICATION</span>
        </div>

        <div class="card-tier-head">
          <span class="tier-level-code red-text">MD TIER 03 • DEDICATED</span>
          <h3 class="tier-title text-featured" data-i18n="gromacs_t3_name">Dedicated Server Rental (GROMACS)</h3>
          <p class="tier-desc" data-i18n="gromacs_t3_desc">
            Dedicated enterprise infrastructure engineered for demanding molecular dynamics production runs and high-throughput research.
