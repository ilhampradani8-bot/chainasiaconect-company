<style>
  .gromacs-pricing-section {
    background: #fdfdfd;
    padding: 4.5rem 0 5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .pricing-header-block {
    max-width: 860px;
    margin-bottom: 3rem;
  }

  .pricing-tag {
    font-size: 0.775rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .pricing-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }

  .pricing-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 780px;
  }

  /* 4 Columns Grid */
  .pricing-grid-quad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  /* Base Pricing Card */
  .pricing-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem 1.6rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.08), 0 4px 10px rgba(0, 0, 0, 0.03);
    border-color: #cbd5e1;
  }

  /* Featured Card ($1,300) */
  .pricing-card.card-featured {
    border: 1.8px solid #dc2626;
    background: #ffffff;
    box-shadow: 0 16px 36px -8px rgba(220, 38, 38, 0.14), 0 4px 12px rgba(0, 0, 0, 0.04);
    transform: translateY(-2px);
  }

  .pricing-card.card-featured:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 42px -8px rgba(220, 38, 38, 0.22), 0 6px 14px rgba(0, 0, 0, 0.06);
    border-color: #b91c1c;
  }

  .featured-badge-bar {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: #dc2626;
    color: #ffffff;
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
  }

  /* Card Head */
  .card-tier-head {
    margin-bottom: 1.25rem;
  }

  .tier-level-code {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #64748b;
    display: block;
    margin-bottom: 0.4rem;
  }

  .tier-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.35;
    margin-bottom: 0.5rem;
    min-height: 2.8rem;
    display: flex;
    align-items: center;
  }

  .tier-title.text-featured {
    color: #0f172a;
    font-weight: 800;
  }

  .tier-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    min-height: 3.8rem;
  }

  /* Price Box */
  .tier-price-box {
    margin: 0.5rem 0 1.25rem 0;
  }

  .price-amount-wrap {
    display: flex;
    align-items: flex-start;
    gap: 0.2rem;
    line-height: 1;
  }

  .currency-sign {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-top: 0.2rem;
  }

  .price-val {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-dark);
    letter-spacing: -0.02em;
    font-family: var(--font-heading);
  }

  .price-val.text-featured {
    color: #dc2626;
  }

  .billing-period {
    display: block;
    font-size: 0.775rem;
    color: #64748b;
    font-weight: 600;
    margin-top: 0.35rem;
  }

  .tier-divider {
    height: 1px;
    background: #e2e8f0;
    margin-bottom: 1.25rem;
  }

  /* Features List */
  .tier-features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-grow: 1;
  }

  .tier-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.835rem;
    color: #334155;
    line-height: 1.45;
  }

  .tier-features-list li.feature-highlight {
