---
---

<section class="gromacs-pricing-section" id="gromacs-pricing">
  <div class="container">
    
    <!-- Section Header -->
    <div class="pricing-header-block">
      <span class="pricing-tag red-text" data-i18n="gromacs_tag">HPC & MOLECULAR SIMULATION CLOUD</span>
      <h2 class="pricing-title">
        <span data-i18n="gromacs_title_prefix">GROMACS Cloud </span><span class="red-text" data-i18n="gromacs_title_highlight">Dedicated Server Pricing</span>
      </h2>
      <p class="pricing-subtitle" data-i18n="gromacs_subtitle">
        Enterprise-grade High Performance Computing (HPC) environments engineered for complex molecular dynamics (MD), biophysical research, and PACS diagnostic computing with guaranteed hardware resources.
      </p>
    </div>

    <!-- 4 Tier Pricing Grid -->
    <div class="pricing-grid-quad">
      
      <!-- Tier 1: $900 -->
      <div class="pricing-card">
        <div class="card-tier-head">
          <span class="tier-level-code">MD TIER 01</span>
          <h3 class="tier-title" data-i18n="gromacs_t1_name">Starter Simulation Cloud</h3>
          <p class="tier-desc" data-i18n="gromacs_t1_desc">
            Optimized for initial molecular docking, lightweight GROMACS simulations, and academic research workloads.
          </p>
        </div>

        <div class="tier-price-box">
          <div class="price-amount-wrap">
            <span class="currency-sign">$</span>
            <span class="price-val">900</span>
          </div>
          <span class="billing-period" data-i18n="gromacs_period">/ Month (1 Bulan)</span>
        </div>

        <div class="tier-divider"></div>

        <ul class="tier-features-list">
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t1_cpu">AMD EPYC™ Processor (8 Cores / 16 Threads)</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t1_ram">64 GB DDR5 ECC RAM</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t1_disk">1 TB Enterprise NVMe PCIe 4.0 SSD</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t1_net">1 Gbps Dedicated Port & Unmetered Traffic</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t1_gromacs">Pre-installed GROMACS & OpenMPI Stack</span>
          </li>
          <li>
            <svg class="check-ico" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span data-i18n="gromacs_t1_access">Full Root & SSH Access with 99.9% SLA</span>
          </li>
        </ul>

        <div class="tier-action">
          <a href="mailto:sales@chainasiaconect.company?subject=Inquiry%20Starter%20Simulation%20Cloud%20($900/mo)" class="btn-tier-outline">
            <span data-i18n="gromacs_btn_order">Order Dedicated Server →</span>
          </a>
        </div>
      </div>

      <!-- Tier 2: $1,100 -->
      <div class="pricing-card">
