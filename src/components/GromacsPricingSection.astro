        <div class="tier-action">
          <a href="mailto:sales@chainasiaconect.company?subject=Order%20Dedicated%20Server%20Rental%20(GROMACS)%20AMD%20EPYC%2016C/32T%20128GB%20DDR5%20($1,300/mo)" class="btn-tier-featured">
