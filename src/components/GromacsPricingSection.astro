<script is:inline>
  // Pure Vanilla JavaScript implementation of Pricing Toggle
  (function() {
    function initPricingToggle() {
      const toggleCheckbox = document.getElementById('pricing-plan-toggle');
      const labelMonthly = document.getElementById('label-monthly');
      const labelYearly = document.getElementById('label-yearly');
      if (!toggleCheckbox) return;

      function updatePricingState() {
        const isYearly = toggleCheckbox.checked;

        if (labelMonthly && labelYearly) {
          if (isYearly) {
            labelMonthly.classList.remove('active');
            labelYearly.classList.add('active');
          } else {
            labelMonthly.classList.add('active');
            labelYearly.classList.remove('active');
          }
        }

        // Toggle price numbers with clean animation
        document.querySelectorAll('#pricing-cards .price-card--price-number').forEach(el => {
          const val = isYearly ? el.getAttribute('data-price-yearly') : el.getAttribute('data-price-monthly');
          if (val) {
            el.style.opacity = '0.3';
            setTimeout(() => {
              el.textContent = val;
              el.style.opacity = '1';
            }, 120);
          }
        });

        // Toggle billing condition text
        const currentLang = document.documentElement.lang || 'en';
        document.querySelectorAll('#pricing-cards .cond-billing').forEach(el => {
          if (isYearly) {
            el.textContent = (currentLang === 'id') ? 'Ditagih Tahunan (Hemat 10%)' : 'Billed Annually (Save 10%)';
          } else {
            el.textContent = (currentLang === 'id') ? 'Ditagih Bulanan' : 'Billed Monthly';
          }
        });
      }

      toggleCheckbox.addEventListener('change', updatePricingState);

      if (labelMonthly) {
        labelMonthly.addEventListener('click', () => {
          if (toggleCheckbox.checked) {
            toggleCheckbox.checked = false;
            updatePricingState();
          }
        });
      }

      if (labelYearly) {
        labelYearly.addEventListener('click', () => {
          if (!toggleCheckbox.checked) {
            toggleCheckbox.checked = true;
            updatePricingState();
          }
        });
      }

      // Re-apply if language switcher is triggered
      window.addEventListener('cac-language-changed', () => {
        updatePricingState();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPricingToggle);
    } else {
      initPricingToggle();
    }
  })();
</script>
