---
---

<header class="header">
  <div class="container header-inner">
    <!-- Corporate Brand / Logo -->
    <a href="/" class="brand-link">
      <div class="logo-box">
        <img src="/images/CAC-LOGO.jpg" alt="PT CHAIN ASIA CONECT Logo" class="logo-image" />
      </div>
      <div class="brand-info">
        <span class="brand-name gold-text">PT CHAIN ASIA CONECT</span>
        <span class="brand-tagline">Rantai Pasok & Ekosistem Usaha Riil</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      <a href="#hero" class="nav-item active">Beranda</a>
      <a href="#direktur" class="nav-item">Direktur Utama</a>
      <a href="#filosofi" class="nav-item">Filosofi (CHAIN)</a>
      <a href="#legalitas" class="nav-item">Legalitas Hukum</a>
      <a href="#kontak" class="nav-item">Kontak</a>
    </nav>

    <!-- Right Header Actions -->
    <div class="header-right">
      <div class="classic-badge header-badge">
        <span class="classic-badge-dot"></span>
        <span>Coming Soon 2026</span>
      </div>
      <a href="https://wa.me/6288971071138" target="_blank" rel="noopener" class="btn-classic btn-header">
        <span>Hubungi Kami</span>
      </a>
      <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Toggle Navigation">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.8"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Nav -->
  <div class="mobile-drawer" id="mobile-drawer-nav">
    <a href="#hero" class="mobile-item">Beranda</a>
    <a href="#direktur" class="mobile-item">Direktur Utama (Ilham Pradani)</a>
    <a href="#filosofi" class="mobile-item">Filosofi & Identitas CHAIN</a>
    <a href="#legalitas" class="mobile-item">SK Kemenkumham & Legalitas</a>
    <a href="#kontak" class="mobile-item">Kontak Resmi & WhatsApp</a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer-nav');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('active');
    });

    document.querySelectorAll('.mobile-item').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('active');
      });
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(4, 5, 9, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-classic);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 90px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .logo-box {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    border: 1px solid var(--gold-primary);
    overflow: hidden;
    background: #000;
  }

  .logo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .brand-tagline {
    font-size: 0.725rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  .nav-item {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color var(--transition-smooth);
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-item:hover, .nav-item.active {
    color: var(--gold-light);
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold-gradient);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .btn-header {
    padding: 0.55rem 1.4rem;
    font-size: 0.75rem;
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--border-classic);
    padding: 0.4rem;
    cursor: pointer;
  }

  .mobile-drawer {
    display: none;
    flex-direction: column;
    background: #060810;
    border-bottom: 1px solid var(--border-classic);
    padding: 1.25rem 2rem;
    gap: 1rem;
  }

  .mobile-drawer.active {
    display: flex;
  }

  .mobile-item {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-item:hover {
    color: var(--gold-light);
  }

  @media (max-width: 1024px) {
    .desktop-nav, .header-badge {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
