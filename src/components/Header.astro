---
---

<header class="header">
  <div class="container header-inner-flex">
    
    <!-- Left: Transparent CAC Logo (Large, No Background) -->
    <a href="/" class="brand-logo-only">
      <img src="/images/CAC-LOGOremovebg-preview.png" alt="PT CHAIN ASIA CONECT Logo" class="logo-transparent-large" />
    </a>

    <!-- Right: Inset Neumorphic Capsule Navigation Pill (Desktop PC) -->
    <nav class="desktop-right-capsule-inset">
      <a href="/" class="nav-capsule-item">Home</a>
      <a href="/about" class="nav-capsule-item">About Us</a>
      <a href="/business" class="nav-capsule-item">Business & Services</a>
      <a href="/investor-relations" class="nav-capsule-item">Investor Relations</a>
      <a href="/governance" class="nav-capsule-item">Governance</a>
      <a href="/sustainability" class="nav-capsule-item">ESG & CSR</a>
      <a href="/newsroom" class="nav-capsule-item">Newsroom</a>
      <a href="/careers" class="nav-capsule-item">Careers</a>
      <a href="/contact" class="nav-capsule-item">Contact</a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Toggle Navigation">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

  </div>

  <!-- Mobile Drawer Nav -->
  <div class="mobile-drawer" id="mobile-drawer-nav">
    <a href="/" class="mobile-item">Home</a>
    <a href="/about" class="mobile-item">About Us</a>
    <a href="/business" class="mobile-item">Business & Services</a>
    <a href="/investor-relations" class="mobile-item">Investor Relations (IPO Coming Soon 2029)</a>
    <a href="/governance" class="mobile-item">Corporate Governance</a>
    <a href="/sustainability" class="mobile-item">Sustainability & ESG</a>
    <a href="/newsroom" class="mobile-item">Newsroom</a>
    <a href="/careers" class="mobile-item">Careers</a>
    <a href="/contact" class="mobile-item">Contact Us</a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer-nav');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('active');
    });

    document.querySelectorAll('.mobile-item').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('active');
      });
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0.65rem 0;
    background: transparent;
    pointer-events: none; /* Allows click through except on active items */
  }

  .header-inner-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }

  /* Left: Transparent CAC Logo (Large, No Background) */
  .brand-logo-only {
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .brand-logo-only:hover {
    transform: scale(1.04);
  }

  .logo-transparent-large {
    height: 54px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* Right: Inset Neumorphic Capsule Navigation Pill (Desain Neumorphic Kedalam) */
  .desktop-right-capsule-inset {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: #f1f5f9;
    border-radius: 9999px;
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(203, 213, 225, 0.7);
    /* Inset Neumorphism (Soft Inner Shadow Depth) */
    box-shadow: 
      inset 3px 3px 6px rgba(0, 0, 0, 0.08),
      inset -3px -3px 6px rgba(255, 255, 255, 0.9),
      0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .nav-capsule-item {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-body);
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .nav-capsule-item:hover {
    color: var(--red-primary);
    background: #ffffff;
    /* Soft Pressed Outset Pill on Hover */
    box-shadow: 
      0 3px 8px rgba(0, 0, 0, 0.06),
      inset 0 1px 1px rgba(255, 255, 255, 1);
    transform: translateY(-1px);
  }

  /* Mobile Toggle Button */
  .mobile-menu-btn {
    display: none;
    background: #f1f5f9;
    border: 1px solid rgba(203, 213, 225, 0.7);
    border-radius: 50%;
    padding: 0.5rem;
    cursor: pointer;
    box-shadow: 
      inset 2px 2px 4px rgba(0, 0, 0, 0.08),
      inset -2px -2px 4px rgba(255, 255, 255, 0.9);
  }

  /* Mobile Drawer Nav */
  .mobile-drawer {
    display: none;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 0.85rem 1.25rem;
    gap: 0.35rem;
    margin-top: 0.5rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    pointer-events: auto;
  }

  .mobile-drawer.active {
    display: flex;
  }

  .mobile-item {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dark);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-light);
    text-decoration: none;
  }

  .mobile-item:hover {
    color: var(--red-primary);
  }

  @media (max-width: 1120px) {
    .desktop-right-capsule-inset {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
