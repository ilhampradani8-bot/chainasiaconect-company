---
---

<header class="header">
  <div class="container header-inner-flex">
    
    <!-- Left: Transparent CAC Logo (Large, No Background) -->
    <a href="/" class="brand-logo-only">
      <img src="/images/CAC-LOGOremovebg-preview.png" alt="PT CHAIN ASIA CONECT Logo" class="logo-transparent-large" />
    </a>

    <!-- Right: Inset Neumorphic Capsule Navigation Pill (Desktop PC) -->
    <div class="header-right-group">
      <nav class="desktop-right-capsule-inset">
        <a href="/" class="nav-capsule-item" data-i18n="nav_home">Home</a>
        <a href="/about" class="nav-capsule-item" data-i18n="nav_about">About Us</a>
        <a href="/business" class="nav-capsule-item" data-i18n="nav_business">Business & Services</a>
        <a href="/investor-relations" class="nav-capsule-item" data-i18n="nav_investor">Investor Relations</a>
        <a href="/governance" class="nav-capsule-item" data-i18n="nav_governance">Governance</a>
        <a href="/newsroom" class="nav-capsule-item" data-i18n="nav_newsroom">Newsroom</a>

        <!-- Minimalist Initiatives & Coming Soon Dropdown (SCF, ESG, Careers) -->
        <div class="nav-dropdown-wrapper" id="nav-coming-dropdown">
          <button type="button" class="nav-capsule-item nav-dropdown-trigger" id="dropdown-trigger-btn" aria-expanded="false" aria-haspopup="true">
            <span data-i18n="nav_coming_more">More Initiatives</span>
            <svg class="dropdown-chevron-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          
          <div class="nav-dropdown-menu" id="nav-dropdown-popover">
            <a href="/scf" class="nav-dropdown-link">
              <div class="dd-link-icon scf-color">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div class="dd-link-info">
                <div class="dd-link-title-row">
                  <span class="dd-link-title" data-i18n="nav_scf">SCF Platform</span>
                  <span class="dd-pill-badge">Coming Soon</span>
                </div>
                <span class="dd-link-desc">Supply Chain Financing Ecosystem</span>
              </div>
            </a>

            <a href="/sustainability" class="nav-dropdown-link">
              <div class="dd-link-icon esg-color">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="dd-link-info">
                <div class="dd-link-title-row">
                  <span class="dd-link-title" data-i18n="nav_esg">ESG & Sustainability</span>
                </div>
                <span class="dd-link-desc">10% Tabarru' Fund & Mitra Langit</span>
              </div>
            </a>

            <a href="/careers" class="nav-dropdown-link">
              <div class="dd-link-icon career-color">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <div class="dd-link-info">
                <div class="dd-link-title-row">
                  <span class="dd-link-title" data-i18n="nav_careers">Careers & Recruitment</span>
                </div>
                <span class="dd-link-desc">Corporate Positions & Talent Pool</span>
              </div>
            </a>
          </div>
        </div>

        <a href="/contact" class="nav-capsule-item" data-i18n="nav_contact">Contact</a>
      </nav>

      <!-- Neumorphic Language Selector [ EN | ID ] for Desktop -->
      <div class="lang-switcher-neumorphic" id="lang-switcher">
        <button type="button" class="lang-btn active" data-lang="en" aria-label="English">EN</button>
        <span class="lang-divider">|</span>
        <button type="button" class="lang-btn" data-lang="id" aria-label="Indonesian">ID</button>
      </div>
    </div>

    <!-- Mobile Menu Hamburger Button Only -->
    <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Toggle Navigation">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

  </div>

  <!-- Mobile Drawer Nav Dropdown (Centered & Fullwidth Below Navbar) -->
  <div class="container mobile-drawer-container">
    <div class="mobile-drawer" id="mobile-drawer-nav">
      <!-- Language Switcher in Dropdown -->
      <div class="mobile-drawer-lang-row">
        <span class="mobile-lang-title" data-i18n="select_language">Language / Bahasa:</span>
        <div class="lang-switcher-neumorphic">
          <button type="button" class="lang-btn active" data-lang="en">EN</button>
          <span class="lang-divider">|</span>
          <button type="button" class="lang-btn" data-lang="id">ID</button>
        </div>
      </div>

      <a href="/" class="mobile-item" data-i18n="nav_home">Home</a>
      <a href="/about" class="mobile-item" data-i18n="nav_about">About Us</a>
      <a href="/business" class="mobile-item" data-i18n="nav_business">Business & Services</a>
      <a href="/investor-relations" class="mobile-item" data-i18n="nav_investor">Investor Relations</a>
      <a href="/governance" class="mobile-item" data-i18n="nav_governance">Corporate Governance</a>
      <a href="/newsroom" class="mobile-item" data-i18n="nav_newsroom">Newsroom</a>

      <!-- Grouped Initiatives Section in Mobile Drawer -->
      <div class="mobile-initiatives-card">
        <div class="mobile-card-title">More Initiatives</div>
        <a href="/scf" class="mobile-sub-link">
          <span data-i18n="nav_scf">SCF Platform</span>
          <span class="mobile-badge-red">Coming Soon</span>
        </a>
        <a href="/sustainability" class="mobile-sub-link" data-i18n="nav_esg">ESG & Sustainability</a>
        <a href="/careers" class="mobile-sub-link" data-i18n="nav_careers">Careers & Recruitment</a>
      </div>

      <a href="/contact" class="mobile-item" data-i18n="nav_contact">Contact Us</a>
    </div>
  </div>
</header>

<script>
  // Mobile Drawer Toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer-nav');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      drawer.classList.toggle('active');
    });

    document.querySelectorAll('.mobile-item, .mobile-sub-link').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('active');
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!drawer.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
        drawer.classList.remove('active');
      }
    });
  }

  // Desktop Coming Soon / Initiatives Dropdown
  const dropdownWrapper = document.getElementById('nav-coming-dropdown');
  const dropdownBtn = document.getElementById('dropdown-trigger-btn');

  if (dropdownWrapper && dropdownBtn) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdownWrapper.classList.toggle('is-open');
      dropdownBtn.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!dropdownWrapper.contains(e.target as Node)) {
        dropdownWrapper.classList.remove('is-open');
        dropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0.85rem 0;
    background: transparent;
    border-bottom: none;
    pointer-events: none;
  }

  .header-inner-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    pointer-events: auto;
  }

  .brand-logo-only {
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .brand-logo-only:hover {
    transform: scale(1.04);
  }

  .logo-transparent-large {
    height: 52px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .header-right-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Inset Neumorphic Capsule Navigation Pill */
  .desktop-right-capsule-inset {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: #f1f5f9;
    border-radius: 9999px;
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(203, 213, 225, 0.7);
    box-shadow: 
      inset 3px 3px 6px rgba(0, 0, 0, 0.08),
      inset -3px -3px 6px rgba(255, 255, 255, 0.9),
      0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .nav-capsule-item {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-body);
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-capsule-item:hover,
  .nav-dropdown-wrapper:hover .nav-dropdown-trigger,
  .nav-dropdown-wrapper.is-open .nav-dropdown-trigger {
    color: var(--red-primary);
    background: #ffffff;
    box-shadow: 
      0 3px 8px rgba(0, 0, 0, 0.06),
      inset 0 1px 1px rgba(255, 255, 255, 1);
    transform: translateY(-1px);
  }

  /* Dropdown Styles */
  .nav-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .dropdown-chevron-icon {
    transition: transform 0.25s ease;
  }

  .nav-dropdown-wrapper:hover .dropdown-chevron-icon,
  .nav-dropdown-wrapper.is-open .dropdown-chevron-icon {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    min-width: 295px;
    background: #ffffff;
    border-radius: 16px;
    padding: 0.6rem;
    border: 1px solid rgba(226, 232, 240, 0.95);
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.16), 0 8px 18px rgba(0, 0, 0, 0.06);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), 
                visibility 0.25s ease;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Triangle pointer */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 32px;
    width: 12px;
    height: 12px;
    background: #ffffff;
    border-left: 1px solid rgba(226, 232, 240, 0.95);
    border-top: 1px solid rgba(226, 232, 240, 0.95);
    transform: rotate(45deg);
  }

  /* Hover & Active opening */
  .nav-dropdown-wrapper:hover .nav-dropdown-menu,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-menu,
  .nav-dropdown-wrapper.is-open .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .nav-dropdown-link:hover {
    background: #f8fafc;
    transform: translateX(2px);
  }

  .dd-link-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dd-link-icon svg {
    width: 18px;
    height: 18px;
  }

  .scf-color {
    background: #fef2f2;
    color: var(--red-primary);
  }

  .esg-color {
    background: #ecfdf5;
    color: #059669;
  }

  .career-color {
    background: #f0fdf4;
    color: #16a34a;
  }

  .dd-link-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dd-link-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dd-link-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.2;
  }

  .dd-pill-badge {
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: #fee2e2;
    color: #dc2626;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dd-link-desc {
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  /* Mobile Initiatives Card */
  .mobile-initiatives-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin: 0.35rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .mobile-card-title {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 0.2rem;
  }

  .mobile-sub-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-dark);
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.2s ease;
  }

  .mobile-sub-link:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mobile-sub-link:hover {
    color: var(--red-primary);
  }

  .mobile-badge-red {
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: #fee2e2;
    color: #dc2626;
    text-transform: uppercase;
  }

  /* Neumorphic Language Switcher [ EN | ID ] */
  .lang-switcher-neumorphic {
    display: flex;
    align-items: center;
    background: #f1f5f9;
    border-radius: 9999px;
    padding: 0.2rem 0.35rem;
    border: 1px solid rgba(203, 213, 225, 0.8);
    box-shadow: 
      inset 2px 2px 5px rgba(0, 0, 0, 0.08),
      inset -2px -2px 5px rgba(255, 255, 255, 0.95);
    gap: 0.15rem;
  }

  .lang-btn {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-muted);
    border: none;
    background: transparent;
    padding: 0.35rem 0.65rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 1;
  }

  .lang-btn.active {
    color: #dc2626;
    background: #ffffff;
    box-shadow: 
      2px 2px 6px rgba(0, 0, 0, 0.08),
      -1px -1px 4px rgba(255, 255, 255, 0.9);
  }

  .lang-divider {
    font-size: 0.7rem;
    color: #cbd5e1;
    user-select: none;
  }

  /* Mobile Toggle Button */
  .mobile-menu-btn {
    display: none;
    background: #f1f5f9;
    border: 1px solid rgba(203, 213, 225, 0.8);
    border-radius: 50%;
    padding: 0.55rem;
    cursor: pointer;
    box-shadow: 
      3px 3px 8px rgba(0, 0, 0, 0.08),
      -3px -3px 8px rgba(255, 255, 255, 0.9);
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .mobile-menu-btn:active {
    transform: scale(0.94);
  }

  /* Mobile Drawer Dropdown */
  .mobile-drawer-container {
    width: 100%;
    box-sizing: border-box;
    pointer-events: auto;
  }

  .mobile-drawer {
    display: none;
    flex-direction: column;
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    gap: 0.35rem;
    margin-top: 0.75rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12), -4px -4px 12px rgba(255, 255, 255, 0.9);
    box-sizing: border-box;
  }

  .mobile-drawer.active {
    display: flex !important;
  }

  .mobile-drawer-lang-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .mobile-lang-title {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .mobile-item {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-dark);
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mobile-item:last-child {
    border-bottom: none;
  }

  .mobile-item:hover {
    color: var(--red-primary);
  }

  @media (max-width: 1120px) {
    .header-right-group {
      display: none !important;
    }
    .mobile-menu-btn {
      display: flex !important;
    }
  }

  @media (max-width: 640px) {
    .header {
      padding: 0.45rem 0;
    }
    .logo-transparent-large {
      height: clamp(38px, 9vw, 46px);
    }
    .mobile-drawer {
      padding: 1rem 1.15rem;
      border-radius: 10px;
    }
    .mobile-item {
      font-size: 0.85rem;
      padding: 0.5rem 0;
    }
  }
</style>
