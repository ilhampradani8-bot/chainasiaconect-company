---
import { fetchAllNews, formatImageUrl } from '../lib/news';

const { news } = await fetchAllNews();
// Ambil Top 2 berita terbaru
const top2News = news.slice(0, 2);
---

<section class="fullwidth-section home-news-section" id="news">
  <div class="container">
    
    <!-- Section Header -->
    <div class="home-news-header">
      <div class="header-left">
        <span class="section-tag red-text" data-i18n="home_news_tag">MEDIA & OFFICIAL ANNOUNCEMENTS</span>
        <h2 class="section-title">
          <span data-i18n="home_news_title_prefix">Warta Terkini </span><span class="red-text" data-i18n="home_news_title_highlight">& Berita Korporasi</span>
        </h2>
        <p class="section-subtitle" data-i18n="home_news_subtitle">
          Publikasi resmi, rilis media, dan pengumuman strategis PT CHAIN ASIA CONECT yang diperbarui secara langsung.
        </p>
      </div>
      <div class="header-right">
        <a href="/newsroom" class="btn-more-red">
          <span data-i18n="home_news_btn_all">Lihat Semua Berita →</span>
        </a>
      </div>
    </div>

    <!-- Top 2 News Grid -->
    <div class="home-news-grid" id="home-news-grid-container">
      {top2News.length === 0 ? (
        <div class="news-loading-card">
          <div class="news-spinner"></div>
          <p>Memuat warta terbaru langsung dari Google Sheets...</p>
        </div>
      ) : (
        top2News.map((item) => (
          <article class="home-news-card">
            <a href={`/newsroom/${item.slug}`} class="card-media-box">
              <img 
                src={formatImageUrl(item.imageUrl)} 
                alt={item.title} 
                class="card-img" 
                loading="lazy" 
                referrerpolicy="no-referrer"
              />
            </a>

            <div class="card-body">
              <div class="card-meta">
                <span class="meta-tag red-text">{item.tag}</span>
                <span class="meta-dot">•</span>
                <time class="meta-date">{item.date}</time>
                <span class="meta-dot">•</span>
                <span class="meta-read">{item.readTime || '3 min baca'}</span>
              </div>

              <h3 class="card-title">
                <a href={`/newsroom/${item.slug}`}>{item.title}</a>
              </h3>

              <p class="card-desc">
                {item.excerpt}
              </p>

              <div class="card-action">
                <a href={`/newsroom/${item.slug}`} class="card-link red-text">
                  <span data-i18n="home_news_read_more">Baca Selengkapnya →</span>
                  <svg viewBox="0 0 20 20" fill="currentColor" class="arrow-icon">
                    <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      )}
    </div>

    <!-- Mobile Button More (Tampil di bawah grid jika layar HP) -->
    <div class="mobile-more-wrap">
      <a href="/newsroom" class="btn-more-red full-mobile">
        <span data-i18n="home_news_btn_all">Lihat Semua Berita →</span>
      </a>
    </div>

  </div>
</section>

<script>
  import { GOOGLE_SHEET_CSV_URL, parseCSV, slugify, formatImageUrl } from '../lib/news';

  async function syncLiveHomeNews() {
    const gridEl = document.getElementById('home-news-grid-container');
    if (!gridEl) return;

    try {
      const res = await fetch(`${GOOGLE_SHEET_CSV_URL}&_cb=${Date.now()}`, { cache: 'no-store' });
      if (!res.ok) return;
      const csv = await res.text();
      const rows = parseCSV(csv);
      if (!rows || rows.length === 0) return;

      const items = rows
        .map((r, idx) => {
          const rawStatus = (r.status || 'published').toLowerCase().trim();
          if (rawStatus === 'draft') return null;
          const titleVal = (r.judul || r.title || '').trim();
          if (!titleVal) return null;
          const contentVal = (r.isiberita || r.isi || r.content || r.ringkasan || r.excerpt || '').trim();
          const excerptVal = (r.ringkasan || r.excerpt || r.deskripsi || (contentVal.length > 150 ? contentVal.substring(0, 150) + '...' : contentVal)).trim();
          const rawImg = (r.gambarurl || r.gambar || r.foto || r.imageurl || r.image || r.linkgambar || '').trim();
          const imgVal = formatImageUrl(rawImg) || 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80';
          const linkVal = (r.link || r.url || (contentVal.startsWith('http') ? contentVal : '')).trim();
          const rawId = (r.id && r.id.trim()) || String(idx + 1);
          const cleanId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || String(idx + 1);
          const generatedSlug = slugify(titleVal) || cleanId;
          return {
            id: cleanId,
            slug: generatedSlug,
            tag: (r.kategori || r.tag || r.category || 'PRESS RELEASE').toUpperCase(),
            date: (r.tanggal || r.date || 'TERBARU').toUpperCase(),
            title: titleVal,
            excerpt: excerptVal,
            imageUrl: imgVal,
            readTime: '3 min baca'
          };
        })
        .filter(Boolean);

      items.sort((a, b) => {
        const numA = parseFloat(a.id);
        const numB = parseFloat(b.id);
        if (!isNaN(numA) && !isNaN(numB)) return numB - numA;
        return b.id.localeCompare(a.id, undefined, { numeric: true });
      });

      const top2 = items.slice(0, 2);
      if (top2.length > 0) {
        gridEl.innerHTML = top2.map(item => `
          <article class="home-news-card">
            <a href="/newsroom/${item.slug}" class="card-media-box">
              <img 
                src="${item.imageUrl}" 
                alt="${item.title}" 
                class="card-img" 
                loading="lazy" 
                referrerpolicy="no-referrer"
              />
            </a>
            <div class="card-body">
              <div class="card-meta">
                <span class="meta-tag red-text">${item.tag}</span>
                <span class="meta-dot">•</span>
                <time class="meta-date">${item.date}</time>
                <span class="meta-dot">•</span>
                <span class="meta-read">${item.readTime}</span>
              </div>
              <h3 class="card-title">
                <a href="/newsroom/${item.slug}">${item.title}</a>
              </h3>
              <p class="card-desc">${item.excerpt}</p>
              <div class="card-action">
                <a href="/newsroom/${item.slug}" class="card-link red-text">
                  <span>Baca Selengkapnya →</span>
                  <svg viewBox="0 0 20 20" fill="currentColor" class="arrow-icon">
                    <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        `).join('');
      }
    } catch (e) {
      // Keep static SSR content
    }
  }

  if (typeof window !== 'undefined') {
    syncLiveHomeNews();
  }
</script>

<style is:global>
  .home-news-section {
    background: #ffffff;
    padding: 5rem 0;
    border-top: 1px solid var(--border-light);
  }

  .home-news-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .header-left {
    max-width: 720px;
  }

  .section-tag {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .news-loading-card {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 4rem 2rem;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .news-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(220, 38, 38, 0.15);
    border-top-color: #dc2626;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .section-title {
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--text-dark);
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .header-right {
    flex-shrink: 0;
  }

  .btn-more-red {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.4rem;
    background: #fef2f2;
    color: var(--red-primary, #dc2626);
    border: 1px solid rgba(220, 38, 38, 0.25);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-more-red:hover {
    background: var(--red-primary, #dc2626);
    color: #ffffff;
    border-color: var(--red-primary, #dc2626);
  }

  /* Top 2 News Grid */
  .home-news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .home-news-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .home-news-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
    border-color: #cbd5e1;
  }

  .card-media-box {
    position: relative;
    width: 100%;
    height: 240px;
    background: #f1f5f9;
    overflow: hidden;
    display: block;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .home-news-card:hover .card-img {
    transform: scale(1.04);
  }

  .meta-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--red-primary, #dc2626);
    text-transform: uppercase;
  }

  .card-body {
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.775rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.65rem;
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .card-title {
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .card-title a {
    color: var(--text-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--red-primary, #dc2626);
  }

  .card-desc {
    font-size: 0.925rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-action {
    margin-top: auto;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .card-link:hover {
    gap: 0.6rem;
  }

  .arrow-icon {
    width: 16px;
    height: 16px;
  }

  .mobile-more-wrap {
    display: none;
    margin-top: 2rem;
    text-align: center;
  }

  @media (max-width: 860px) {
    .home-news-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .header-right {
      display: none;
    }

    .mobile-more-wrap {
      display: block;
    }

    .home-news-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .card-media-box {
      height: 200px;
    }

    .card-body {
      padding: 1.5rem;
    }

    .full-mobile {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
