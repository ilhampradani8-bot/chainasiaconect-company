---

<section class="legal-section" id="legalitas">
  <div class="container">
    <div class="legal-banner glass-card">
      <div class="legal-banner-grid">
        <div class="legal-info">
          <div class="badge">
            <span class="badge-dot"></span>
            <span>Verifikasi Legalitas Korporat</span>
          </div>
          <h2 class="legal-title">
            Perusahaan Resmi Terdaftar Legal di Indonesia
          </h2>
          <p class="legal-desc">
            PT CHAIN ASIA CONECT telah terdaftar resmi sebagai Perseroan Terbatas (PT Perorangan) dengan legalitas hukum lengkap. Keabsahan ini merupakan komitmen dan posisi tawar profesional kami sebagai entitas bisnis terpercaya bagi para mitra usaha.
          </p>

          <div class="legal-credential-list">
            <div class="cred-item">
              <div class="cred-icon">✓</div>
              <div>
                <strong>Perseroan Terbatas (PT Perorangan)</strong>
                <p>Terdaftar resmi sejak 1 September 2026 di Republik Indonesia.</p>
              </div>
            </div>

            <div class="cred-item">
              <div class="cred-icon">✓</div>
              <div>
                <strong>SK Kemenkumham RI</strong>
                <p>Nomor SK: AHU-A117353.AH.01.30.Tahun 2026 (Ditetapkan di Jakarta, 29 Agustus 2026).</p>
              </div>
            </div>

            <div class="cred-item">
              <div class="cred-icon">✓</div>
              <div>
                <strong>NIB & KBLI Resmi</strong>
                <p>NIB 0709260109599 | KBLI 62193 (Aktivitas Pengembangan Aplikasi Berbasis Teknologi Blockchain & Rantai Pasok).</p>
              </div>
            </div>

            <div class="cred-item">
              <div class="cred-icon">✓</div>
              <div>
                <strong>NPWP Wajib Pajak Badan</strong>
                <p>NPWP: 10.000.000.1-094.6336.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="legal-visual">
          <div class="legal-card-display glass-card">
            <div class="card-header">
              <div class="card-chip"></div>
              <span class="card-type">OFFICIAL LEGAL ENTITY</span>
            </div>
            <div class="card-body">
              <span class="card-company">PT CHAIN ASIA CONECT</span>
              <span class="card-nib">NIB: 0709260109599</span>
              <span class="card-sk">SK: AHU-A117353.AH.01.30</span>
            </div>
            <div class="card-footer">
              <div class="status-indicator">
                <span class="status-dot"></span>
                <span>STATUS: VERIFIED & ACTIVE</span>
              </div>
              <span class="card-loc">JAKARTA - KRUI</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .legal-section {
    padding: 4rem 0 6rem 0;
  }

  .legal-banner {
    padding: 3.5rem;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(7, 9, 19, 0.98) 100%);
    border: 1px solid var(--border-glow);
  }

  .legal-banner-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  .legal-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 1rem 0 1.25rem 0;
  }

  .legal-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .legal-credential-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cred-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .cred-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #a7f3d0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cred-item strong {
    font-size: 0.975rem;
    color: #ffffff;
    display: block;
    margin-bottom: 0.15rem;
  }

  .cred-item p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Legal Card Visual */
  .legal-visual {
    display: flex;
    justify-content: center;
  }

  .legal-card-display {
    width: 100%;
    max-width: 380px;
    padding: 1.75rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(6, 182, 212, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(6, 182, 212, 0.15);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-radius: var(--radius-md);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-chip {
    width: 42px;
    height: 30px;
    border-radius: 6px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  }

  .card-type {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--primary-light);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card-company {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .card-nib, .card-sk {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: monospace;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.725rem;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #10b981;
    font-weight: 700;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .card-loc {
    color: var(--text-dim);
    font-weight: 600;
  }

  @media (max-width: 992px) {
    .legal-banner-grid {
      grid-template-columns: 1fr;
    }
    .legal-banner {
      padding: 2rem;
    }
  }
</style>
