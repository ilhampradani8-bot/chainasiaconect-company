---
---

<section class="fullwidth-section alt-bg legal-section" id="legalitas">
  <div class="container">
    <div class="editorial-grid">
      <!-- Left Column: Legal Text Summary -->
      <div class="legal-text-col">
        <div class="classic-badge">
          <span>Keabsahan Entitas Hukum</span>
        </div>

        <h2 class="legal-heading">
          Perusahaan Resmi <span class="gold-text">Terdaftar Legal</span>
        </h2>

        <div class="gold-divider-small"></div>

        <p class="legal-intro">
          Legalitas bisnis <strong>PT CHAIN ASIA CONECT</strong> telah terdaftar resmi sebagai PT Perorangan pada <strong>1 September 2026</strong>. Keabsahan legal hukum ini merupakan posisi tawar profesional perusahaan sebagai mitra bisnis yang transparan, andal, dan terpercaya.
        </p>

        <!-- Credentials List Fullwidth Style -->
        <div class="credentials-stack">
          <div class="cred-row">
            <span class="cred-tag">SK KEMENKUMHAM</span>
            <div class="cred-detail">
              <strong class="gold-text">AHU-A117353.AH.01.30.Tahun 2026</strong>
              <p>Ditetapkan resmi di Jakarta pada tanggal 29 Agustus 2026.</p>
            </div>
          </div>

          <div class="cred-row">
            <span class="cred-tag">NIB (NOMOR INDUK BERUSAHA)</span>
            <div class="cred-detail">
              <strong class="gold-text">0709260109599</strong>
              <p>KBLI 62193: Aktivitas Pengembangan Aplikasi Berbasis Teknologi Blockchain & Rantai Pasok.</p>
            </div>
          </div>

          <div class="cred-row">
            <span class="cred-tag">NPWP WAJIB PAJAK</span>
            <div class="cred-detail">
              <strong class="gold-text">10.000.000.1-094.6336</strong>
              <p>Terdaftar resmi pada Direktorat Jenderal Pajak Republik Indonesia.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Classic Embellishment Visual -->
      <div class="legal-visual-col">
        <div class="classic-certificate-frame">
          <div class="cert-header">
            <span class="cert-country gold-text">REPUBLIK INDONESIA</span>
            <span class="cert-title">SERTIFIKAT LEGALITAS KORPORAT</span>
          </div>
          <div class="cert-body">
            <span class="cert-name">PT CHAIN ASIA CONECT</span>
            <div class="cert-line"></div>
            <div class="cert-meta">
              <span>Status: Active PT Perorangan</span>
              <span>Wilayah: Jakarta - Krui</span>
              <span>KBLI Utama: 62193</span>
            </div>
          </div>
          <div class="cert-footer">
            <span class="cert-sk">SK: AHU-A117353.AH.01.30.Tahun 2026</span>
            <div class="cert-seal">VERIFIED</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .legal-section {
    position: relative;
    border-top: 1px solid var(--border-classic);
  }

  .legal-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 1rem 0 0.5rem 0;
  }

  .legal-intro {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .credentials-stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cred-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-faint);
  }

  .cred-row:last-child {
    border-bottom: none;
  }

  .cred-tag {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .cred-detail strong {
    font-size: 1.1rem;
    display: block;
    margin-bottom: 0.2rem;
  }

  .cred-detail p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Right Side Certificate Frame */
  .legal-visual-col {
    display: flex;
    justify-content: center;
  }

  .classic-certificate-frame {
    width: 100%;
    max-width: 420px;
    padding: 2.5rem;
    background: #040509;
    border: 2px solid var(--gold-primary);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: 0 0 35px rgba(212, 175, 55, 0.15);
  }

  .cert-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-bottom: 1px solid var(--border-classic);
    padding-bottom: 1.25rem;
  }

  .cert-country {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    font-weight: 700;
  }

  .cert-title {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .cert-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cert-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }

  .cert-line {
    width: 60px;
    height: 1px;
    background: var(--gold-primary);
    margin: 1rem 0;
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .cert-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-classic);
  }

  .cert-sk {
    font-size: 0.725rem;
    color: var(--text-muted);
    font-family: monospace;
  }

  .cert-seal {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    border: 1px solid #10b981;
    color: #10b981;
  }

  @media (max-width: 768px) {
    .classic-certificate-frame {
      padding: 1.5rem;
    }
  }
</style>
