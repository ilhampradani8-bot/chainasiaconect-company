---
---

<section class="fullwidth-section legal-section-clean" id="legal">
  <div class="container">
    <div class="legal-header-clean">
      <span class="legal-tag-clean red-text">LEGAL VERIFICATION & CREDENTIALS</span>
      <h2 class="legal-title-clean">
        Officially Registered Corporate Entity <span class="red-text">in Indonesia</span>
      </h2>
      <p class="legal-intro-clean">
        The business legality of <strong>PT CHAIN ASIA CONECT</strong> is officially registered as an Individual Limited Liability Company (PT Perorangan) as of <strong>September 1, 2026</strong>. This complete legal standing represents our professional commitment as a transparent, reliable, and trusted business partner.
      </p>
    </div>

    <!-- Credentials Stack (Clean Rows, No Card Boxes, No inner lines) -->
    <div class="legal-credentials-clean">
      <div class="cred-clean-row">
        <span class="cred-clean-label">SK KEMENKUMHAM RI DECREE</span>
        <div class="cred-clean-body">
          <strong class="cred-clean-val red-text">AHU-A117353.AH.01.30.Year 2026</strong>
          <span class="cred-clean-desc">Officially decreed by the Ministry of Law and Human Rights of the Republic of Indonesia on August 29, 2026.</span>
          
          <div class="doc-action-group">
            <a href="/docs/sk-kemenkumham-ahu.pdf" target="_blank" rel="noopener" class="btn-red-doc">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              <span>View Official SK Kemenkumham Decree (PDF) →</span>
            </a>
            <button type="button" class="btn-toggle-preview" id="toggle-pdf-btn">
              <span>Inline Document Preview</span>
            </button>
          </div>

          <!-- Embedded Inline PDF Viewer Container -->
          <div class="pdf-preview-container hidden" id="pdf-preview-box">
            <iframe src="/docs/sk-kemenkumham-ahu.pdf" title="SK Kemenkumham Decree PDF" class="pdf-iframe"></iframe>
          </div>
        </div>
      </div>

      <div class="cred-clean-row">
        <span class="cred-clean-label">BUSINESS IDENTIFICATION NO. (NIB)</span>
        <div class="cred-clean-body">
          <strong class="cred-clean-val red-text">0709260109599</strong>
          <span class="cred-clean-desc">KBLI 62193 (Blockchain Technology Application Development & Supply Chain Systems).</span>
        </div>
      </div>

      <div class="cred-clean-row">
        <span class="cred-clean-label">TAX IDENTIFICATION NO. (NPWP)</span>
        <div class="cred-clean-body">
          <strong class="cred-clean-val red-text">10.000.000.1-094.6336</strong>
          <span class="cred-clean-desc">Officially registered with the Directorate General of Taxes of the Republic of Indonesia.</span>
        </div>
      </div>

      <div class="cred-clean-row">
        <span class="cred-clean-label">CORPORATE LEGAL STATUS</span>
        <div class="cred-clean-body">
          <strong class="cred-clean-val" style="color: #16a34a;">OFFICIALLY VERIFIED & ACTIVE</strong>
          <span class="cred-clean-desc">Registered Individual Limited Liability Company in the Republic of Indonesia.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('toggle-pdf-btn');
    const box = document.getElementById('pdf-preview-box');
    if (btn && box) {
      btn.addEventListener('click', () => {
        box.classList.toggle('hidden');
      });
    }
  });
</script>

<style>
  .legal-section-clean {
    background: #ffffff;
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .legal-header-clean {
    max-width: 800px;
    margin-bottom: 2rem;
  }

  .legal-tag-clean {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .legal-title-clean {
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--text-dark);
  }

  .legal-intro-clean {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-body);
    margin-top: 0.5rem;
  }

  .legal-credentials-clean {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .cred-clean-row {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 0.5rem 0;
  }

  .cred-clean-label {
    width: 240px;
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cred-clean-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .cred-clean-val {
    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .cred-clean-desc {
    font-size: 0.85rem;
    color: var(--text-body);
  }

  .doc-action-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.35rem;
    flex-wrap: wrap;
  }

  .btn-red-doc {
    padding: 0.45rem 1rem;
    background: var(--red-primary);
    color: #ffffff;
    font-size: 0.825rem;
    font-weight: 700;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: background var(--transition-smooth);
  }

  .btn-red-doc:hover {
    background: var(--red-dark);
  }

  .btn-toggle-preview {
    padding: 0.45rem 0.9rem;
    background: transparent;
    border: 1px solid var(--border-light);
    color: var(--text-dark);
    font-size: 0.825rem;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: all var(--transition-smooth);
  }

  .btn-toggle-preview:hover {
    border-color: var(--red-primary);
    color: var(--red-primary);
  }

  .pdf-preview-container {
    width: 100%;
    margin-top: 0.85rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    overflow: hidden;
  }

  .pdf-preview-container.hidden {
    display: none;
  }

  .pdf-iframe {
    width: 100%;
    height: 520px;
    border: none;
    display: block;
  }

  @media (max-width: 640px) {
    .cred-clean-row {
      flex-direction: column;
      gap: 0.25rem;
    }
    .cred-clean-label {
      width: 100%;
    }
    .pdf-iframe {
      height: 380px;
    }
  }
</style>


