---
---

<section class="fullwidth-section alt-section legal-section" id="legalitas">
  <div class="container">
    <div class="editorial-grid">
      <!-- Left Column: Legal Text Summary -->
      <div class="legal-text-col">
        <div class="red-badge">
          <span>Keabsahan Legalitas Hukum</span>
        </div>

        <h2 class="legal-heading">
          Perusahaan Resmi <span class="red-text">Terdaftar di Kemenkumham RI</span>
        </h2>

        <div class="red-line-small"></div>

        <p class="legal-intro">
          Legalitas bisnis <strong>PT CHAIN ASIA CONECT</strong> telah terdaftar resmi sebagai PT Perorangan pada <strong>1 September 2026</strong>. Keabsahan legal hukum ini merupakan posisi tawar profesional perusahaan sebagai mitra bisnis yang transparan, andal, dan terpercaya.
        </p>

        <!-- Credentials List Fullwidth -->
        <div class="credentials-list">
          <div class="cred-item">
            <div class="cred-badge-icon">✓</div>
            <div>
              <strong class="cred-title">SK Kemenkumham RI</strong>
              <p class="cred-val red-text">AHU-A117353.AH.01.30.Tahun 2026</p>
              <span class="cred-sub">Ditetapkan resmi di Jakarta pada tanggal 29 Agustus 2026.</span>
            </div>
          </div>

          <div class="cred-item">
            <div class="cred-badge-icon">✓</div>
            <div>
              <strong class="cred-title">NIB (Nomor Induk Berusaha)</strong>
              <p class="cred-val red-text">0709260109599</p>
              <span class="cred-sub">KBLI 62193 (Aktivitas Pengembangan Aplikasi Berbasis Teknologi Blockchain & Rantai Pasok).</span>
            </div>
          </div>

          <div class="cred-item">
            <div class="cred-badge-icon">✓</div>
            <div>
              <strong class="cred-title">NPWP Wajib Pajak Badan</strong>
              <p class="cred-val red-text">10.000.000.1-094.6336</p>
              <span class="cred-sub">Terdaftar resmi pada Direktorat Jenderal Pajak RI.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Official Legal Emblem Visual -->
      <div class="legal-badge-col">
        <div class="legal-document-box">
          <div class="doc-header">
            <img src="/images/CAC-LOGO.jpg" alt="PT CHAIN ASIA CONECT Logo" class="doc-logo" />
            <span class="doc-title">REPUBLIK INDONESIA</span>
            <span class="doc-sub">KEMENTERIAN HUKUM DAN HAK ASASI MANUSIA</span>
          </div>

          <div class="doc-body">
            <span class="doc-label">NAMA PERSEROAN TERBATAS</span>
            <strong class="doc-company red-text">PT CHAIN ASIA CONECT</strong>

            <div class="doc-divider"></div>

            <div class="doc-grid">
              <div class="doc-grid-item">
                <span>SK KEMENKUMHAM:</span>
                <strong>AHU-A117353.AH.01.30</strong>
              </div>
              <div class="doc-grid-item">
                <span>NIB:</span>
                <strong>0709260109599</strong>
              </div>
              <div class="doc-grid-item">
                <span>NPWP:</span>
                <strong>10.000.000.1-094.6336</strong>
              </div>
              <div class="doc-grid-item">
                <span>KBLI UTAMA:</span>
                <strong>62193</strong>
              </div>
            </div>
          </div>

          <div class="doc-footer">
            <span class="status-verified">STATUS: TERDAFTAR LEGAL & AKTIF</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .legal-section {
    position: relative;
  }

  .legal-heading {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    margin: 0.85rem 0 0.5rem 0;
  }

  .legal-intro {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-body);
    margin-bottom: 2rem;
  }

  .credentials-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cred-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .cred-item:last-child {
    border-bottom: none;
  }

  .cred-badge-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--red-light);
    border: 1px solid var(--red-primary);
    color: var(--red-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cred-title {
    font-size: 0.95rem;
    color: var(--text-dark);
  }

  .cred-val {
    font-family: monospace;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .cred-sub {
    font-size: 0.825rem;
    color: var(--text-muted);
    display: block;
  }

  /* Legal Document Visual Box */
  .legal-badge-col {
    display: flex;
    justify-content: center;
  }

  .legal-document-box {
    width: 100%;
    max-width: 400px;
    padding: 2rem;
    background: #ffffff;
    border: 2px solid var(--red-primary);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(220, 38, 38, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .doc-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-bottom: 1px dashed var(--border-light);
    padding-bottom: 1rem;
  }

  .doc-logo {
    width: 54px;
    height: 54px;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .doc-title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .doc-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .doc-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .doc-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .doc-company {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    margin-top: 0.2rem;
  }

  .doc-divider {
    width: 100%;
    height: 1px;
    background: var(--border-light);
    margin: 1rem 0;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    width: 100%;
    text-align: left;
  }

  .doc-grid-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .doc-grid-item span {
    font-size: 0.675rem;
    color: var(--text-muted);
    font-weight: 700;
  }

  .doc-grid-item strong {
    font-size: 0.8rem;
    color: var(--text-dark);
    font-family: monospace;
  }

  .doc-footer {
    border-top: 1px dashed var(--border-light);
    padding-top: 1rem;
    text-align: center;
  }

  .status-verified {
    font-size: 0.75rem;
    font-weight: 800;
    color: #16a34a;
    letter-spacing: 0.05em;
  }
</style>
