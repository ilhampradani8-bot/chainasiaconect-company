---
---

<section class="fullwidth-section services-section-clean" id="services">
  <div class="container">
    <!-- Section Header (English) -->
    <div class="services-header-clean">
      <span class="services-tag red-text">OUR SPECIALIZED SERVICES & SOLUTIONS</span>
      <h2 class="services-title">
        Enterprise Medical Engineering <br /><span class="red-text">& Software Systems Licensing</span>
      </h2>
      <p class="services-subtitle">
        Providing high-precision medical machinery engineering, advanced diagnostic software licensing, and enterprise healthcare infrastructure integration.
      </p>
    </div>

    <!-- Service Detail Block (Fullwidth Clean Editorial Layout, No Cards, No inner lines) -->
    <div class="service-detail-block">
      <div class="service-main-info">
        <span class="service-code red-text">SERVICE DIVISION 01</span>
        <h3 class="service-name">Advanced Medical Engineering Machines & Precision Diagnostic Software</h3>

        <p class="service-description">
          PT CHAIN ASIA CONECT delivers specialized procurement, engineering integration, and official software licensing for high-value medical diagnostic machinery and healthcare software infrastructure. We connect medical institutions with world-class engineering systems designed for critical diagnostic accuracy and operational reliability.
        </p>

        <div class="service-highlights-list">
          <div class="highlight-item">
            <span class="highlight-num red-text">•</span>
            <div>
              <strong>Medical Diagnostic Machine Engineering</strong>
              <p>Turnkey integration, maintenance, and technical calibration for advanced precision medical machinery and imaging equipment.</p>
            </div>
          </div>

          <div class="highlight-item">
            <span class="highlight-num red-text">•</span>
            <div>
              <strong>Enterprise Healthcare Software & DICOM/PACS Licensing</strong>
              <p>Official enterprise software licensing for medical imaging, diagnostic AI analysis software, and high-security hospital information systems.</p>
            </div>
          </div>

          <div class="highlight-item">
            <span class="highlight-num red-text">•</span>
            <div>
              <strong>Regulated Medical Equipment Procurement & Compliance</strong>
              <p>End-to-end supply chain management for certified medical devices and software engineering systems compliant with international healthcare standards.</p>
            </div>
          </div>
        </div>

        <div class="service-action">
          <a href="mailto:sales@chainasiaconect.company" class="btn-red-simple">
            <span>Inquire Medical Engineering & Software Licensing →</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section-clean {
    background: #ffffff;
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .services-header-clean {
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .services-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .services-title {
    font-size: clamp(2rem, 4vw, 2.7rem);
    color: var(--text-dark);
    line-height: 1.15;
  }

  .services-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  /* Service Detail Block */
  .service-detail-block {
    padding-top: 1rem;
  }

  .service-main-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-code {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .service-name {
    font-size: 1.4rem;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .service-description {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-body);
    margin-bottom: 1.5rem;
  }

  .service-highlights-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    width: 100%;
    margin-bottom: 1.75rem;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .highlight-num {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .highlight-item strong {
    font-size: 1rem;
    color: var(--text-dark);
    display: block;
    margin-bottom: 0.15rem;
  }

  .highlight-item p {
    font-size: 0.925rem;
    color: var(--text-body);
    margin: 0;
  }

  .service-action {
    margin-top: 0.25rem;
  }

  .btn-red-simple {
    padding: 0.65rem 1.4rem;
    background: var(--red-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 4px;
    transition: background var(--transition-smooth);
    display: inline-flex;
    align-items: center;
  }

  .btn-red-simple:hover {
    background: var(--red-dark);
  }
</style>

