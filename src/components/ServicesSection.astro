---
---

<section class="fullwidth-section services-section-clean" id="services">
  <div class="container">
    <!-- Section Header (English) -->
    <div class="services-header-clean">
      <span class="services-tag red-text" data-i18n="services_tag">OUR SPECIALIZED SERVICES & SOLUTIONS</span>
      <h2 class="services-title" data-i18n="services_title">
        Enterprise Medical Engineering & Software Systems Licensing
      </h2>
      <p class="services-subtitle" data-i18n="services_subtitle">
        Providing high-precision medical machinery engineering, advanced diagnostic software licensing, and enterprise healthcare infrastructure integration.
      </p>
    </div>

    <!-- Service Detail Block (2 Column Layout with 3D Data Visualization Image on Right) -->
    <div class="service-detail-block">
      <div class="service-split-container">
        <!-- Left Text Column -->
        <div class="service-main-info">
          <span class="service-code red-text" data-i18n="serv_div_code">SERVICE DIVISION 01</span>
          <h3 class="service-name" data-i18n="serv_div_title">Advanced Medical Engineering Machines & Precision Diagnostic Software</h3>

          <p class="service-description" data-i18n="serv_div_desc">
            PT CHAIN ASIA CONECT delivers specialized procurement, engineering integration, and official software licensing for high-value medical diagnostic machinery and healthcare software infrastructure. We connect medical institutions with world-class engineering systems designed for critical diagnostic accuracy and operational reliability.
          </p>

          <div class="service-highlights-list">
            <div class="highlight-item">
              <span class="highlight-num red-text">•</span>
              <div>
                <strong data-i18n="serv_h1_title">Medical Diagnostic Machine Engineering</strong>
                <p data-i18n="serv_h1_desc">Turnkey integration, maintenance, and technical calibration for advanced precision medical machinery and imaging equipment.</p>
              </div>
            </div>

            <div class="highlight-item">
              <span class="highlight-num red-text">•</span>
              <div>
                <strong data-i18n="serv_h2_title">Enterprise Healthcare Software & DICOM/PACS Licensing</strong>
                <p data-i18n="serv_h2_desc">Official enterprise software licensing for medical imaging, diagnostic AI analysis software, and high-security hospital information systems.</p>
              </div>
            </div>

            <div class="highlight-item">
              <span class="highlight-num red-text">•</span>
              <div>
                <strong data-i18n="serv_h3_title">Regulated Medical Equipment Procurement & Compliance</strong>
                <p data-i18n="serv_h3_desc">End-to-end supply chain management for certified medical devices and software engineering systems compliant with international healthcare standards.</p>
              </div>
            </div>
          </div>

          <div class="service-action">
            <a href="mailto:sales@chainasiaconnect.co.id" class="btn-red-simple">
              <span data-i18n="serv_btn_inquire">Inquire Medical Engineering & Software Licensing →</span>
            </a>
            <a href="#gromacs-pricing" class="btn-pricing-shortcut">
              <span data-i18n="serv_btn_pricing">View GROMACS Cloud Server Pricing (From $900) ↓</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Official 3D Data Visualization Graphic -->
        <div class="service-image-col">
          <div class="service-image-frame">
            <img src="/images/visualization-tutorial-data-loading-and-3d-visualization.png" alt="Medical Systems 3D Data Loading & Visualization Graphic" class="service-3d-img" />
            <span class="img-caption">Medical Software DICOM/PACS 3D Visualization System Integration</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section-clean {
    background: #ffffff;
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .services-header-clean {
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .services-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .services-title {
    font-size: clamp(2rem, 4vw, 2.7rem);
    color: var(--text-dark);
    line-height: 1.15;
  }

  .services-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  /* Service Split Container (Left Info, Right Image) */
  .service-split-container {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .service-main-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-code {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .service-name {
    font-size: 1.4rem;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .service-description {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-body);
    margin-bottom: 1.5rem;
  }

  .service-highlights-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    width: 100%;
    margin-bottom: 1.75rem;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .highlight-num {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .highlight-item strong {
    font-size: 1rem;
    color: var(--text-dark);
    display: block;
    margin-bottom: 0.15rem;
  }

  .highlight-item p {
    font-size: 0.925rem;
    color: var(--text-body);
    margin: 0;
  }

  .service-action {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .btn-red-simple {
    padding: 0.65rem 1.35rem;
    background: var(--red-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 6px;
    transition: background var(--transition-smooth), transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
  }

  .btn-red-simple:hover {
    background: var(--red-dark);
    transform: translateY(-1px);
  }

  .btn-pricing-shortcut {
    padding: 0.65rem 1.35rem;
    background: #ffffff;
    color: var(--text-dark);
    font-weight: 700;
    font-size: 0.875rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .btn-pricing-shortcut:hover {
    border-color: #dc2626;
    color: #dc2626;
    background: #fef2f2;
    transform: translateY(-1px);
  }

  /* Right Image Column */
  .service-image-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .service-image-frame {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease;
  }

  .service-image-frame:hover {
    transform: translateY(-4px);
  }

  .service-3d-img {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: contain;
    border-radius: 4px;
    display: block;
  }

  .img-caption {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.65rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 992px) {
    .service-split-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .service-name {
      font-size: clamp(1.15rem, 4.5vw, 1.35rem);
    }
    .service-action {
      flex-direction: column;
      width: 100%;
      gap: 0.65rem;
    }
    .btn-red-simple,
    .btn-pricing-shortcut {
      width: 100%;
      box-sizing: border-box;
      justify-content: center;
      text-align: center;
      padding: 0.75rem 1rem;
    }
    .service-3d-img {
      max-height: 220px;
    }
    .service-image-frame {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
