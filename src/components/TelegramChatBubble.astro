---
// ChatBubble.astro - Clean Modern Live Chat Widget for PT CHAIN ASIA CONECT
---

<div class="chat-widget-root" id="chat-widget-root">
  <!-- Live Chat Popup Window -->
  <div class="chat-window" id="chat-window" aria-hidden="true">
    
    <!-- Window Header -->
    <div class="chat-header">
      <div class="chat-header-profile">
        <div class="chat-avatar-wrapper">
          <img src="/images/CAC-LOGOremovebg-preview.png" alt="PT CHAIN ASIA CONECT" class="chat-avatar-img" />
          <span class="chat-online-dot"></span>
        </div>
        <div class="chat-header-meta">
          <h4 class="chat-company-name">Customer Care</h4>
          <span class="chat-status-text">PT CHAIN ASIA CONECT • Online</span>
        </div>
      </div>
      <button type="button" class="chat-btn-close" id="chat-close-btn" aria-label="Tutup Chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Chat Messages Stream -->
    <div class="chat-messages-body" id="chat-messages-stream">
      
      <!-- Time divider -->
      <div class="chat-time-divider">Hari ini</div>

      <!-- Agent Greeting Message -->
      <div class="chat-msg chat-msg-agent">
        <div class="chat-bubble-agent">
          <p>Halo! Selamat datang di <strong>PT CHAIN ASIA CONECT</strong>. 👋</p>
          <p>Ada yang bisa kami bantu mengenai kemitraan rantai pasok, layanan, atau proposal bisnis kami?</p>
          <span class="chat-msg-stamp">CS Team</span>
        </div>
      </div>

      <!-- Topic suggestions -->
      <div class="chat-topic-suggestions" id="chat-suggestions-box">
        <span class="chat-suggestions-title">Pertanyaan Umum:</span>
        <button type="button" class="chat-topic-btn" data-msg="Halo, saya ingin menanyakan kerja sama kemitraan rantai pasok.">
          🤝 Kemitraan Rantai Pasok
        </button>
        <button type="button" class="chat-topic-btn" data-msg="Halo, saya ingin informasi seputar profil dan legalitas perusahaan.">
          📑 Informasi & Legalitas PT
        </button>
        <button type="button" class="chat-topic-btn" data-msg="Halo, saya ingin menghubungi tim manajemen PT CHAIN ASIA CONECT.">
          📞 Hubungi Manajemen
        </button>
      </div>

    </div>

    <!-- Chat Input Area -->
    <div class="chat-input-area">
      <form id="chat-input-form" class="chat-form">
        <div class="chat-input-container">
          <input 
            type="text" 
            id="chat-user-input" 
            class="chat-text-field" 
            placeholder="Ketik pesan Anda di sini..." 
            autocomplete="off"
            required 
          />
          <button type="submit" class="chat-send-action" id="chat-send-btn" aria-label="Kirim Pesan">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </form>
      <div class="chat-secure-notice">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Layanan pesan terenkripsi PT CHAIN ASIA CONECT</span>
      </div>
    </div>

  </div>

  <!-- Main Floating Toggle Bubble -->
  <button type="button" class="chat-floating-btn" id="chat-floating-trigger" aria-label="Live Chat Support">
    <div class="chat-icon-wrap chat-icon-open">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
    </div>
    <div class="chat-icon-wrap chat-icon-close" style="display: none;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>
    <span class="chat-badge-pulse" id="chat-notif-badge">1</span>
  </button>
</div>

<style>
  .chat-widget-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  /* Floating Trigger Button */
  .chat-floating-btn {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: linear-gradient(135deg, #be123c 0%, #9f1239 50%, #881337 100%);
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(190, 18, 60, 0.4), 0 4px 12px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease;
    position: relative;
    outline: none;
  }

  .chat-floating-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 28px rgba(190, 18, 60, 0.55), 0 6px 16px rgba(0, 0, 0, 0.4);
  }

  .chat-floating-btn:active {
    transform: scale(0.95);
  }

  .chat-badge-pulse {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 18px;
    height: 18px;
    background: #10b981;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #0f172a;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  /* Chat Window */
  .chat-window {
    position: absolute;
    bottom: 74px;
    right: 0;
    width: 360px;
    max-width: calc(100vw - 32px);
    height: 480px;
    max-height: calc(100vh - 110px);
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.96);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    backdrop-filter: blur(16px);
  }

  .chat-window.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Header */
  .chat-header {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chat-header-profile {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .chat-avatar-wrapper {
    position: relative;
    width: 38px;
    height: 38px;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }

  .chat-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .chat-online-dot {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 10px;
    height: 10px;
    background: #10b981;
    border: 2px solid #0f172a;
    border-radius: 50%;
  }

  .chat-header-meta {
    display: flex;
    flex-direction: column;
  }

  .chat-company-name {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #f8fafc;
    line-height: 1.2;
  }

  .chat-status-text {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 2px;
  }

  .chat-btn-close {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 6px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
  }

  .chat-btn-close:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Body Stream */
  .chat-messages-body {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #090e17;
  }

  .chat-time-divider {
    text-align: center;
    font-size: 11px;
    color: #64748b;
    margin: 2px 0;
  }

  .chat-msg {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }

  .chat-msg-agent {
    align-self: flex-start;
  }

  .chat-bubble-agent {
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px 14px 14px 3px;
    padding: 12px 14px;
    color: #e2e8f0;
    font-size: 13px;
    line-height: 1.45;
  }

  .chat-bubble-agent p {
    margin: 0 0 6px 0;
  }

  .chat-bubble-agent p:last-of-type {
    margin-bottom: 0;
  }

  .chat-msg-stamp {
    display: block;
    font-size: 10px;
    color: #64748b;
    margin-top: 6px;
    text-align: right;
  }

  .chat-msg-user {
    align-self: flex-end;
  }

  .chat-bubble-user {
    background: #be123c;
    color: #ffffff;
    border-radius: 14px 14px 3px 14px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 1.4;
    word-break: break-word;
  }

  /* Quick Topic Suggestions */
  .chat-topic-suggestions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
  }

  .chat-suggestions-title {
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
  }

  .chat-topic-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 10px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .chat-topic-btn:hover {
    background: rgba(190, 18, 60, 0.15);
    border-color: rgba(190, 18, 60, 0.4);
    color: #fca5a5;
    transform: translateX(3px);
  }

  /* Input Area */
  .chat-input-area {
    background: #0f172a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 14px 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chat-form {
    width: 100%;
    margin: 0;
  }

  .chat-input-container {
    display: flex;
    align-items: center;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 4px 6px 4px 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .chat-input-container:focus-within {
    border-color: #be123c;
    box-shadow: 0 0 0 2px rgba(190, 18, 60, 0.25);
  }

  .chat-text-field {
    flex: 1;
    background: transparent;
    border: none;
    color: #f8fafc;
    font-size: 13px;
    outline: none;
  }

  .chat-text-field::placeholder {
    color: #64748b;
  }

  .chat-send-action {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #be123c;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    padding: 0;
  }

  .chat-send-action:hover {
    background: #e11d48;
    transform: scale(1.05);
  }

  .chat-secure-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: 10px;
    color: #64748b;
  }

  /* Responsive for mobile */
  @media (max-width: 480px) {
    .chat-widget-root {
      bottom: 18px;
      right: 18px;
    }
    .chat-window {
      width: calc(100vw - 36px);
      height: 450px;
      bottom: 68px;
    }
    .chat-floating-btn {
      width: 52px;
      height: 52px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('chat-floating-trigger');
    const closeBtn = document.getElementById('chat-close-btn');
    const chatWin = document.getElementById('chat-window');
    const form = document.getElementById('chat-input-form');
    const input = document.getElementById('chat-user-input');
    const msgStream = document.getElementById('chat-messages-stream');
    const badge = document.getElementById('chat-notif-badge');
    const topicButtons = document.querySelectorAll('.chat-topic-btn');

    const botUsername = 'bubblechainasia_bot';

    function toggleChat() {
      if (!chatWin) return;
      const isOpen = chatWin.classList.toggle('open');
      chatWin.setAttribute('aria-hidden', !isOpen);
      if (isOpen) {
        if (badge) badge.style.display = 'none';
        if (input) input.focus();
      }
    }

    function closeChat() {
      if (chatWin) {
        chatWin.classList.remove('open');
        chatWin.setAttribute('aria-hidden', 'true');
      }
    }

    if (trigger) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleChat();
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeChat();
      });
    }

    // Close on outside click
    document.addEventListener('click', (e) => {
      const root = document.getElementById('chat-widget-root');
      if (root && !root.contains(e.target)) {
        closeChat();
      }
    });

    function appendUserMessage(text) {
      if (!msgStream) return;

      const userMsgDiv = document.createElement('div');
      userMsgDiv.className = 'chat-msg chat-msg-user';
      userMsgDiv.innerHTML = `<div class="chat-bubble-user">${escapeHtml(text)}</div>`;
      msgStream.appendChild(userMsgDiv);

      const agentReplyDiv = document.createElement('div');
      agentReplyDiv.className = 'chat-msg chat-msg-agent';
      agentReplyDiv.innerHTML = `
        <div class="chat-bubble-agent">
          <p>Terima kasih atas pesan Anda. Pesan telah diteruskan ke tim representatif kami.</p>
          <p style="margin-top: 6px;"><a href="https://t.me/${botUsername}?start=${encodeURIComponent(text)}" target="_blank" rel="noopener" style="color: #f43f5e; text-decoration: underline; font-weight: 500;">Klik di sini jika ingin melanjutkan obrolan langsung</a></p>
          <span class="chat-msg-stamp">Terkirim ✓</span>
        </div>
      `;
      msgStream.appendChild(agentReplyDiv);
      msgStream.scrollTop = msgStream.scrollHeight;
    }

    function escapeHtml(str) {
      const p = document.createElement('p');
      p.textContent = str;
      return p.innerHTML;
    }

    // Quick Topics Click
    topicButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-msg') || '';
        appendUserMessage(text);
        const suggestionsBox = document.getElementById('chat-suggestions-box');
        if (suggestionsBox) suggestionsBox.style.display = 'none';
      });
    });

    // Form Submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;

        appendUserMessage(text);
        input.value = '';

        const suggestionsBox = document.getElementById('chat-suggestions-box');
        if (suggestionsBox) suggestionsBox.style.display = 'none';
      });
    }
  });
</script>
