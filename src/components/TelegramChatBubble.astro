---
// TelegramChatBubble.astro - Floating Telegram Chat Widget for PT CHAIN ASIA CONECT
---

<div class="tg-bubble-container" id="tg-bubble-root">
  <!-- Chat Popup Window -->
  <div class="tg-chat-window" id="tg-chat-window" aria-hidden="true">
    <!-- Header -->
    <div class="tg-header">
      <div class="tg-header-info">
        <div class="tg-avatar-wrap">
          <div class="tg-avatar">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span class="tg-status-dot"></span>
          </div>
        </div>
        <div class="tg-title-col">
          <h4 class="tg-title">Chain Asia Conect Support</h4>
          <span class="tg-subtitle">Online • Fast Response Telegram</span>
        </div>
      </div>
      <button class="tg-close-btn" id="tg-close-btn" aria-label="Tutup Chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Body / Chat Messages Area -->
    <div class="tg-body">
      <div class="tg-message-incoming">
        <div class="tg-msg-bubble">
          <p>👋 <strong>Halo! Selamat datang di PT CHAIN ASIA CONECT.</strong></p>
          <p>Ada yang bisa kami bantu mengenai rantai pasok (supply chain), kemitraan bisnis, atau informasi perusahaan kami?</p>
          <span class="tg-msg-time">Official Corporate Bot</span>
        </div>
      </div>

      <!-- Quick Action Topics -->
      <div class="tg-quick-actions">
        <span class="tg-quick-label">Pilih Topik Cepat:</span>
        <div class="tg-pills-wrap">
          <button type="button" class="tg-pill" data-text="Halo, saya tertarik kerja sama Rantai Pasok (Supply Chain) di Krui / Lampung.">
            📦 Kemitraan Pasok
          </button>
          <button type="button" class="tg-pill" data-text="Halo, saya ingin mengetahui proposal investasi / Investor Relations.">
            📈 Investor Relations
          </button>
          <button type="button" class="tg-pill" data-text="Halo, saya ingin konsultasi layanan & legalitas PT CHAIN ASIA CONECT.">
            💼 Informasi Umum
          </button>
        </div>
      </div>
    </div>

    <!-- Footer Action Form -->
    <div class="tg-footer">
      <form id="tg-chat-form" class="tg-form">
        <div class="tg-input-group">
          <input 
            type="text" 
            id="tg-msg-input" 
            class="tg-input" 
            placeholder="Tulis pesan Anda..." 
            autocomplete="off"
            required 
          />
          <button type="submit" class="tg-send-btn" title="Kirim ke Telegram">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
          </button>
        </div>
      </form>

      <a 
        href="https://t.me/bubblechainasia_bot" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="tg-direct-link"
        id="tg-open-app-btn"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
        </svg>
        <span>Buka Langsung di Telegram (@bubblechainasia_bot)</span>
      </a>
    </div>
  </div>

  <!-- Trigger Floating Button -->
  <button class="tg-trigger-btn" id="tg-trigger-btn" aria-label="Buka Chat Telegram PT CHAIN ASIA CONECT">
    <div class="tg-trigger-glow"></div>
    <div class="tg-trigger-icon-chat">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
      </svg>
    </div>
    <span class="tg-badge">1</span>
  </button>
</div>

<style>
  .tg-bubble-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  /* Trigger Floating Button */
  .tg-trigger-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #229ED9 0%, #0088cc 100%);
    border: 2px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 136, 204, 0.45), 0 4px 12px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    position: relative;
    outline: none;
  }

  .tg-trigger-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 136, 204, 0.6), 0 6px 16px rgba(0, 0, 0, 0.4);
  }

  .tg-trigger-btn:active {
    transform: scale(0.96);
  }

  .tg-trigger-glow {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(34, 158, 217, 0.8) 0%, transparent 70%);
    opacity: 0.6;
    animation: tgPulse 2.5s infinite;
    pointer-events: none;
  }

  @keyframes tgPulse {
    0% { transform: scale(0.95); opacity: 0.7; }
    50% { transform: scale(1.25); opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  .tg-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 20px;
    height: 20px;
    background: #e11d48;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #0f172a;
  }

  /* Chat Window */
  .tg-chat-window {
    position: absolute;
    bottom: 76px;
    right: 0;
    width: 360px;
    max-width: calc(100vw - 32px);
    height: 480px;
    max-height: calc(100vh - 120px);
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
    backdrop-filter: blur(12px);
  }

  .tg-chat-window.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Header */
  .tg-header {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tg-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tg-avatar-wrap {
    position: relative;
  }

  .tg-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #0088cc;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 136, 204, 0.4);
  }

  .tg-status-dot {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 11px;
    height: 11px;
    background: #10b981;
    border: 2px solid #1e293b;
    border-radius: 50%;
  }

  .tg-title-col {
    display: flex;
    flex-direction: column;
  }

  .tg-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #f8fafc;
    letter-spacing: -0.2px;
  }

  .tg-subtitle {
    font-size: 11px;
    color: #10b981;
    font-weight: 500;
  }

  .tg-close-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 6px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
  }

  .tg-close-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Body */
  .tg-body {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #090e17;
  }

  .tg-message-incoming {
    display: flex;
    flex-direction: column;
  }

  .tg-msg-bubble {
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px 14px 14px 2px;
    padding: 12px 14px;
    color: #e2e8f0;
    font-size: 13px;
    line-height: 1.5;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .tg-msg-bubble p {
    margin: 0 0 8px 0;
  }

  .tg-msg-bubble p:last-of-type {
    margin-bottom: 6px;
  }

  .tg-msg-time {
    display: block;
    font-size: 10px;
    color: #64748b;
    text-align: right;
  }

  /* Quick Actions */
  .tg-quick-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .tg-quick-label {
    font-size: 11px;
    color: #94a3b8;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .tg-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tg-pill {
    background: rgba(0, 136, 204, 0.12);
    border: 1px solid rgba(0, 136, 204, 0.35);
    color: #38bdf8;
    font-size: 12px;
    padding: 6px 11px;
    border-radius: 20px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .tg-pill:hover {
    background: #0088cc;
    color: #ffffff;
    border-color: #0088cc;
    transform: translateY(-1px);
  }

  /* Footer & Form */
  .tg-footer {
    background: #0f172a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tg-form {
    width: 100%;
    margin: 0;
  }

  .tg-input-group {
    display: flex;
    align-items: center;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 4px 6px 4px 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .tg-input-group:focus-within {
    border-color: #0088cc;
    box-shadow: 0 0 0 2px rgba(0, 136, 204, 0.25);
  }

  .tg-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #f8fafc;
    font-size: 13px;
    outline: none;
  }

  .tg-input::placeholder {
    color: #64748b;
  }

  .tg-send-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #0088cc;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    padding: 0;
  }

  .tg-send-btn:hover {
    background: #0099e6;
    transform: scale(1.05);
  }

  .tg-direct-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    font-size: 11px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .tg-direct-link:hover {
    background: rgba(0, 136, 204, 0.15);
    color: #38bdf8;
    border-color: rgba(0, 136, 204, 0.4);
  }

  /* Responsive styling for small mobile */
  @media (max-width: 480px) {
    .tg-bubble-container {
      bottom: 18px;
      right: 18px;
    }
    .tg-chat-window {
      width: calc(100vw - 36px);
      height: 440px;
      bottom: 70px;
    }
    .tg-trigger-btn {
      width: 54px;
      height: 54px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const triggerBtn = document.getElementById('tg-trigger-btn');
    const closeBtn = document.getElementById('tg-close-btn');
    const chatWindow = document.getElementById('tg-chat-window');
    const form = document.getElementById('tg-chat-form');
    const input = document.getElementById('tg-msg-input');
    const pillButtons = document.querySelectorAll('.tg-pill');

    const botUsername = 'bubblechainasia_bot';

    function openChat() {
      if (chatWindow) {
        chatWindow.classList.add('active');
        chatWindow.setAttribute('aria-hidden', 'false');
        if (input) input.focus();
      }
    }

    function closeChat() {
      if (chatWindow) {
        chatWindow.classList.remove('active');
        chatWindow.setAttribute('aria-hidden', 'true');
      }
    }

    if (triggerBtn) {
      triggerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (chatWindow.classList.contains('active')) {
          closeChat();
        } else {
          openChat();
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeChat();
      });
    }

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const root = document.getElementById('tg-bubble-root');
      if (root && !root.contains(e.target)) {
        closeChat();
      }
    });

    // Quick Action Pills
    pillButtons.forEach(pill => {
      pill.addEventListener('click', () => {
        const text = pill.getAttribute('data-text') || '';
        const encodedText = encodeURIComponent(text);
        window.open(`https://t.me/${botUsername}?start=${encodedText}`, '_blank');
      });
    });

    // Handle Form Submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const msg = input.value.trim();
        if (!msg) return;

        // Redirect to Telegram with the message preset
        const encoded = encodeURIComponent(msg);
        window.open(`https://t.me/${botUsername}?start=${encoded}`, '_blank');
        input.value = '';
        closeChat();
      });
    }
  });
</script>
