---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import TelegramChatBubble from '../components/TelegramChatBubble.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: string;
  articleMeta?: {
    publishedTime?: string;
    author?: string;
    section?: string;
  };
  extraSchema?: Record<string, any>;
}

const {
  title = "PT CHAIN ASIA CONECT | Official Corporate Portal",
  description = "PT CHAIN ASIA CONECT - Officially registered legal entity (SK Kemenkumham AHU-A117353.AH.01.30, NIB 0709260109599, KBLI 62193, NPWP 10.000.000.1-094.6336). President Director: Ilham Pradani, S.H. (Cand.). Enterprise Supply Chain, Medical Engineering Machine & Diagnostic Software Systems Licensing across Indonesia & Asia Region.",
  canonical = "https://www.chainasiaconnect.co.id/",
  image = "https://www.chainasiaconnect.co.id/images/CAC-LOGO.jpg",
  ogType = "website",
  articleMeta,
  extraSchema
} = Astro.props;

// JSON-LD Structured Data Schema for Google indexing
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.chainasiaconnect.co.id/#organization",
      "name": "PT CHAIN ASIA CONECT",
      "legalName": "PT CHAIN ASIA CONECT",
      "url": "https://www.chainasiaconnect.co.id/",
      "logo": "https://www.chainasiaconnect.co.id/images/CAC-LOGO.jpg",
      "description": description,
      "foundingDate": "2026-09-01",
      "taxID": "10.000.000.1-094.6336",
      "identifier": "NIB: 0709260109599",
      "sameAs": [
        "https://ilhampradani.me"
      ],
      "founder": {
        "@type": "Person",
        "name": "Ilham Pradani, S.H. (Cand.)",
        "jobTitle": "President Director & Founder",
        "url": "https://ilhampradani.me"
      },
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "ID",
        "addressRegion": "Indonesia & Asia Region"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": "ilhampradani-sh@chainasiaconnect.co.id",
          "contactType": "president director desk",
          "availableLanguage": ["English", "Indonesian"]
        },
        {
          "@type": "ContactPoint",
          "email": "putriwulandari-st@chainasiaconnect.co.id",
          "contactType": "vice president director desk",
          "availableLanguage": ["English", "Indonesian"]
        },
        {
          "@type": "ContactPoint",
          "email": "info@chainasiaconnect.co.id",
          "contactType": "customer service",
          "availableLanguage": ["English", "Indonesian"]
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.chainasiaconnect.co.id/#website",
      "url": "https://www.chainasiaconnect.co.id/",
      "name": "PT CHAIN ASIA CONECT",
      "publisher": {
        "@id": "https://www.chainasiaconnect.co.id/#organization"
      },
      "inLanguage": "en-US"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- AI Search Engines (SearchGPT, Perplexity, Gemini, Claude Context Document) -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI Machine Readable Context" />

    <!-- Google Search & Browser Circular Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#dc2626" />

    <!-- Google Directives & Indexing Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="keywords" content="PT CHAIN ASIA CONECT, Ilham Pradani, Medical Engineering Machine, Diagnostic Software Licensing, DICOM PACS Licensing, Supply Chain Indonesia, Real Business Ecosystem Asia, NIB 0709260109599, SK Kemenkumham AHU-A117353, chainasiaconnect.co.id" />
    <meta name="author" content="Ilham Pradani, S.H. (Cand.) - PT CHAIN ASIA CONECT" />
    <meta name="publisher" content="PT CHAIN ASIA CONECT" />
    <meta name="copyright" content="PT CHAIN ASIA CONECT" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="PT CHAIN ASIA CONECT" />
    <meta property="og:locale" content="id_ID" />
    {articleMeta?.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {articleMeta?.author && (
      <meta property="article:author" content={articleMeta.author} />
    )}
    {articleMeta?.section && (
      <meta property="article:section" content={articleMeta.section} />
    )}

    <!-- Twitter Cards (Generative AI & Social Rich Cards) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Schema.org Structured Data for Google Rich Results & AI Search Engine Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(extraSchema || schemaData)} />
  </head>
  <body>
    <slot />
    <TelegramChatBubble />
    <script is:inline src="/js/i18n.js"></script>
    <script>
      import Lenis from 'lenis';

      function initLenis() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        const lenis = new Lenis({
          duration: 1.3, // Silky slow-motion inertia scroll
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 0.9,
          touchMultiplier: 1.4,
        });

        // Expose globally so components can hook into lenis scroll events
        (window as any).lenis = lenis;

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLenis);
      } else {
        initLenis();
      }
    </script>
    <script is:inline>
      function initScrollReveal() {
        const revealElements = document.querySelectorAll('.reveal-on-scroll, section > .container');
        if (!('IntersectionObserver' in window)) {
          revealElements.forEach(el => el.classList.add('is-revealed'));
          return;
        }
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -30px 0px'
        });
        revealElements.forEach(el => {
          if (!el.classList.contains('reveal-on-scroll')) {
            el.classList.add('reveal-on-scroll');
          }
          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>

