---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Business & Services | PT CHAIN ASIA CONECT" description="Explore business divisions, Medical Engineering Machine systems, PACS diagnostic software licensing, and enterprise supply chain ecosystem services by PT CHAIN ASIA CONECT.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">PRODUCTS, SERVICES & BUSINESS LINES</span>
        <h1 class="page-hero-title">Business <span class="red-text">& Services</span></h1>
        <p class="page-hero-desc">
          Delivering enterprise supply chain networks, advanced medical engineering machine infrastructure, and PACS diagnostic software systems licensing across Indonesia & Asia Region.
        </p>
      </div>
    </section>

    <!-- Services Component -->
    <ServicesSection />

    <!-- Strategic Market Research & Feasibility for New Branch Expansion (Fullwidth Editorial Design, No Cards) -->
    <section class="fullwidth-section branch-research-section" id="market-research">
      <div class="container">
        
        <!-- Section Header -->
        <div class="research-header">
          <div class="status-badge-row">
            <span class="status-live-pill" data-i18n="research_badge">ACTIVE STAGE • MARKET RESEARCH & FEASIBILITY STUDY</span>
            <span class="status-tag-text red-text" data-i18n="research_tag">STRATEGIC EXPANSION INITIATIVE</span>
          </div>

          <h2 class="research-title" data-i18n="research_title">
            Strategic Market Research & Feasibility Study <br /><span class="red-text">For Regional Branch Expansion</span>
          </h2>
          
          <p class="research-subtitle" data-i18n="research_desc">
            As a principal enterprise in active business expansion and diversification, PT CHAIN ASIA CONECT is conducting comprehensive market demand analyses, regional economic feasibility assessments, and regulatory due diligence for the establishment of new operating branches and subsidiary units across strategic industrial hubs.
          </p>
        </div>

        <!-- Fullwidth Section 1: Expansion & Feasibility Phases (Subheadings & Linear Flow) -->
        <div class="fullwidth-block roadmap-editorial-block">
          <div class="block-header">
            <span class="block-kicker red-text" data-i18n="roadmap_tag">STRUCTURED ROADMAP</span>
            <h3 class="block-title" data-i18n="roadmap_title">Branch Expansion & Feasibility Phases</h3>
          </div>

          <div class="phases-linear-list">
            
            <!-- Step 1 -->
            <div class="phase-row-item">
              <div class="phase-meta">
                <span class="phase-num red-text">01</span>
                <span class="phase-state-tag green-badge" data-i18n="step1_status">✓ Completed Assessment</span>
              </div>
              <div class="phase-body">
                <h4 class="phase-heading" data-i18n="step1_title">Market Demand Mapping</h4>
                <p class="phase-desc" data-i18n="step1_desc">Identification of high-demand industrial supply chains and precision medical equipment requirements across major economic growth centers.</p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="phase-row-item active-phase">
              <div class="phase-meta">
                <span class="phase-num red-text">02</span>
                <span class="phase-state-tag red-badge" data-i18n="step2_status">● In Progress</span>
              </div>
              <div class="phase-body">
                <h4 class="phase-heading" data-i18n="step2_title">Regulatory & Legal Feasibility</h4>
                <p class="phase-desc" data-i18n="step2_desc">Thorough evaluation of regional regulatory compliance, OSS BKPM licensing standardization, and unit capital expenditure feasibility.</p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="phase-row-item active-phase">
              <div class="phase-meta">
                <span class="phase-num red-text">03</span>
                <span class="phase-state-tag red-badge" data-i18n="step3_status">● In Progress</span>
              </div>
              <div class="phase-body">
                <h4 class="phase-heading" data-i18n="step3_title">Strategic Partner Outreach</h4>
                <p class="phase-desc" data-i18n="step3_desc">Active preliminary discussions with localized distribution networks, healthcare facilities, and regional stakeholders.</p>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="phase-row-item">
              <div class="phase-meta">
                <span class="phase-num red-text">04</span>
                <span class="phase-state-tag slate-badge" data-i18n="step4_status">⏳ Target 2027</span>
              </div>
              <div class="phase-body">
                <h4 class="phase-heading" data-i18n="step4_title">Site Selection & Branch Launch</h4>
                <p class="phase-desc" data-i18n="step4_desc">Finalization of branch corporate governance structure, physical facility deployment, and official operational commissioning.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Fullwidth Section 2: 3 Core Pillars of Branch Feasibility (Subheadings & Editorial Columns) -->
        <div class="fullwidth-block pillars-editorial-block">
          <div class="block-header">
            <span class="block-kicker red-text">FEASIBILITY DOMAINS</span>
            <h3 class="block-title">3 Core Pillars of Branch Expansion</h3>
          </div>

          <div class="pillars-editorial-grid">
            
            <div class="pillar-column-item">
              <div class="pillar-icon-line">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                <span class="pillar-seq red-text">01</span>
              </div>
              <h4 class="pillar-subhead" data-i18n="pillar_res1_title">Integrated Supply Chain Logistics</h4>
              <p class="pillar-narrative" data-i18n="pillar_res1_desc">Research focuses on streamlining localized distribution corridors, high-standard warehousing management, and dependable B2B fulfillment across expanding regions.</p>
            </div>

            <div class="pillar-column-item">
              <div class="pillar-icon-line">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                <span class="pillar-seq red-text">02</span>
              </div>
              <h4 class="pillar-subhead" data-i18n="pillar_res2_title">3D PACS & Medical Engineering</h4>
              <p class="pillar-narrative" data-i18n="pillar_res2_desc">Evaluating regional healthcare and diagnostic center readiness for the deployment of 3D cloud-native diagnostic imaging software and precision maintenance services.</p>
            </div>

            <div class="pillar-column-item">
              <div class="pillar-icon-line">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span class="pillar-seq red-text">03</span>
              </div>
              <h4 class="pillar-subhead" data-i18n="pillar_res3_title">Regional Economic Synergy & ESG</h4>
              <p class="pillar-narrative" data-i18n="pillar_res3_desc">Aligning branch operations with strict governance standards, local talent empowerment, and continuous contribution to the 10% Mitra Langit Tabarru' fund.</p>
            </div>

          </div>
        </div>

        <!-- Fullwidth Section 3: Callout / Inquiry Band with Neumorphic Action Buttons -->
        <div class="fullwidth-expansion-cta">
          <div class="cta-text-side">
            <span class="block-kicker red-text" data-i18n="callout_tag">REGIONAL EXPANSION INQUIRY</span>
            <h3 class="cta-subheading" data-i18n="callout_title">Interested in Regional Branch Collaboration or Co-Development?</h3>
            <p class="cta-desc" data-i18n="callout_desc">
              We welcome formal dialogue with facility owners, industrial partners, and regional stakeholders who wish to collaborate with PT CHAIN ASIA CONECT during this strategic market research and expansion phase.
            </p>
          </div>

          <div class="cta-actions-side">
            <a href="mailto:sales@chainasiaconect.company" class="btn-more-red">
              <span data-i18n="callout_btn">Inquire Expansion Partnership →</span>
            </a>
            <a href="mailto:info@chainasiaconect.company" class="btn-secondary-clean">
              <span>info@chainasiaconect.company</span>
            </a>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Fullwidth Editorial Branch Research Section */
  .branch-research-section {
    background: #ffffff;
    padding: 4.5rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .research-header {
    max-width: 860px;
    margin-bottom: 3.5rem;
  }

  .status-badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .status-live-pill {
    display: inline-flex;
    align-items: center;
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fee2e2;
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .status-tag-text {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .research-title {
    font-size: clamp(2rem, 4vw, 2.7rem);
    color: var(--text-dark);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }

  .research-subtitle {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-body);
  }

  /* Fullwidth Blocks (No Enclosing Cards) */
  .fullwidth-block {
    margin-bottom: 3.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-light);
  }

  .block-header {
    margin-bottom: 2rem;
  }

  .block-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .block-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0;
  }

  /* Linear Roadmap Phases (No Cards, Clean Linear Rows) */
  .phases-linear-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .phase-row-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border-light);
    align-items: flex-start;
  }

  .phase-row-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .phase-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .phase-num {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
  }

  .phase-state-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-block;
    width: fit-content;
  }

  .green-badge {
    background: #f0fdf4;
    color: #16a34a;
    border: 1px solid #dcfce7;
  }

  .red-badge {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fee2e2;
  }

  .slate-badge {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #e2e8f0;
  }

  .phase-heading {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.4rem;
  }

  .phase-desc {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.7;
    margin: 0;
  }

  /* 3 Pillars Editorial Grid (Clean Columns, No Card Boxes) */
  .pillars-editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .pillar-column-item {
    display: flex;
    flex-direction: column;
  }

  .pillar-icon-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .pillar-seq {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .pillar-subhead {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  .pillar-narrative {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-body);
    margin: 0;
  }

  /* Fullwidth Callout Band */
  .fullwidth-expansion-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 3rem 0 0 0;
  }

  .cta-text-side {
    max-width: 720px;
  }

  .cta-subheading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .cta-desc {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-body);
    margin: 0;
  }

  .cta-actions-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 992px) {
    .phase-row-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .pillars-editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .fullwidth-expansion-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    .cta-actions-side {
      width: 100%;
    }
    .cta-actions-side .btn-more-red,
    .cta-actions-side .btn-secondary-clean {
      width: 100%;
      text-align: center;
    }
  }
</style>
