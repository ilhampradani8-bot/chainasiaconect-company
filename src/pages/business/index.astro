---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Business & Services | PT CHAIN ASIA CONECT" description="Explore business divisions, Medical Engineering Machine systems, PACS diagnostic software licensing, and enterprise supply chain ecosystem services by PT CHAIN ASIA CONECT.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">PRODUCTS, SERVICES & BUSINESS LINES</span>
        <h1 class="page-hero-title">Business <span class="red-text">& Services</span></h1>
        <p class="page-hero-desc">
          Delivering enterprise supply chain networks, advanced medical engineering machine infrastructure, and PACS diagnostic software systems licensing across Indonesia & Asia Region.
        </p>
      </div>
    </section>

    <!-- Services Component -->
    <ServicesSection />
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 4rem 0 3rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }
</style>
