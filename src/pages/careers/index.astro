---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Careers & Executive Search | PT CHAIN ASIA CONECT" description="Career opportunities and active Executive Board Financial Director search at PT CHAIN ASIA CONECT. Join our physical enterprise and supply chain leadership.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">TALENT ACQUISITION & EXECUTIVE RECRUITMENT</span>
        <h1 class="page-hero-title">Careers <span class="red-text">& Board Structuring</span></h1>
        <p class="page-hero-desc">
          Build the future of physical business ecosystems and regional supply chain networks with PT CHAIN ASIA CONECT.
        </p>
      </div>
    </section>

    <!-- Active Openings -->
    <section class="fullwidth-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-tag red-text">EXECUTIVE OPPORTUNITIES</span>
          <h2>Active Recruitment & Executive Positions</h2>

          <div class="careers-stack">
            <!-- Financial Director Position Card -->
            <div class="career-card featured-border">
              <div class="career-header">
                <span class="c-badge red-bg">EXECUTIVE BOARD SEARCH</span>
                <span class="c-type">Full-Time Executive</span>
              </div>
              <h3>Financial Director (Direktur Keuangan)</h3>
              <p class="c-desc">
                We are actively structuring our Executive Board and seeking a strategic Financial Director to lead financial governance, capital allocation, institutional advisory, and regulatory compliance for our physical business ecosystem expansion.
              </p>
              <div class="c-reqs">
                <strong>Key Qualifications:</strong>
                <ul>
                  <li>Extensive senior financial executive experience in corporate governance or corporate scaling.</li>
                  <li>Deep expertise in capital structuring, risk audit, and financial accounting standards.</li>
                  <li>Legal and ethical integrity aligned with corporate standards.</li>
                </ul>
              </div>
              <div class="c-apply">
                <span>Executive Inquiry Email:</span>
                <a href="mailto:sales@chainasiaconect.company" class="apply-btn red-text">sales@chainasiaconect.company</a>
              </div>
            </div>

            <!-- Medical Systems Engineer -->
            <div class="career-card">
              <div class="career-header">
                <span class="c-badge">TECHNICAL DIVISION</span>
                <span class="c-type">Full-Time</span>
              </div>
              <h3>Medical Diagnostic Software Systems Specialist</h3>
              <p class="c-desc">
                Responsible for managing integration protocols of DICOM PACS diagnostic cloud software licensing systems with regional healthcare facility partners.
              </p>
              <div class="c-apply">
                <span>Submit CV & Portfolio:</span>
                <a href="mailto:info@chainasiaconect.company" class="apply-btn red-text">info@chainasiaconect.company</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 4rem 0 3rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .section-intro h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.35rem 0 2rem 0;
    color: var(--text-dark);
  }

  .careers-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .career-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 2rem;
  }

  .career-card.featured-border {
    border-left: 4px solid var(--red-primary);
  }

  .career-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .c-badge {
    font-size: 0.725rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    background: #f1f5f9;
    color: var(--text-dark);
  }

  .c-badge.red-bg {
    background: var(--red-primary);
    color: #ffffff;
  }

  .c-type {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .career-card h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .c-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1rem;
  }

  .c-reqs {
    margin: 1rem 0;
    font-size: 0.95rem;
    color: var(--text-body);
  }

  .c-reqs ul {
    margin-left: 1.25rem;
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .c-apply {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .apply-btn {
    font-size: 1.05rem;
    text-decoration: none;
  }
</style>
