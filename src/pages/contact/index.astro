---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Contact Us | PT CHAIN ASIA CONECT" description="Official contact details for PT CHAIN ASIA CONECT headquarters, Corporate Secretary liaison, Investor Relations inquiry, and B2B partnerships.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">OFFICIAL CORPORATE CONTACT & HEADQUARTERS</span>
        <h1 class="page-hero-title">Contact <span class="red-text">PT CHAIN ASIA CONECT</span></h1>
        <p class="page-hero-desc">
          Reach out to our executive management, Corporate Secretary, Investor Relations desk, or business partnership team.
        </p>
      </div>
    </section>

    <!-- Main Contact Grid -->
    <section class="fullwidth-section">
      <div class="container">
        <div class="contact-grid">
          <!-- Left Column: Official Email Directories -->
          <div class="contact-info-col">
            <span class="section-tag red-text">DIRECT COMMUNICATION CHANNELS</span>
            <h2>Official Executive & Department Email Directory</h2>
            <p class="contact-intro">
              In accordance with corporate governance standards, all inquiries are routed to designated executive departments.
            </p>

            <div class="email-directory-stack">
              <div class="dir-item">
                <span class="dir-role">General Corporate & B2B Inquiries</span>
                <a href="mailto:info@chainasiaconnect.co.id" class="dir-email red-text">info@chainasiaconnect.co.id</a>
                <span class="dir-desc">For general enterprise partnerships, physical supply chain projects, and public information.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">Commercial & Software Licensing Sales</span>
                <a href="mailto:sales@chainasiaconnect.co.id" class="dir-email red-text">sales@chainasiaconnect.co.id</a>
                <span class="dir-desc">For medical machine engineering sales and DICOM PACS diagnostic cloud software licensing.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">Corporate Secretary & Regulatory Compliance (CorSec)</span>
                <a href="mailto:corsec@chainasiaconnect.co.id" class="dir-email red-text">corsec@chainasiaconnect.co.id</a>
                <span class="dir-desc">For regulatory compliance, shareholder relations, and legal regulatory matters.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">President Director Executive Desk</span>
                <a href="mailto:ilhampradani-sh@chainasiaconnect.co.id" class="dir-email red-text">ilhampradani-sh@chainasiaconnect.co.id</a>
                <span class="dir-desc">Direct communications with President Director & Founder <strong>Ilham Pradani, S.H. (Cand.)</strong>.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">Vice President Director Executive Desk</span>
                <a href="mailto:putriwulandari-st@chainasiaconnect.co.id" class="dir-email red-text">putriwulandari-st@chainasiaconnect.co.id</a>
                <span class="dir-desc">Direct communications with Vice President Director <strong>Putri Wulandari, S.T.</strong></span>
              </div>
            </div>
          </div>

          <!-- Right Column: Corporate Headquarters Details -->
          <div class="contact-hq-col">
            <div class="hq-box">
              <span class="hq-tag red-text">REGISTERED HEADQUARTERS</span>
              <h3>PT CHAIN ASIA CONECT Headquarters</h3>
              <p class="hq-address">
                Registered Individual Limited Liability Company (PT Perorangan)<br />
                <strong>SK Kemenkumham RI:</strong> AHU-A117353.AH.01.30.Year 2026<br />
                <span class="legal-id-row"><span><strong>NIB:</strong> 0709260109599</span> <span class="id-sep">•</span> <span><strong>NPWP:</strong> 10.000.000.1-094.6336</span></span><br />
                Operating across Indonesia & Asia Region.
              </p>

              <div class="banking-relation">
                <strong>Corporate Banking Relationship:</strong>
                <div class="bank-logo-row">
                  <img src="/images/logo-ocbc.png" alt="OCBC Bank Logo" class="ocbc-logo-img" />
                </div>
              </div>

              <!-- Interactive Inquiry Form -->
              <div class="inquiry-form-wrapper">
                <h4>Send an Executive Inquiry</h4>
                <form class="inquiry-form" onsubmit="event.preventDefault(); alert('Thank you! Your corporate inquiry has been transmitted to our Corporate Secretary.');">
                  <div class="form-group">
                    <label for="c-name">Full Name / Entity Representative</label>
                    <input type="text" id="c-name" required placeholder="e.g. John Doe, Director" class="form-input" />
                  </div>
                  <div class="form-group">
                    <label for="c-email">Corporate Email Address</label>
                    <input type="email" id="c-email" required placeholder="name@company.com" class="form-input" />
                  </div>
                  <div class="form-group">
                    <label for="c-dept">Inquiry Department</label>
                    <select id="c-dept" class="form-input">
                      <option value="investor">Investor Relations & IPO Roadmap Inquiry</option>
                      <option value="sales">Medical Engineering & Software Licensing</option>
                      <option value="corsec">Corporate Secretary & Legal Compliance</option>
                      <option value="general">General Corporate Inquiry</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="c-msg">Message Content</label>
                    <textarea id="c-msg" rows="4" required placeholder="Specify your proposal or inquiry details..." class="form-input"></textarea>
                  </div>
                  <button type="submit" class="btn-red submit-inquiry-btn">Submit Corporate Inquiry</button>
                </form>
              </div>
            </div>
          </div>
    <!-- Regional Operational Hub & Maps Section (Krui, Pesisir Barat) -->
    <section class="fullwidth-section contact-map-section">
      <div class="container">
        <div class="section-map-header">
          <h2>Peta Wilayah Operasional Jaringan</h2>
          <p>Hub logistik, perizinan berusaha, dan infrastruktur komputasi regional PT CHAIN ASIA CONECT di Pesisir Barat, Lampung.</p>
        </div>

        <div class="contact-map-fullwidth-card">
          <div class="map-sharp-header">
            <div class="map-header-status">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--red-primary)" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <strong class="map-title-txt">Peta Wilayah Operasional: Krui, Pesisir Barat, Lampung</strong>
            </div>
            <a href="https://maps.google.com/maps?q=Krui,%20Pesisir%20Barat,%20Lampung,%20Indonesia" target="_blank" rel="noopener noreferrer" class="map-open-external red-text">
              Buka di Google Maps ↗
            </a>
          </div>

          <div class="map-iframe-wrapper">
            <iframe
              src="https://maps.google.com/maps?q=Krui,%20Pesisir%20Barat,%20Lampung,%20Indonesia&t=&z=13&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="450"
              style="border:0; display:block;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Lokasi Kantor Krui, Pesisir Barat, Lampung - PT CHAIN ASIA CONECT"
              class="krui-map-iframe"
            ></iframe>
          </div>

          <div class="map-sharp-footer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#64748b" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="map-footer-text">
              <strong>Hub Regional Operasional:</strong> Krui, Pesisir Barat, Lampung — Koridor Jaringan Rantai Pasok & Lisensi Perangkat Lunak.
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    padding: 2rem 0;
  }

  .contact-info-col h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.5rem 0;
  }

  .contact-intro {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .email-directory-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dir-item {
    background: #ffffff;
    border: 1px solid var(--border-light);
    padding: 1.5rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
  }

  .dir-role {
    font-size: 0.775rem;
    font-weight: 800;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dir-email {
    font-size: clamp(0.95rem, 4vw, 1.2rem);
    font-weight: 800;
    margin: 0.25rem 0 0.35rem 0;
    text-decoration: none;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
    display: inline-block;
    max-width: 100%;
  }

  .dir-desc {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.5;
  }

  .hq-box {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 2rem;
  }

  .hq-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .hq-box h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.75rem 0;
  }

  .hq-address {
    font-size: 0.925rem;
    line-height: 1.65;
    color: var(--text-body);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .banking-relation {
    margin: 1.25rem 0;
    font-size: 0.85rem;
    color: var(--text-dark);
  }

  .bank-logo-row {
    margin-top: 0.5rem;
  }

  .ocbc-logo-img {
    height: 40px;
    width: auto;
  }

  .inquiry-form-wrapper {
    margin-top: 1.5rem;
    background: #ffffff;
    padding: 1.5rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
  }

  .inquiry-form-wrapper h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .legal-id-row {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .form-input {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    font-size: 0.9rem;
    outline: none;
    font-family: inherit;
  }

  .form-input:focus {
    border-color: var(--red-primary);
  }

  .submit-inquiry-btn {
    width: 100%;
    padding: 0.75rem;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-hero-banner {
      padding: 6.5rem 0 2rem 0;
    }
    .hero-tag {
      font-size: clamp(0.7rem, 2.8vw, 0.8rem);
      overflow-wrap: anywhere;
    }
    .page-hero-title {
      font-size: clamp(1.65rem, 5vw, 2.5rem);
    }
    .page-hero-desc {
      font-size: clamp(0.9rem, 3.5vw, 1.05rem);
    }
    .contact-grid {
      padding: 1rem 0;
      gap: 1.75rem;
    }
    .contact-info-col h2 {
      font-size: clamp(1.3rem, 4vw, 1.75rem);
    }
    .email-directory-stack {
      gap: 1rem;
    }
    .dir-item {
      padding: 1rem;
    }
    .dir-role {
      font-size: clamp(0.7rem, 2.6vw, 0.775rem);
      overflow-wrap: anywhere;
    }
    .dir-desc {
      font-size: clamp(0.8rem, 3vw, 0.875rem);
    }
    .hq-box {
      padding: 1.25rem 1rem;
    }
    .hq-box h3 {
      font-size: clamp(1.15rem, 3.8vw, 1.4rem);
    }
    .hq-address {
      font-size: clamp(0.825rem, 3vw, 0.925rem);
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .inquiry-form-wrapper {
      padding: 1.25rem 1rem;
    }
    .form-input {
      font-size: clamp(0.825rem, 3vw, 0.9rem);
      padding: 0.55rem 0.75rem;
    }
    .id-sep {
      display: none;
    }
    .legal-id-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1rem;
    }
    .map-iframe-wrapper {
      min-height: 320px;
      height: 320px;
    }
  }

  /* Regional Operational Map Section */
  .contact-map-section {
    background: #f8fafc;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 3.5rem 0 4rem 0;
  }

  .section-map-header {
    margin-bottom: 1.5rem;
  }

  .section-map-header h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 0.4rem 0;
  }

  .section-map-header p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .contact-map-fullwidth-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 0 !important; /* Sharp corners */
    overflow: hidden;
    width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .map-sharp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--border-light);
    background: #ffffff;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .map-header-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .map-title-txt {
    font-size: 0.92rem;
    color: var(--text-dark);
    font-weight: 800;
  }

  .map-open-external {
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .map-open-external:hover {
    text-decoration: underline;
  }

  .map-iframe-wrapper {
    width: 100%;
    background: #e2e8f0;
    min-height: 420px;
    height: 420px;
    position: relative;
  }

  .krui-map-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .map-sharp-footer {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.5rem;
    background: #f8fafc;
    border-top: 1px solid var(--border-light);
  }

  .map-footer-text {
    font-size: 0.82rem;
    color: var(--text-body);
    line-height: 1.5;
  }
</style>
