---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Contact Us | PT CHAIN ASIA CONECT" description="Official contact details for PT CHAIN ASIA CONECT headquarters, Corporate Secretary liaison, Investor Relations inquiry, and B2B partnerships.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">OFFICIAL CORPORATE CONTACT & HEADQUARTERS</span>
        <h1 class="page-hero-title">Contact <span class="red-text">PT CHAIN ASIA CONECT</span></h1>
        <p class="page-hero-desc">
          Reach out to our executive management, Corporate Secretary, Investor Relations desk, or business partnership team.
        </p>
      </div>
    </section>

    <!-- Main Contact Grid -->
    <section class="fullwidth-section">
      <div class="container">
        <div class="contact-grid">
          <!-- Left Column: Official Email Directories -->
          <div class="contact-info-col">
            <span class="section-tag red-text">DIRECT COMMUNICATION CHANNELS</span>
            <h2>Official Executive & Department Email Directory</h2>
            <p class="contact-intro">
              In accordance with corporate governance standards, all inquiries are routed to designated executive departments.
            </p>

            <div class="email-directory-stack">
              <div class="dir-item">
                <span class="dir-role">General Corporate & B2B Inquiries</span>
                <a href="mailto:info@chainasiaconect.company" class="dir-email red-text">info@chainasiaconect.company</a>
                <span class="dir-desc">For general enterprise partnerships, physical supply chain projects, and public information.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">Commercial & Software Licensing Sales</span>
                <a href="mailto:sales@chainasiaconect.company" class="dir-email red-text">sales@chainasiaconect.company</a>
                <span class="dir-desc">For medical machine engineering sales and DICOM PACS diagnostic cloud software licensing.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">Corporate Secretary & Regulatory Compliance (CorSec)</span>
                <a href="mailto:corsec@chainasiaconect.company" class="dir-email red-text">corsec@chainasiaconect.company</a>
                <span class="dir-desc">For regulatory compliance, shareholder relations, and legal regulatory matters.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">President Director Executive Desk</span>
                <a href="mailto:ilhampradani@chainasiaconect.company" class="dir-email red-text">ilhampradani@chainasiaconect.company</a>
                <span class="dir-desc">Direct communications with President Director & Founder <strong>Ilham Pradani, S.H. (Cand.)</strong>.</span>
              </div>

              <div class="dir-item">
                <span class="dir-role">Financial Director Executive Desk</span>
                <a href="mailto:wulanputri@chainasiaconect.company" class="dir-email red-text">wulanputri@chainasiaconect.company</a>
                <span class="dir-desc">Direct communications with Financial Director <strong>Putri Wulan, S.T.</strong></span>
              </div>
            </div>
          </div>

          <!-- Right Column: Corporate Headquarters Details -->
          <div class="contact-hq-col">
            <div class="hq-box">
              <span class="hq-tag red-text">REGISTERED HEADQUARTERS</span>
              <h3>PT CHAIN ASIA CONECT Headquarters</h3>
              <p class="hq-address">
                Registered Individual Limited Liability Company (PT Perorangan)<br />
                <strong>SK Kemenkumham RI:</strong> AHU-A117353.AH.01.30.Year 2026<br />
                <strong>NIB:</strong> 0709260109599 | <strong>NPWP:</strong> 10.000.000.1-094.6336<br />
                Operating across Indonesia & Asia Region.
              </p>

              <div class="banking-relation">
                <strong>Corporate Banking Relationship:</strong>
                <div class="bank-logo-row">
                  <img src="/images/logo-ocbc.png" alt="OCBC Bank Logo" class="ocbc-logo-img" />
                </div>
              </div>

              <!-- Interactive Inquiry Form -->
              <div class="inquiry-form-wrapper">
                <h4>Send an Executive Inquiry</h4>
                <form class="inquiry-form" onsubmit="event.preventDefault(); alert('Thank you! Your corporate inquiry has been transmitted to our Corporate Secretary.');">
                  <div class="form-group">
                    <label for="c-name">Full Name / Entity Representative</label>
                    <input type="text" id="c-name" required placeholder="e.g. John Doe, Director" class="form-input" />
                  </div>
                  <div class="form-group">
                    <label for="c-email">Corporate Email Address</label>
                    <input type="email" id="c-email" required placeholder="name@company.com" class="form-input" />
                  </div>
                  <div class="form-group">
                    <label for="c-dept">Inquiry Department</label>
                    <select id="c-dept" class="form-input">
                      <option value="investor">Investor Relations & IPO Roadmap Inquiry</option>
                      <option value="sales">Medical Engineering & Software Licensing</option>
                      <option value="corsec">Corporate Secretary & Legal Compliance</option>
                      <option value="general">General Corporate Inquiry</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="c-msg">Message Content</label>
                    <textarea id="c-msg" rows="4" required placeholder="Specify your proposal or inquiry details..." class="form-input"></textarea>
                  </div>
                  <button type="submit" class="btn-red submit-inquiry-btn">Submit Corporate Inquiry</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 4rem 0 3rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    padding: 2rem 0;
  }

  .contact-info-col h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.5rem 0;
  }

  .contact-intro {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .email-directory-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dir-item {
    background: #ffffff;
    border: 1px solid var(--border-light);
    padding: 1.5rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
  }

  .dir-role {
    font-size: 0.775rem;
    font-weight: 800;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dir-email {
    font-size: clamp(0.95rem, 4vw, 1.2rem);
    font-weight: 800;
    margin: 0.25rem 0 0.35rem 0;
    text-decoration: none;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
    display: inline-block;
    max-width: 100%;
  }

  .dir-desc {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.5;
  }

  .hq-box {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 2rem;
  }

  .hq-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .hq-box h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.75rem 0;
  }

  .hq-address {
    font-size: 0.925rem;
    line-height: 1.65;
    color: var(--text-body);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .banking-relation {
    margin: 1.25rem 0;
    font-size: 0.85rem;
    color: var(--text-dark);
  }

  .bank-logo-row {
    margin-top: 0.5rem;
  }

  .ocbc-logo-img {
    height: 40px;
    width: auto;
  }

  .inquiry-form-wrapper {
    margin-top: 1.5rem;
    background: #ffffff;
    padding: 1.5rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
  }

  .inquiry-form-wrapper h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .form-input {
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    font-size: 0.9rem;
    outline: none;
    font-family: inherit;
  }

  .form-input:focus {
    border-color: var(--red-primary);
  }

  .submit-inquiry-btn {
    width: 100%;
    padding: 0.75rem;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
