---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Corporate Governance | PT CHAIN ASIA CONECT" description="Good Corporate Governance (GCG) guidelines, Board Charters, Audit Committee, Corporate Secretary contact, and Whistleblowing System (WBS) for PT CHAIN ASIA CONECT.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">GOOD CORPORATE GOVERNANCE (GCG)</span>
        <h1 class="page-hero-title">Corporate <span class="red-text">Governance</span></h1>
        <p class="page-hero-desc">
          Enforcing accountability, ethical business standards, risk management, and robust oversight structures across all operational divisions of PT CHAIN ASIA CONECT.
        </p>
      </div>
    </section>

    <!-- Governance Framework Pillars -->
    <section class="fullwidth-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-tag red-text">OUR GOVERNANCE PRINCIPLES</span>
          <h2>The 5 Pillars of Governance Compliance</h2>
          <div class="pillars-grid">
            <div class="pillar-card">
              <span class="pillar-num red-text">01</span>
              <h4>Transparency</h4>
              <p>Timely disclosure of clear, accurate, and accessible corporate information.</p>
            </div>
            <div class="pillar-card">
              <span class="pillar-num red-text">02</span>
              <h4>Accountability</h4>
              <p>Clarity of board duties, management responsibilities, and operational performance metrics.</p>
            </div>
            <div class="pillar-card">
              <span class="pillar-num red-text">03</span>
              <h4>Responsibility</h4>
              <p>Full compliance with Indonesian laws, Kemenkumham decrees, and environmental regulations.</p>
            </div>
            <div class="pillar-card">
              <span class="pillar-num red-text">04</span>
              <h4>Independence</h4>
              <p>Independent oversight free from conflicts of interest across decision-making levels.</p>
            </div>
            <div class="pillar-card">
              <span class="pillar-num red-text">05</span>
              <h4>Fairness</h4>
              <p>Equal protection and consideration for all business partners and stakeholders.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Board Charters (Piagam Dewan) -->
    <section class="fullwidth-section bg-light-clean" id="charters">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text">BOARD GUIDELINES & CHARTERS</span>
          <h2>Board Charters (Piagam Direksi & Komisaris)</h2>
          <p>Formal operational frameworks defining duties, authorities, and code of conduct for governing boards.</p>
        </div>

        <div class="charters-grid">
          <div class="charter-card">
            <h3>Board of Directors Charter (Piagam Direksi)</h3>
            <p>Outlines executive leadership authority, operational execution, strategic planning, and risk management led by President Director <strong>Ilham Pradani, S.H. (Cand.)</strong>.</p>
            <a href="#" class="btn-pdf-link red-text" onclick="alert('Downloading Board of Directors Charter PDF...'); return false;">View Charter Document (PDF) →</a>
          </div>

          <div class="charter-card">
            <h3>Board of Commissioners Charter (Piagam Komisaris)</h3>
            <p>Defines supervisory duties, oversight mechanisms, independent monitoring of company performance, and review of annual financial statements.</p>
            <a href="#" class="btn-pdf-link red-text" onclick="alert('Downloading Board of Commissioners Charter PDF...'); return false;">View Charter Document (PDF) →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Supporting Committees -->
    <section class="fullwidth-section" id="committees">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text">SUPPORTING COMMITTEES</span>
          <h2>Audit & Remuneration Committees</h2>
          <p>Dedicated committees ensuring financial integrity and equitable executive structuring.</p>
        </div>

        <div class="committee-stack">
          <div class="committee-box">
            <h4>1. Audit Committee (Komite Audit)</h4>
            <p>
              Responsible for reviewing internal financial controls, quarterly reporting accuracy, and liaising with Independent External Public Accounting Firms (KAP).
            </p>
            <div class="committee-meta">
              <span>Chairperson: <strong>Internal Audit Unit</strong></span> | 
              <span>Members: <strong>Financial Advisory Experts</strong></span>
            </div>
          </div>

          <div class="committee-box">
            <h4>2. Nomination & Remuneration Committee (Komite Nominasi & Remunerasi)</h4>
            <p>
              Establishes transparent evaluation criteria and executive compensation structures, currently overseeing the strategic recruitment of the Financial Director.
            </p>
            <div class="committee-meta">
              <span>Status: <strong>Active Board Structuring</strong></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Corporate Secretary Section -->
    <section class="fullwidth-section bg-light-clean" id="corsec">
      <div class="container">
        <div class="corsec-wrapper">
          <div class="corsec-info">
            <span class="section-tag red-text">OFFICIAL LIAISON & COMPLIANCE</span>
            <h2>Corporate Secretary (Sekretaris Perusahaan)</h2>
            <p>
              The Corporate Secretary acts as the official liaison officer between PT CHAIN ASIA CONECT, regulatory authorities, partners, and the public.
            </p>
            <div class="corsec-contacts">
              <div class="contact-row">
                <span class="c-label">Official CorSec Email:</span>
                <a href="mailto:corsec@chainasiaconect.company" class="c-link red-text">corsec@chainasiaconect.company</a>
              </div>
              <div class="contact-row">
                <span class="c-label">General Contact:</span>
                <a href="mailto:info@chainasiaconect.company" class="c-link">info@chainasiaconect.company</a>
              </div>
              <div class="contact-row">
                <span class="c-label">Executive Office:</span>
                <span class="c-val">PT CHAIN ASIA CONECT Headquarters, Indonesia</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Whistleblowing System (WBS) & Ethics -->
    <section class="fullwidth-section" id="wbs">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text">ETHICS & INTEGRITY REPORTING</span>
          <h2>Whistleblowing System (WBS) & Code of Conduct</h2>
          <p>A secure, confidential mechanism for reporting any violations of law, ethics, or financial misconduct.</p>
        </div>

        <div class="wbs-card">
          <div class="wbs-text">
            <h3>Confidential Misconduct Reporting Channel</h3>
            <p>
              PT CHAIN ASIA CONECT enforces a strict zero-tolerance policy against fraud, bribery, corruption, or regulatory non-compliance. All employees, vendors, and public partners can submit confidential reports directly to our Internal Audit Committee.
            </p>
            <div class="wbs-channel">
              <span>Secure WBS Email:</span>
              <a href="mailto:wbs@chainasiaconect.company" class="wbs-email red-text">wbs@chainasiaconect.company</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 4rem 0 3rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .section-intro h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.35rem 0 1.5rem 0;
    color: var(--text-dark);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    padding: 1.5rem;
    border-radius: 4px;
  }

  .pillar-num {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .pillar-card h4 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.5rem 0;
  }

  .pillar-card p {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.5;
  }

  .bg-light-clean {
    background: #f8fafc;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 3.5rem 0;
  }

  .section-header-clean {
    max-width: 800px;
    margin-bottom: 2rem;
  }

  .section-header-clean h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-top: 0.35rem;
  }

  .section-header-clean p {
    font-size: 1rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  .charters-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .charter-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 1.75rem;
  }

  .charter-card h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .charter-card p {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .btn-pdf-link {
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .committee-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .committee-box {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 1.5rem;
  }

  .committee-box h4 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.35rem;
  }

  .committee-box p {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .committee-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .corsec-wrapper {
    max-width: 850px;
  }

  .corsec-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.5rem;
    background: #ffffff;
    padding: 1.5rem;
    border: 1px solid var(--border-light);
    border-radius: 4px;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .c-label {
    width: 170px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .c-link {
    font-weight: 700;
    color: var(--text-dark);
    text-decoration: none;
  }

  .wbs-card {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--red-primary);
    border-radius: 4px;
    padding: 2rem;
  }

  .wbs-text h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .wbs-text p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.25rem;
  }

  .wbs-channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .wbs-email {
    font-size: 1.1rem;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .charters-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
