<script>
  function setupGovernanceCoverflow() {
    const stage = document.getElementById('governance-coverflow-stage');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.gov-cover-card'));
    const prevBtn = document.getElementById('gov-prev-pillar');
    const nextBtn = document.getElementById('gov-next-pillar');

    if (!cards.length) return;

    // Start with middle pillar (index 2: Responsibility)
    let currentIndex = 2;

    function render() {
      const isMobile = window.innerWidth <= 640;
      const isTablet = window.innerWidth <= 900;
      const offset = isMobile ? 38 : (isTablet ? 46 : 54);
      const rotation = isMobile ? 28 : 38;
      const baseZ = 10;
      const maxZ = 60;

      cards.forEach((card, i) => {
        if (i < currentIndex) {
          const diff = currentIndex - i;
          const scale = Math.max(0.75, 1 - diff * 0.08);
          const opacity = Math.max(0.35, 1 - diff * 0.22);
          card.style.transform = `translateX(-${offset * diff}%) rotateY(${rotation}deg) scale(${scale})`;
          card.style.zIndex = String(baseZ + i);
          card.style.opacity = String(opacity);
          card.classList.remove('active-center');
          card.setAttribute('aria-selected', 'false');
        } else if (i === currentIndex) {
          card.style.transform = `translateX(0%) rotateY(0deg) translateZ(120px) scale(1.05)`;
          card.style.zIndex = String(maxZ);
          card.style.opacity = '1';
          card.classList.add('active-center');
          card.setAttribute('aria-selected', 'true');
        } else {
          const diff = i - currentIndex;
          const scale = Math.max(0.75, 1 - diff * 0.08);
          const opacity = Math.max(0.35, 1 - diff * 0.22);
          card.style.transform = `translateX(${offset * diff}%) rotateY(-${rotation}deg) scale(${scale})`;
          card.style.zIndex = String(baseZ + (cards.length - i));
          card.style.opacity = String(opacity);
          card.classList.remove('active-center');
          card.setAttribute('aria-selected', 'false');
        }
      });
    }

    function goToPrev() {
      currentIndex = (currentIndex - 1 + cards.length) % cards.length;
      render();
    }

    function goToNext() {
      currentIndex = (currentIndex + 1) % cards.length;
      render();
    }

    prevBtn?.addEventListener('click', goToPrev);
    nextBtn?.addEventListener('click', goToNext);

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        currentIndex = idx;
        render();
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          currentIndex = idx;
          render();
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const isNearCoverflow = stage?.contains(activeEl) || 
                              document.querySelector('.coverflow-controls-wrapper')?.contains(activeEl);

      if (isNearCoverflow) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToPrev();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToNext();
        }
      }
    });

    let touchStartX = 0;
    stage?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stage?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          goToPrev();
        } else {
          goToNext();
        }
      }
    }, { passive: true });

    window.addEventListener('resize', render);
    render();
  }

  // Scroll reveal observer
  function setupScrollReveal() {
    const targets = document.querySelectorAll('.scroll-reveal');
    if (!targets.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('revealed'));
    }
  }

  function init() {
    setupGovernanceCoverflow();
    setupScrollReveal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
