---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ComingSoonHero from '../components/ComingSoonHero.astro';
import DirekturSection from '../components/DirekturSection.astro';
import CompanyIdentity from '../components/CompanyIdentity.astro';
import ServicesSection from '../components/ServicesSection.astro';
import GromacsPricingSection from '../components/GromacsPricingSection.astro';
import LegalSection from '../components/LegalSection.astro';
import HomeNewsSection from '../components/HomeNewsSection.astro';
import ComingSoonBanner from '../components/ComingSoonBanner.astro';
import Staircase3D from '../components/Staircase3D.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="PT CHAIN ASIA CONECT | Official Corporate Portal" description="Official Corporate Portal for PT CHAIN ASIA CONECT (SK Kemenkumham AHU-A117353, NIB 0709260109599). President Director: Ilham Pradani, S.H. (Cand.), Vice President Director: Putri Wulandari, S.T. Enterprise Supply Chain & Medical Software Licensing.">
  <Header />
  <main>
    <!-- Section 1: Home Hero -->
    <ComingSoonHero />

    <!-- Section 2: Dimensional Interface Cards (DepthFold 3D Glass & Parallax Curtain Overlay) -->
    <section class="corporate-directory-section" id="portal-directory">
      <div class="directory-curtain-handle" aria-hidden="true">
        <span class="handle-bar"></span>
      </div>
      <div class="container">
        <div class="directory-header">
          <div class="directory-title-block">
            <span class="section-tag red-text">DIMENSIONAL CORPORATE ECOSYSTEM</span>
            <h2>Corporate Directory & Strategic Operations</h2>
            <p>Interactive dimensional interface cards for PT CHAIN ASIA CONECT's business divisions, governance, and capital roadmap.</p>
          </div>
          <div class="directory-meta-badge">
            <span class="meta-label">LEGAL ENTITY</span>
            <span class="meta-value">SK AHU-A117353 • NIB 0709260109599</span>
          </div>
        </div>

        <!-- Dimensional Shape Grid -->
        <div class="shape-grid">
          
          <!-- Card 01: Corporate Overview (Crimson) -->
          <div class="ux-parent ux-parent--crimson">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2L4 7v10l8 5 8-5V7l-8-5zm0 2.2l5.5 3.4L12 10.9 6.5 7.6 12 4.2zM6 9.9l5 3v6.1l-5-3.1V9.9zm12 6.1l-5 3.1v-6.2l5-3v6.1z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Corporate Overview</span>
                <span class="ux-text">Establishment history, C-H-A-I-N philosophy, Executive Directors, and certified AHU legalities.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">AHU-A117353</span>
                </div>
                <div class="ux-more">
                  <a href="/about" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 02: Business Lines & Supply Chain (Solar) -->
          <div class="ux-parent ux-parent--solar">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="#fff" stroke-width="2"/><path fill="#fff" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Business & Supply Chain</span>
                <span class="ux-text">Enterprise supply chain integration, regional asset hubs in Krui, and PACS medical imaging tech.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Core Operations</span>
                </div>
                <div class="ux-more">
                  <a href="/business" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 03: Investor Relations (Mint Orb) -->
          <div class="ux-parent ux-parent--mint">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Investor Relations</span>
                <span class="ux-text">Founders MoU, 10% Mitra Langit Tabarru' compact, and Initial Public Offering (IPO 2029) roadmap.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Target IPO 2029</span>
                </div>
                <div class="ux-more">
                  <a href="/investor-relations" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 04: Corporate Governance (Violet Chamfer Cut) -->
          <div class="ux-parent ux-parent--violet ux-parent--cut">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Good Governance</span>
                <span class="ux-text">5 Pillars of GCG, Board Charters, Corporate Secretary desk, and confidential Whistleblowing System.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">5 Pillars GCG</span>
                </div>
                <div class="ux-more">
                  <a href="/governance" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 05: Sustainability & ESG (Ocean) -->
          <div class="ux-parent ux-parent--ocean">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2a10 10 0 0 0-7.07 17.07A10 10 0 0 0 12 22a10 10 0 0 0 7.07-2.93A10 10 0 0 0 12 2z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Sustainability & ESG</span>
                <span class="ux-text">10% monthly Net Profit allocation for social welfare, orphan support, and paperless DICOM PACS technology.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">10% Tabarru'</span>
                </div>
                <div class="ux-more">
                  <a href="/sustainability" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 06: Newsroom (Prism) -->
          <div class="ux-parent ux-parent--prism">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2l9 16H3L12 2zm0 4.5L7.5 16h9L12 6.5z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Newsroom & Media</span>
                <span class="ux-text">Official corporate announcements, verified press releases, media kits, and strategic milestones.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Press Releases</span>
                </div>
                <div class="ux-more">
                  <a href="/newsroom" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 07: Careers (Cut Rose) -->
          <div class="ux-parent ux-parent--rose ux-parent--cut">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="#fff"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Careers & Talent</span>
                <span class="ux-text">Executive governance structuring and medical software technical talent recruitment opportunities.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Recruitment</span>
                </div>
                <div class="ux-more">
                  <a href="/careers" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 08: Headquarters Contact (Void Stack) -->
          <div class="ux-parent ux-parent--void">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Executive Contact</span>
                <span class="ux-text">Registered office location, President Director direct desk, and Corporate Secretary inquiry liaison.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Headquarters</span>
                </div>
                <div class="ux-more">
                  <a href="/contact" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 3: About Us Summary (Board of Directors & Philosophy) -->
    <section class="home-summary-section scroll-reveal" id="home-about-summary">
      <div class="container">
        <div class="section-row-header">
          <div class="header-left">
            <span class="section-tag red-text">CORPORATE STANDING & LEADERSHIP</span>
            <h2>About Us & Executive Governance</h2>
          </div>
          <div class="header-right">
            <a href="/about" class="btn-more-red">
              <span>Learn More About Us & Legal Standing →</span>
            </a>
          </div>
        </div>
        <div class="section-detail-body">
          <DirekturSection />
          <CompanyIdentity />
        </div>
      </div>
    </section>

    <!-- Section 4: Business & Services Summary -->
    <section class="home-summary-section bg-light-clean scroll-reveal" id="home-services-summary">
      <div class="container">
        <div class="section-row-header">
          <div class="header-left">
            <span class="section-tag red-text">SPECIALIZED SOLUTIONS & INFRASTRUCTURE</span>
            <h2>Business Operations & High Performance Computing</h2>
          </div>
          <div class="header-right">
            <a href="/business" class="btn-more-red">
              <span>Explore All Business Lines & 3D Licensing →</span>
            </a>
          </div>
        </div>
        <div class="section-detail-body">
          <ServicesSection />
          <GromacsPricingSection />
        </div>
      </div>
    </section>

    <!-- Section 5: Investor Relations & IPO 2029 Summary (with Left Corner 3D Gray Staircase & Progress Line) -->
    <section class="home-summary-section investor-summary-staircase-wrap scroll-reveal" id="home-investor-summary">
      <!-- 3D Slate Gray Staircase (Compact Left Corner, Flush Top-to-Bottom) -->
      <Staircase3D align="left" id="home-investor-staircase" opacity={0.92} scale={0.82} />

      <div class="container investor-container-relative">
        <div class="section-row-header">
          <div class="header-left">
            <span class="section-tag red-text">INVESTOR RELATIONS & IPO ROADMAP</span>
            <h2>Founders Agreement & Go Public Plan 2029</h2>
          </div>
          <div class="header-right">
            <a href="/investor-relations" class="btn-more-red">
              <span>View Full Investor Relations Portal →</span>
            </a>
          </div>
        </div>
        <div class="section-detail-body">
          <p class="summary-desc">
            PT CHAIN ASIA CONECT operates under an executive founders agreement between President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Vice President Director <strong>Putri Wulandari, S.T.</strong>, allocating <strong>10% of Net Profit to Mitra Langit Tabarru' Fund</strong> and targeting <strong>Initial Public Offering (IPO) in 2029</strong>.
          </p>

          <!-- Connected Roadmap Progress Line Preview (Sharp Fullwidth Dense) -->
          <div class="home-progress-rail-wrap">
            <div class="home-progress-bar-head">
              <div class="home-status-indicator">
                <span class="home-beacon-dot"></span>
                <span class="status-txt-green">STAGE 1 ACTIVE & VERIFIED</span>
                <span class="status-sep">|</span>
                <span class="status-pct-red">35% PROGRESS</span>
              </div>
              <span class="home-target-tag red-text">Target IDX Listing: 2029 (Tbk)</span>
            </div>
            <div class="home-progress-track">
              <div class="home-progress-fill" style="width: 35%;"></div>
            </div>
            <div class="home-progress-steps">
              <div class="home-step-item active">
                <span class="step-dot completed">✓</span>
                <div class="step-meta">
                  <strong class="step-yr">2026</strong>
                  <span class="step-lbl">Legal Governance & Foundation</span>
                </div>
              </div>
              <div class="home-step-item">
                <span class="step-dot pending">02</span>
                <div class="step-meta">
                  <strong class="step-yr">2027–2028</strong>
                  <span class="step-lbl">Scaling & KAP Financial Audit</span>
                </div>
              </div>
              <div class="home-step-item target">
                <span class="step-dot target">★</span>
                <div class="step-meta">
                  <strong class="step-yr red-text">2029</strong>
                  <span class="step-lbl">Tbk Initial Public Offering (IPO)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: Governance Summary with 3D CoverFlow 5 Pillars -->
    <section class="home-summary-section bg-light-clean scroll-reveal" id="home-governance-summary">
      <div class="container">
        <div class="section-row-header">
          <div class="header-left">
            <span class="section-tag red-text">GOOD CORPORATE GOVERNANCE</span>
            <h2>5 Pillars of Governance & Corporate Secretary</h2>
          </div>
          <div class="header-right">
            <a href="/governance" class="btn-more-red">
              <span>View Corporate Governance Details →</span>
            </a>
          </div>
        </div>
        <div class="section-detail-body">
          <p class="summary-desc">
            Operating under strict transparency, accountability, and legal compliance (SK Kemenkumham AHU-A117353, NIB 0709260109599) with dedicated Corporate Secretary liaison and confidential Whistleblowing System (WBS).
          </p>

          <!-- 3D Model CoverFlow: The 5 Pillars of Governance on Home -->
          <div class="coverflow-stage" id="governance-coverflow-stage" aria-label="3D Coverflow 5 Pillars of Governance">
            <div id="governance-coverflow" class="coverflow-container">
              <!-- Pillar 1 -->
              <section class="gov-cover-card" data-index="0" tabindex="0" role="button" aria-label="Pillar 1: Transparency">
                <div class="gov-card-inner">
                  <div class="gov-card-top">
                    <span class="gov-card-num red-text">01</span>
                    <div class="gov-card-icon-wrap">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 9 9"/><circle cx="12" cy="12" r="3"/></svg>
                    </div>
                  </div>
                  <h3 class="gov-card-title">Transparency</h3>
                  <p class="gov-card-desc">Keterbukaan informasi material dan relevan secara tepat waktu, akurat, jelas, dan mudah diakses oleh seluruh pemangku kepentingan.</p>
                  <div class="gov-card-tag">Keterbukaan Informasi</div>
                </div>
              </section>

              <!-- Pillar 2 -->
              <section class="gov-cover-card" data-index="1" tabindex="0" role="button" aria-label="Pillar 2: Accountability">
                <div class="gov-card-inner">
                  <div class="gov-card-top">
                    <span class="gov-card-num red-text">02</span>
                    <div class="gov-card-icon-wrap">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    </div>
                  </div>
                  <h3 class="gov-card-title">Accountability</h3>
                  <p class="gov-card-desc">Kejelasan fungsi, hak, kewajiban, dan wewenang dewan direksi serta komisaris agar pengelolaan terlaksana secara efektif dan dapat dipertanggungjawabkan.</p>
                  <div class="gov-card-tag">Akuntabilitas Kinerja</div>
                </div>
              </section>

              <!-- Pillar 3 -->
              <section class="gov-cover-card" data-index="2" tabindex="0" role="button" aria-label="Pillar 3: Responsibility">
                <div class="gov-card-inner">
                  <div class="gov-card-top">
                    <span class="gov-card-num red-text">03</span>
                    <div class="gov-card-icon-wrap">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </div>
                  </div>
                  <h3 class="gov-card-title">Responsibility</h3>
                  <p class="gov-card-desc">Kepatuhan mutlak terhadap regulasi hukum RI, SK Kemenkumham AHU-A117353, OSS NIB 0709260109599, serta tanggung jawab sosial & kelestarian lingkungan.</p>
                  <div class="gov-card-tag">Tanggung Jawab Hukum</div>
                </div>
              </section>

              <!-- Pillar 4 -->
              <section class="gov-cover-card" data-index="3" tabindex="0" role="button" aria-label="Pillar 4: Independence">
                <div class="gov-card-inner">
                  <div class="gov-card-top">
                    <span class="gov-card-num red-text">04</span>
                    <div class="gov-card-icon-wrap">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                  </div>
                  <h3 class="gov-card-title">Independence</h3>
                  <p class="gov-card-desc">Pengelolaan korporasi secara independen dan profesional tanpa benturan kepentingan maupun tekanan dari pihak manapun yang bertentangan dengan hukum.</p>
                  <div class="gov-card-tag">Kemandirian Pengawasan</div>
                </div>
              </section>

              <!-- Pillar 5 -->
              <section class="gov-cover-card" data-index="4" tabindex="0" role="button" aria-label="Pillar 5: Fairness">
                <div class="gov-card-inner">
                  <div class="gov-card-top">
                    <span class="gov-card-num red-text">05</span>
                    <div class="gov-card-icon-wrap">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                  </div>
                  <h3 class="gov-card-title">Fairness</h3>
                  <p class="gov-card-desc">Keadilan dan kesetaraan dalam memenuhi hak-hak pemangku kepentingan yang timbul berdasarkan perjanjian dan peraturan perundang-undangan.</p>
                  <div class="gov-card-tag">Kewajaran & Kesetaraan</div>
                </div>
              </section>
            </div>
          </div>

          <!-- Minimalist Left-Right Controls -->
          <div class="coverflow-controls-wrapper">
            <div class="coverflow-nav-buttons">
              <button id="gov-prev-pillar" class="cover-nav-btn" aria-label="Sebelumnya">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <span>Sebelumnya</span>
              </button>
              <button id="gov-next-pillar" class="cover-nav-btn" aria-label="Selanjutnya">
