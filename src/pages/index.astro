---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ComingSoonHero from '../components/ComingSoonHero.astro';
import DirekturSection from '../components/DirekturSection.astro';
import CompanyIdentity from '../components/CompanyIdentity.astro';
import ServicesSection from '../components/ServicesSection.astro';
import LegalSection from '../components/LegalSection.astro';
import ComingSoonBanner from '../components/ComingSoonBanner.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="PT CHAIN ASIA CONECT | Official Corporate Portal" description="Official Corporate Portal for PT CHAIN ASIA CONECT (SK Kemenkumham AHU-A117353, NIB 0709260109599). President Director: Ilham Pradani, S.H. (Cand.), Vice President Director: Putri Wulandari, S.T. Enterprise Supply Chain & Medical Software Licensing.">
  <Header />
  <main>
    <!-- Section 1: Home Hero -->
    <ComingSoonHero />

    <!-- Section 2: Dimensional Interface Cards (DepthFold 3D Glass) -->
    <section class="corporate-directory-section" id="portal-directory">
      <div class="container">
        <div class="directory-header">
          <div class="directory-title-block">
            <span class="section-tag red-text">DIMENSIONAL CORPORATE ECOSYSTEM</span>
            <h2>Corporate Directory & Strategic Operations</h2>
            <p>Interactive dimensional interface cards for PT CHAIN ASIA CONECT's business divisions, governance, and capital roadmap.</p>
          </div>
          <div class="directory-meta-badge">
            <span class="meta-label">LEGAL ENTITY</span>
            <span class="meta-value">SK AHU-A117353 • NIB 0709260109599</span>
          </div>
        </div>

        <!-- Dimensional Shape Grid -->
        <div class="shape-grid">
          
          <!-- Card 01: Corporate Overview (Crimson) -->
          <div class="ux-parent ux-parent--crimson">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2L4 7v10l8 5 8-5V7l-8-5zm0 2.2l5.5 3.4L12 10.9 6.5 7.6 12 4.2zM6 9.9l5 3v6.1l-5-3.1V9.9zm12 6.1l-5 3.1v-6.2l5-3v6.1z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Corporate Overview</span>
                <span class="ux-text">Establishment history, C-H-A-I-N philosophy, Executive Directors, and certified AHU legalities.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">AHU-A117353</span>
                </div>
                <div class="ux-more">
                  <a href="/about" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 02: Business Lines & Supply Chain (Solar) -->
          <div class="ux-parent ux-parent--solar">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="#fff" stroke-width="2"/><path fill="#fff" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Business & Supply Chain</span>
                <span class="ux-text">Enterprise supply chain integration, regional asset hubs in Krui, and PACS medical imaging tech.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Core Operations</span>
                </div>
                <div class="ux-more">
                  <a href="/business" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 03: Investor Relations (Mint Orb) -->
          <div class="ux-parent ux-parent--mint">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Investor Relations</span>
                <span class="ux-text">Founders MoU, 10% Mitra Langit Tabarru' compact, and Initial Public Offering (IPO 2029) roadmap.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Target IPO 2029</span>
                </div>
                <div class="ux-more">
                  <a href="/investor-relations" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 04: Corporate Governance (Violet Chamfer Cut) -->
          <div class="ux-parent ux-parent--violet ux-parent--cut">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Good Governance</span>
                <span class="ux-text">5 Pillars of GCG, Board Charters, Corporate Secretary desk, and confidential Whistleblowing System.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">5 Pillars GCG</span>
                </div>
                <div class="ux-more">
                  <a href="/governance" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 05: Sustainability & ESG (Ocean) -->
          <div class="ux-parent ux-parent--ocean">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2a10 10 0 0 0-7.07 17.07A10 10 0 0 0 12 22a10 10 0 0 0 7.07-2.93A10 10 0 0 0 12 2z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Sustainability & ESG</span>
                <span class="ux-text">10% monthly Net Profit allocation for social welfare, orphan support, and paperless DICOM PACS technology.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">10% Tabarru'</span>
                </div>
                <div class="ux-more">
                  <a href="/sustainability" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 06: Newsroom (Prism) -->
          <div class="ux-parent ux-parent--prism">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2l9 16H3L12 2zm0 4.5L7.5 16h9L12 6.5z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Newsroom & Media</span>
                <span class="ux-text">Official corporate announcements, verified press releases, media kits, and strategic milestones.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Press Releases</span>
                </div>
                <div class="ux-more">
                  <a href="/newsroom" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 07: Careers (Cut Rose) -->
          <div class="ux-parent ux-parent--rose ux-parent--cut">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="#fff"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Careers & Talent</span>
                <span class="ux-text">Executive governance structuring and medical software technical talent recruitment opportunities.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Recruitment</span>
                </div>
                <div class="ux-more">
                  <a href="/careers" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 08: Headquarters Contact (Void Stack) -->
          <div class="ux-parent ux-parent--void">
            <div class="ux-card">
              <div class="ux-logo" aria-hidden="true">
                <span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span><span class="ux-circle"></span>
                <span class="ux-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
              </div>
              <div class="ux-glass"></div>
              <div class="ux-content">
                <span class="ux-title">Executive Contact</span>
                <span class="ux-text">Registered office location, President Director direct desk, and Corporate Secretary inquiry liaison.</span>
              </div>
              <div class="ux-bottom">
                <div class="ux-social">
                  <span class="ux-tag-badge">Headquarters</span>
                </div>
                <div class="ux-more">
                  <a href="/contact" class="ux-more-btn"><span>Open</span></a>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 3: About Us Summary (Board of Directors & Philosophy) -->
    <section class="home-summary-section" id="home-about-summary">
      <div class="container">
        <DirekturSection />
        <CompanyIdentity />
        <div class="section-more-action">
          <a href="/about" class="btn-more-red">
            <span>Learn More About Us & Legal Standing →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Section 4: Business & Services Summary -->
    <section class="home-summary-section bg-light-clean" id="home-services-summary">
      <div class="container">
        <ServicesSection />
        <div class="section-more-action">
          <a href="/business" class="btn-more-red">
            <span>Explore All Business Lines & 3D Licensing →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Section 5: Investor Relations & IPO 2029 Summary -->
    <section class="home-summary-section" id="home-investor-summary">
      <div class="container">
        <div class="home-summary-card">
          <span class="section-tag red-text">INVESTOR RELATIONS & IPO ROADMAP</span>
          <h2>Founders Agreement & Go Public Plan 2029</h2>
          <p class="summary-desc">
            PT CHAIN ASIA CONECT operates under an executive founders agreement between President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Vice President Director <strong>Putri Wulandari, S.T.</strong>, allocating <strong>10% of Net Profit to Mitra Langit Tabarru' Fund</strong> and targeting <strong>Initial Public Offering (IPO) in 2029</strong>.
          </p>
          <div class="section-more-action text-left">
            <a href="/investor-relations" class="btn-more-red">
              <span>View Full Investor Relations Portal →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: Governance Summary -->
    <section class="home-summary-section bg-light-clean" id="home-governance-summary">
      <div class="container">
        <div class="home-summary-card">
          <span class="section-tag red-text">GOOD CORPORATE GOVERNANCE</span>
          <h2>5 Pillars of Governance & Corporate Secretary</h2>
          <p class="summary-desc">
            Operating under strict transparency, accountability, and legal compliance (SK Kemenkumham AHU-A117353, NIB 0709260109599) with dedicated Corporate Secretary liaison and confidential Whistleblowing System (WBS).
          </p>
          <div class="section-more-action text-left">
            <a href="/governance" class="btn-more-red">
              <span>View Corporate Governance Details →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 7: Sustainability & ESG Summary -->
    <section class="home-summary-section" id="home-esg-summary">
      <div class="container">
        <div class="home-summary-card">
          <span class="section-tag red-text">SUSTAINABILITY & MITRA LANGIT</span>
          <h2>ESG Strategy & 10% Tabarru' Social Welfare</h2>
          <p class="summary-desc">
            Empowering regional communities in Krui, Pesisir Barat, Lampung through monthly social welfare support, paperless DICOM/PACS medical software cloud licensing, and micro-business guidance.
          </p>
          <div class="section-more-action text-left">
            <a href="/sustainability" class="btn-more-red">
              <span>Read Full Sustainability & ESG Report →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 8: Legal Verification Section with Official Authority Logos -->
    <LegalSection />

    <!-- Coming Soon Banner -->
    <ComingSoonBanner />
  </main>
  <Footer />
</Layout>

<style>
  .corporate-directory-section {
    background: #ffffff;
    padding: 4.5rem 0;
    border-top: 1px solid var(--border-light);
  }

  .directory-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.25rem;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .directory-title-block {
    max-width: 760px;
  }

  .directory-title-block h2 {
    font-size: clamp(1.9rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-top: 0.35rem;
    letter-spacing: -0.02em;
  }

  .directory-title-block p {
    font-size: 1.02rem;
    color: var(--text-muted);
    margin-top: 0.45rem;
    line-height: 1.6;
  }

  .directory-meta-badge {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.75rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: right;
  }

  .directory-meta-badge .meta-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #64748b;
  }

  .directory-meta-badge .meta-value {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  /* DepthFold Dimensional 3D Shape Grid */
  .shape-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.75rem;
    align-items: stretch;
  }

  @media (min-width: 1200px) {
    .shape-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .shape-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Core 3D Shell */
  .ux-parent {
    width: 100%;
    height: 310px;
    margin-inline: auto;
    perspective: 1000px;
    perspective-origin: 50% 50%;
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.08));
  }

  .ux-card {
    position: relative;
    height: 100%;
    border-radius: 44px;
    background: var(--ux-grad);
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.55s ease;
    box-shadow: rgba(0, 0, 0, 0) 40px 50px 25px -40px, rgba(0, 0, 0, 0.12) 0 20px 25px -5px;
  }

  .ux-parent:hover .ux-card {
    transform: rotate3d(1, 1, 0, 24deg);
    box-shadow: rgba(0, 0, 0, 0.22) 24px 44px 28px -36px, rgba(220, 38, 38, 0.12) 0 0 50px -10px, rgba(0, 0, 0, 0.1) 0 20px 30px 0;
  }

  /* Dimensional Themes */
  .ux-parent--crimson {
    --ux-grad: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    --ux-title: #7f1d1d;
    --ux-body: rgba(127, 29, 29, 0.88);
    --ux-cta: #dc2626;
    --ux-orbit: rgba(254, 202, 202, 0.4);
    --ux-fill: #991b1b;
  }

  .ux-parent--solar {
    --ux-grad: linear-gradient(135deg, #fbbf24 0%, #f97316 45%, #dc2626 100%);
    --ux-title: #7c2d12;
    --ux-body: rgba(124, 45, 18, 0.88);
    --ux-cta: #c2410c;
    --ux-orbit: rgba(254, 243, 199, 0.4);
    --ux-fill: #9a3412;
  }

  .ux-parent--mint {
    --ux-grad: linear-gradient(135deg, rgb(0, 255, 214) 0%, rgb(8, 226, 96) 100%);
    --ux-title: #00894d;
    --ux-body: rgba(0, 137, 78, 0.88);
    --ux-cta: #00894d;
    --ux-orbit: rgba(0, 249, 203, 0.28);
    --ux-fill: #00894d;
  }

  .ux-parent--violet {
    --ux-grad: linear-gradient(145deg, #a855f7 0%, #6366f1 40%, #ec4899 100%);
    --ux-title: #3b0764;
    --ux-body: rgba(59, 7, 100, 0.88);
    --ux-cta: #7c3aed;
    --ux-orbit: rgba(216, 180, 254, 0.35);
    --ux-fill: #5b21b6;
  }

  .ux-parent--ocean {
    --ux-grad: linear-gradient(155deg, #22d3ee 0%, #0284c7 50%, #1e3a8a 100%);
    --ux-title: #0c4a6e;
    --ux-body: rgba(12, 74, 110, 0.88);
    --ux-cta: #0369a1;
    --ux-orbit: rgba(125, 211, 252, 0.35);
    --ux-fill: #0e7490;
  }

  .ux-parent--prism {
    --ux-grad: conic-gradient(from 200deg at 65% 35%, #22d3ee, #818cf8, #f472b6, #facc15, #22d3ee);
    --ux-title: #0f172a;
    --ux-body: rgba(15, 23, 42, 0.88);
    --ux-cta: #4338ca;
    --ux-orbit: rgba(255, 255, 255, 0.4);
    --ux-fill: #312e81;
  }

  .ux-parent--rose {
    --ux-grad: linear-gradient(135deg, #fb7185 0%, #e11d48 50%, #881337 100%);
    --ux-title: #4c0519;
    --ux-body: rgba(76, 5, 25, 0.88);
    --ux-cta: #be123c;
    --ux-orbit: rgba(255, 228, 230, 0.4);
    --ux-fill: #9f1239;
  }

  .ux-parent--void {
    --ux-grad: linear-gradient(160deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
    --ux-title: #5eead4;
    --ux-body: rgba(203, 213, 225, 0.88);
    --ux-cta: #c084fc;
    --ux-orbit: rgba(167, 139, 250, 0.25);
    --ux-fill: #c084fc;
  }

  /* Shape Modifiers */
  .ux-parent--cut .ux-card {
    border-radius: 36px;
    clip-path: polygon(16px 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 16px), calc(100% - 16px) 100%, 16px 100%, 0 calc(100% - 16px), 0 16px);
  }

  .ux-parent--cut .ux-glass {
    border-radius: 32px !important;
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px), 0 14px);
  }

  /* Glass Layer */
  .ux-glass {
    transform-style: preserve-3d;
    position: absolute;
    inset: 8px;
    border-radius: 45px;
    border-top-right-radius: 100%;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.85) 100%);
    transform: translate3d(0, 0, 25px);
    border-inline-start: 1px solid rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.75);
    transition: all 0.5s ease-in-out;
    pointer-events: none;
  }

  .ux-parent--void .ux-glass {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(15, 23, 42, 0.6) 100%);
    border-color: rgba(148, 163, 184, 0.25);
  }

  /* Logo Orbits */
  .ux-logo {
    position: absolute;
    inset-inline-end: 0;
    top: 0;
    transform-style: preserve-3d;
    pointer-events: none;
    z-index: 2;
  }

  .ux-circle {
    display: block;
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    top: 0;
    inset-inline-end: 0;
