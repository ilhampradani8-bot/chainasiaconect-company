---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Staircase3D from '../../components/Staircase3D.astro';
---

<Layout title="Investor Relations & Profit Distribution | PT CHAIN ASIA CONECT" description="Investor Relations, Executive Founders Agreement (Ilham Pradani & Putri Wulandari, S.T.), Profit Distribution Policy (10% Mitra Langit Tabarru' Fund), and IPO 2029 Roadmap.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">CORPORATE ROADMAP & PROFIT DISTRIBUTION</span>
        <h1 class="page-hero-title">Investor Relations <span class="red-text">& Capital Governance</span></h1>
        <p class="page-hero-desc">
          Official corporate portal for PT CHAIN ASIA CONECT. Outlining founders partnership agreement, ethical profit allocation, and expansion milestones for our targeted <strong>Initial Public Offering (IPO): Coming Soon 2029</strong>.
        </p>
      </div>
    </section>

    <!-- Executive Founders & Profit Distribution Section (Fullwidth Editorial, No Cards) -->
    <section class="fullwidth-section profit-policy-section">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text">EXECUTIVE PARTNERSHIP & PROFIT DISTRIBUTION</span>
          <h2>Founders Agreement & Profit Allocation Policy</h2>
          <p>Established under the formal MoU between President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Vice President Director <strong>Putri Wulandari, S.T.</strong></p>
        </div>

        <div class="profit-policy-linear">
          <!-- Allocation 01: 10% Mitra Langit -->
          <div class="policy-row-item featured-ml-row">
            <div class="policy-meta-col">
              <span class="policy-pct-tag red-text">10% ALLOCATION</span>
              <span class="p-status-pill green-badge">✓ Active Social Compact</span>
            </div>
            <div class="policy-body-col">
              <h3 class="policy-heading">Mitra Langit (Dana Tabarru' & Sedekah)</h3>
              <p class="policy-text">
                10% of monthly Net Profit is dedicated to Dana Tabarru' & Sedekah for social impact, aiding orphans, dhuafa, and micro-business empowerment in Pekon Seray / Pesisir Tengah, Pesisir Barat, Krui, Lampung.
              </p>
            </div>
          </div>

          <!-- Allocation 02: 90% Operational & Dividends -->
          <div class="policy-row-item">
            <div class="policy-meta-col">
              <span class="policy-pct-tag red-text">90% ALLOCATION</span>
              <span class="p-status-pill slate-badge">✓ Audited Distribution</span>
            </div>
            <div class="policy-body-col">
              <h3 class="policy-heading">Re-investment & Founders Dividend Shareout</h3>
              <p class="policy-text">
                90% of Net Profit is allocated for Operational Reserves, Physical Business Re-investment, and Dividend Distribution between President Director (Ilham Pradani, S.H. (Cand.)) and Vice President Director (Putri Wulandari, S.T.) based on agreed equity standing.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Prominent Coming Soon 2029 IPO Section (with Stationary 3D White Staircase & Progress Line) -->
    <section class="fullwidth-section ipo-banner-section">
      <!-- Stationary 3D Pure White Animated Staircase Backdrop (Fullwidth Centered Behind Text) -->
      <Staircase3D align="center" id="ipo-staircase-3d" opacity={0.72} scale={1.8} />

      <div class="container ipo-container-relative">
        <div class="ipo-editorial-wrap">
          <div class="ipo-badge-row">
            <span class="ipo-tag red-bg">INITIAL PUBLIC OFFERING (IPO) ROADMAP</span>
            <span class="ipo-year red-text">TARGET LISTING: COMING SOON 2029</span>
          </div>
          
          <h2 class="ipo-main-title">Transforming towards Public Listed Corporation (Tbk)</h2>
          
          <p class="ipo-lead-desc">
            As a registered Individual Limited Liability Company (PT Perorangan) under SK Kemenkumham AHU-A117353.AH.01.30.Year 2026, <strong>PT CHAIN ASIA CONECT</strong> is executing a strategic multi-year roadmap. We are establishing audit frameworks, corporate secretary functions, and financial accounting standards targeting public listing (Tbk) on Bursa Efek Indonesia (IDX) in <strong>2029</strong>.
          </p>

          <!-- Interactive Corporate Progress Line Track -->
          <div class="progress-timeline-wrapper">
            <!-- Global Track Bar with Active Status -->
            <div class="progress-track-bar">
              <div class="track-header-row">
                <div class="track-status-badge">
                  <span class="track-beacon-dot"></span>
                  <span class="track-status-txt">STAGE 1 ACTIVE & VERIFIED</span>
                </div>
                <div class="track-pct-box">
                  <span class="track-pct-text">Overall Roadmap Progress: <strong class="red-text">35%</strong></span>
                </div>
              </div>
              <div class="progress-rail-line" aria-label="Roadmap progression bar">
                <div class="progress-rail-fill" style="width: 35%;"></div>
              </div>
            </div>

            <!-- Connected Step Nodes on Progress Line -->
            <div class="progress-nodes-list">
              
              <!-- Step 01: 2026 Active -->
              <div class="progress-node-item node-completed">
                <div class="node-spine">
                  <div class="node-circle active-circle">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="node-check-svg">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="node-line-segment active-line"></div>
                </div>
                <div class="node-details">
                  <div class="node-tag-row">
                    <span class="node-badge-code red-text">PHASE 01</span>
                    <span class="node-badge-year green-badge">2026 • CURRENT ACTIVE</span>
                  </div>
                  <h3 class="node-heading">Entity Establishment & Legal Governance</h3>
                  <p class="node-paragraph">SK Kemenkumham AHU-A117353, NIB 0709260109599, KBLI 62193, Corporate Bank OCBC, and formal Founders MoU.</p>
                  <div class="node-checklist">
                    <span class="chk-item">✓ SK Kemenkumham Verified</span>
                    <span class="chk-item">✓ Bank OCBC Operational</span>
                    <span class="chk-item">✓ 10% Mitra Langit Enacted</span>
                  </div>
                </div>
              </div>

              <!-- Step 02: 2027-2028 Scaling -->
              <div class="progress-node-item node-scaling">
                <div class="node-spine">
                  <div class="node-circle pending-circle">
                    <span class="node-number-txt">02</span>
                  </div>
                  <div class="node-line-segment"></div>
                </div>
                <div class="node-details">
                  <div class="node-tag-row">
                    <span class="node-badge-code">PHASE 02</span>
                    <span class="node-badge-year slate-badge">2027 – 2028 • SCALING</span>
                  </div>
                  <h3 class="node-heading">Ecosystem Scaling & Financial Audit</h3>
                  <p class="node-paragraph">Scaling medical machine engineering, PACS software cloud licensing, and annual KAP auditing distribution.</p>
                  <div class="node-checklist">
                    <span class="chk-item pending">○ Annual KAP Audit Readiness</span>
                    <span class="chk-item pending">○ PACS Cloud Multi-Year Enterprise Licenses</span>
                    <span class="chk-item pending">○ Dedicated Corsec Desk</span>
                  </div>
                </div>
              </div>

              <!-- Step 03: 2029 Target Tbk -->
              <div class="progress-node-item node-target">
                <div class="node-spine">
                  <div class="node-circle target-circle">
                    <span class="node-star-txt">★</span>
                  </div>
                </div>
                <div class="node-details">
                  <div class="node-tag-row">
                    <span class="node-badge-code red-text">PHASE 03</span>
                    <span class="node-badge-year red-badge">2029 • TARGET GO PUBLIC</span>
                  </div>
                  <h3 class="node-heading">Tbk Transformation (Initial Public Offering)</h3>
                  <p class="node-paragraph">Registration filing with OJK and Bursa Efek Indonesia (BEI / IDX) for Initial Public Offering, unlocking public equity participation.</p>
                  <div class="node-checklist">
                    <span class="chk-item target-chk">★ Listing on Indonesia Stock Exchange (IDX)</span>
                    <span class="chk-item target-chk">★ Public Shareholder Distribution</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Neumorphic Action Buttons -->
          <div class="ipo-action-buttons">
            <a href="mailto:corsec@chainasiaconnect.co.id" class="btn-more-red">
              <span>Inquire Investor Relations Desk →</span>
            </a>
            <a href="mailto:ilhampradani-sh@chainasiaconnect.co.id" class="btn-secondary-clean">
              <span>President Director Office</span>
            </a>
          </div>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Profit Policy Section */
  .profit-policy-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
  }

  .section-header-clean {
    max-width: 860px;
    margin-bottom: 2.5rem;
  }

  .section-header-clean h2 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-top: 0.35rem;
  }

  .section-header-clean p {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  /* Linear Policy Breakdown (No Cards) */
  .profit-policy-linear {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .policy-row-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border-light);
    align-items: flex-start;
  }

  .policy-row-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .policy-meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .policy-pct-tag {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .p-status-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-block;
    width: fit-content;
  }

  .green-badge {
    background: #f0fdf4;
    color: #16a34a;
    border: 1px solid #dcfce7;
  }

  .slate-badge {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #e2e8f0;
  }

  .red-badge {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fee2e2;
  }

  .policy-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.65rem;
  }

  .policy-text {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-body);
    margin: 0;
  }

  /* Fullwidth IPO Roadmap Section with Stationary 3D White Staircase */
  .ipo-banner-section {
    position: relative;
    background: #f8fafc;
    padding: 5rem 0 6rem 0;
    border-bottom: 1px solid var(--border-light);
    overflow: hidden;
  }

  .ipo-container-relative {
    position: relative;
    z-index: 2;
  }

  .ipo-editorial-wrap {
    max-width: 900px;
    margin: 0 auto;
  }

  .ipo-badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .ipo-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }

  .ipo-tag.red-bg {
    background: var(--red-primary);
    color: #ffffff;
  }

  .ipo-year {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .ipo-main-title {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .ipo-lead-desc {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-body);
    margin-bottom: 2.75rem;
  }

  /* Progress Line Timeline System */
  .progress-timeline-wrapper {
    margin: 2.5rem 0 3.5rem 0;
  }

  .progress-track-bar {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .track-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .track-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 800;
    color: #15803d;
    letter-spacing: 0.04em;
  }

  .track-beacon-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
    animation: beaconPulse 2s infinite ease-in-out;
  }

  @keyframes beaconPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.3);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.1);
    }
  }

  .track-pct-text {
    font-size: 0.85rem;
    color: var(--text-body);
    font-weight: 600;
  }

  .progress-rail-line {
    width: 100%;
    height: 8px;
    background: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
  }

  .progress-rail-fill {
    height: 100%;
    background: linear-gradient(90deg, #16a34a 0%, var(--red-primary) 70%, #f43f5e 100%);
    border-radius: 9999px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Progress Nodes Track */
  .progress-nodes-list {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .progress-node-item {
    display: flex;
    gap: 1.75rem;
    position: relative;
    padding-bottom: 2.25rem;
  }

  .progress-node-item:last-child {
    padding-bottom: 0;
  }

  /* Progress Spine / Line */
  .node-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 36px;
    flex-shrink: 0;
  }

  .node-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 2px solid #cbd5e1;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .active-circle {
    border-color: #16a34a;
    background: #f0fdf4;
    color: #16a34a;
    box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.15);
  }

  .node-check-svg {
    width: 18px;
    height: 18px;
  }

  .pending-circle {
    border-color: #94a3b8;
    background: #f8fafc;
    color: #64748b;
  }

  .node-number-txt {
    font-size: 0.85rem;
    font-weight: 800;
  }

  .target-circle {
    border-color: var(--red-primary);
    background: #fef2f2;
    color: var(--red-primary);
    box-shadow: 0 0 0 5px rgba(220, 38, 38, 0.15);
  }

  .node-star-txt {
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1;
  }

  .node-line-segment {
    width: 3px;
    flex-grow: 1;
    background: #cbd5e1;
    margin-top: 6px;
    margin-bottom: 6px;
    border-radius: 2px;
  }

  .node-line-segment.active-line {
    background: linear-gradient(180deg, #16a34a 0%, #cbd5e1 100%);
  }

  /* Node Details */
  .node-details {
    flex-grow: 1;
    padding-top: 0.2rem;
  }

  .node-tag-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .node-badge-code {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .node-badge-year {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .node-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.2rem 0 0.5rem 0;
    line-height: 1.25;
  }

  .node-paragraph {
    font-size: 0.98rem;
    color: var(--text-body);
    line-height: 1.7;
    margin: 0 0 0.85rem 0;
  }

  .node-checklist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chk-item {
    font-size: 0.8rem;
    font-weight: 600;
    color: #166534;
    background: #f0fdf4;
    border: 1px solid #dcfce7;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .chk-item.pending {
    color: #64748b;
    background: #ffffff;
    border: 1px solid #e2e8f0;
  }

  .chk-item.target-item {
    color: var(--red-primary);
    background: #fef2f2;
    border: 1px solid #fee2e2;
  }

  .ipo-action-buttons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .policy-row-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .progress-node-item {
      gap: 1rem;
    }
    .node-circle {
      width: 32px;
      height: 32px;
    }
    .ipo-action-buttons {
      flex-direction: column;
      align-items: stretch;
    }
    .ipo-action-buttons .btn-more-red,
    .ipo-action-buttons .btn-secondary-clean {
      width: 100%;
      text-align: center;
    }
  }
</style>
