---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Staircase3D from '../../components/Staircase3D.astro';
---

<Layout title="Investor Relations & Profit Distribution | PT CHAIN ASIA CONECT" description="Investor Relations, Executive Founders Agreement (Ilham Pradani & Putri Wulandari, S.T.), Profit Distribution Policy (10% Mitra Langit Tabarru' Fund), and IPO 2029 Roadmap.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">CORPORATE ROADMAP & PROFIT DISTRIBUTION</span>
        <h1 class="page-hero-title">Investor Relations <span class="red-text">& Capital Governance</span></h1>
        <p class="page-hero-desc">
          Official corporate portal for PT CHAIN ASIA CONECT. Outlining founders partnership agreement, ethical profit allocation, and expansion milestones for our targeted <strong>Initial Public Offering (IPO): Coming Soon 2029</strong>.
        </p>
      </div>
    </section>

    <!-- Executive Founders & Profit Distribution Section (Fullwidth Editorial, No Cards) -->
    <section class="fullwidth-section profit-policy-section">
      <div class="container">
        <div class="section-header-clean">
          <h2>Founders Agreement & Profit Allocation Policy</h2>
          <p>Established under the formal MoU between President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Vice President Director <strong>Putri Wulandari, S.T.</strong></p>
        </div>

        <div class="profit-policy-linear">
          <!-- Allocation 01: 10% Mitra Langit -->
          <div class="policy-row-item featured-ml-row">
            <div class="policy-meta-col">
              <span class="policy-pct-tag red-text">10% ALLOCATION</span>
              <span class="p-status-pill green-badge">✓ Active Social Compact</span>
            </div>
            <div class="policy-body-col">
              <h3 class="policy-heading">Mitra Langit (Dana Tabarru' & Sedekah)</h3>
              <p class="policy-text">
                10% of monthly Net Profit is dedicated to Dana Tabarru' & Sedekah for social impact, aiding orphans, dhuafa, and micro-business empowerment in Pekon Seray / Pesisir Tengah, Pesisir Barat, Krui, Lampung.
              </p>
            </div>
          </div>

          <!-- Allocation 02: 90% Operational & Dividends -->
          <div class="policy-row-item">
            <div class="policy-meta-col">
              <span class="policy-pct-tag red-text">90% ALLOCATION</span>
              <span class="p-status-pill slate-badge">✓ Audited Distribution</span>
            </div>
            <div class="policy-body-col">
              <h3 class="policy-heading">Re-investment & Founders Dividend Shareout</h3>
              <p class="policy-text">
                90% of Net Profit is allocated for Operational Reserves, Physical Business Re-investment, and Dividend Distribution between President Director (Ilham Pradani, S.H. (Cand.)) and Vice President Director (Putri Wulandari, S.T.) based on agreed equity standing.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Prominent Coming Soon 2029 IPO Section (Dense, Fullheight 3D Gray Staircase & Horizontal Progress Line) -->
    <section class="fullwidth-section ipo-banner-section">
      <!-- 3D Slate Gray Staircase (Flush Top-to-Bottom, Full Height of Section) -->
      <Staircase3D align="left" id="ipo-staircase-3d" opacity={0.95} scale={1} />

      <div class="container ipo-container-relative">
        <div class="ipo-editorial-wrap">
          <!-- 1 Single Title per Section -->
          <h2 class="ipo-main-title">Initial Public Offering (IPO) Roadmap: Target Go Public 2029</h2>
          
          <p class="ipo-lead-desc">
            As a registered Individual Limited Liability Company (PT Perorangan) under SK Kemenkumham AHU-A117353.AH.01.30.Year 2026, <strong>PT CHAIN ASIA CONECT</strong> is executing a strategic multi-year roadmap targeting public listing (Tbk) on Bursa Efek Indonesia (IDX) in <strong>2029</strong>.
          </p>

          <!-- Interactive Corporate Progress Line Track (Dense, No Cards for Text) -->
          <div class="progress-timeline-wrapper">
            <!-- Progress Status Bar (Pure Typography & Gradient Rail, No Card Box) -->
            <div class="progress-track-bar">
              <div class="track-header-row">
                <div class="track-status-indicator">
                  <span class="track-beacon-dot"></span>
                  <span class="status-txt-green">STAGE 1 ACTIVE & VERIFIED</span>
                  <span class="status-sep">|</span>
                  <span class="status-pct-red">35% PROGRESS</span>
                </div>
                <div class="track-pct-box">
                  <span class="track-pct-text">Overall Roadmap Target: <strong class="red-text">2029 Tbk Listing (IDX)</strong></span>
                </div>
              </div>
              <div class="progress-rail-line" aria-label="Roadmap progression bar">
                <div class="progress-rail-fill" style="width: 35%;"></div>
              </div>
            </div>

            <!-- Horizontal Connected Step Milestones (Dense Grid, Pure Typography, NO Cards) -->
            <div class="progress-dense-steps">
              <!-- Step 01: 2026 Active -->
              <div class="dense-step-item active">
                <div class="step-head-row">
                  <span class="step-badge-code red-text">PHASE 01</span>
                  <span class="step-badge-status status-green">✓ ACTIVE & VERIFIED</span>
                </div>
                <div class="step-title-row">
                  <strong class="step-year">2026</strong>
                  <h3 class="step-heading">Entity & Legal Governance</h3>
                </div>
                <p class="step-desc">SK Kemenkumham AHU-A117353, NIB 0709260109599, KBLI 62193, Corporate Bank OCBC, Founders MoU, & 10% Mitra Langit Tabarru'.</p>
              </div>

              <!-- Step 02: 2027-2028 Scaling -->
              <div class="dense-step-item">
                <div class="step-head-row">
                  <span class="step-badge-code">PHASE 02</span>
                  <span class="step-badge-status status-slate">○ SCALING ECOSYSTEM</span>
                </div>
                <div class="step-title-row">
                  <strong class="step-year">2027–2028</strong>
                  <h3 class="step-heading">Ecosystem & KAP Audit</h3>
                </div>
                <p class="step-desc">Scaling medical devices & PACS cloud software licensing, dedicated corsec desk, and annual KAP financial audit readiness.</p>
              </div>

              <!-- Step 03: 2029 Target Tbk -->
              <div class="dense-step-item target">
                <div class="step-head-row">
                  <span class="step-badge-code red-text">PHASE 03</span>
                  <span class="step-badge-status status-red">★ TARGET GO PUBLIC</span>
                </div>
                <div class="step-title-row">
                  <strong class="step-year red-text">2029</strong>
                  <h3 class="step-heading">Tbk Transformation (IPO)</h3>
                </div>
                <p class="step-desc">Registration filing with OJK and Bursa Efek Indonesia (IDX) for Initial Public Offering, unlocking public equity participation.</p>
              </div>
            </div>
          </div>

          <!-- Action Buttons (Only Buttons have Cards/Pills, Sharp Corners) -->
          <div class="ipo-action-buttons">
            <a href="mailto:corsec@chainasiaconnect.co.id" class="btn-sharp-primary">
              <span>Inquire Investor Relations Desk →</span>
            </a>
            <a href="mailto:ilhampradani-sh@chainasiaconnect.co.id" class="btn-sharp-secondary">
              <span>President Director Office</span>
            </a>
          </div>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Profit Policy Section */
  .profit-policy-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
  }

  .section-header-clean {
    max-width: 860px;
    margin-bottom: 2.5rem;
  }

  .section-header-clean h2 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-top: 0.35rem;
  }

  .section-header-clean p {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  /* Linear Policy Breakdown (No Cards) */
  .profit-policy-linear {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .policy-row-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border-light);
    align-items: flex-start;
  }

  .policy-row-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .policy-meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .policy-pct-tag {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .p-status-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-block;
    width: fit-content;
  }

  .green-badge {
    background: #f0fdf4;
    color: #16a34a;
    border: 1px solid #dcfce7;
  }

  .slate-badge {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #e2e8f0;
  }

  .red-badge {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fee2e2;
  }

  .policy-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.65rem;
  }

  .policy-text {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-body);
    margin: 0;
  }

  /* Fullwidth IPO Roadmap Section with Background 3D Staircase */
  .ipo-banner-section {
    position: relative;
    background: #f8fafc;
    padding: 3rem 0;
    border-bottom: 1px solid var(--border-light);
    overflow: hidden;
    min-height: 410px;
    display: flex;
    align-items: center;
  }

  .ipo-container-relative {
    position: relative;
    z-index: 10; /* Text clearly in front of background staircase */
    width: 100%;
  }

  .ipo-editorial-wrap {
    width: 100%;
    margin: 0;
    position: relative;
    z-index: 10; /* Teks di depan */
  }

  .ipo-main-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .ipo-lead-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 1.25rem;
    max-width: 950px;
  }

  /* Progress Line Timeline System (Dense, No Card background for text) */
  .progress-timeline-wrapper {
    margin: 1.25rem 0 1.5rem 0;
    width: 100%;
  }

  /* Track Bar: Pure Typography & Line, NO CARD BOX */
  .progress-track-bar {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    margin-bottom: 1.25rem;
    width: 100%;
  }

  .track-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .track-status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .status-txt-green {
    color: #15803d;
  }

  .status-sep {
    color: #cbd5e1;
    font-weight: 400;
  }

  .status-pct-red {
    color: var(--red-primary);
  }

  .track-beacon-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
    animation: beaconPulse 2s infinite ease-in-out;
  }

  @keyframes beaconPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.3);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.1);
    }
  }

  .track-pct-text {
    font-size: 0.85rem;
    color: var(--text-body);
    font-weight: 600;
  }

  .progress-rail-line {
    width: 100%;
    height: 6px;
    background: #e2e8f0;
    border-radius: 0;
    overflow: hidden;
  }

  .progress-rail-fill {
    height: 100%;
    background: linear-gradient(90deg, #16a34a 0%, var(--red-primary) 70%, #dc2626 100%);
    border-radius: 0;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Dense 3-Column Milestone Grid: Pure Typography, NO CARDS */
  .progress-dense-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .dense-step-item {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .step-head-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .step-badge-code {
    color: var(--text-muted);
  }

  .status-green {
    color: #16a34a;
  }

  .status-slate {
    color: #64748b;
  }

  .status-red {
    color: var(--red-primary);
  }

  .step-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .step-year {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text-dark);
  }

  .step-heading {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0;
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-body);
    margin: 0;
  }

  /* Action Buttons: Only buttons get card/button styling (Sharp Corners) */
  .ipo-action-buttons {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-sharp-primary,
  .btn-sharp-secondary {
    border-radius: 0 !important; /* Sharp corners */
    font-family: inherit;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.75rem 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-sharp-primary {
    background: var(--red-primary);
    color: #ffffff;
    border: 1px solid var(--red-primary);
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
  }

  .btn-sharp-primary:hover {
    background: #b91c1c;
    border-color: #b91c1c;
    transform: translateY(-2px);
  }

  .btn-sharp-secondary {
    background: #ffffff;
    color: var(--text-dark);
    border: 1px solid var(--border-light);
  }

  .btn-sharp-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .ipo-editorial-wrap {
      padding-left: 0;
    }
    .progress-dense-steps {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .policy-row-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .ipo-action-buttons {
      flex-direction: column;
      align-items: stretch;
    }
    .ipo-action-buttons .btn-sharp-primary,
    .ipo-action-buttons .btn-sharp-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
