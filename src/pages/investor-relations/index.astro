---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Investor Relations & Profit Distribution | PT CHAIN ASIA CONECT" description="Investor Relations, Executive Founders Agreement (Ilham Pradani & Putri Wulan, S.T.), Profit Distribution Policy (10% Mitra Langit Tabarru' Fund), and IPO 2029 Roadmap.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">CORPORATE ROADMAP & PROFIT DISTRIBUTION</span>
        <h1 class="page-hero-title">Investor Relations <span class="red-text">& Capital Governance</span></h1>
        <p class="page-hero-desc">
          Official corporate portal for PT CHAIN ASIA CONECT. Outlining founders partnership agreement, ethical profit allocation, and expansion milestones for our targeted <strong>Initial Public Offering (IPO): Coming Soon 2029</strong>.
        </p>
      </div>
    </section>

    <!-- Executive Founders & Profit Distribution Section -->
    <section class="fullwidth-section profit-policy-section">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text">EXECUTIVE PARTNERSHIP & PROFIT DISTRIBUTION</span>
          <h2>Founders Agreement & Profit Allocation Policy</h2>
          <p>Established under the formal MoU between President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Financial Director <strong>Putri Wulan, S.T.</strong></p>
        </div>

        <div class="profit-policy-grid">
          <!-- Policy Card 1: 10% Mitra Langit -->
          <div class="policy-card featured-ml">
            <span class="policy-num red-text">10% ALLOCATION</span>
            <h3>Mitra Langit (Dana Tabarru' & Sedekah)</h3>
            <p>
              10% of monthly Net Profit is dedicated to Dana Tabarru' & Sedekah for social impact, aiding orphans, dhuafa, and micro-business empowerment in Pekon Seray / Pesisir Tengah, Pesisir Barat, Krui, Lampung.
            </p>
            <div class="policy-footer">
              <span class="p-status green-text">✓ Active Commitment</span>
            </div>
          </div>

          <!-- Policy Card 2: 90% Operational & Dividends -->
          <div class="policy-card">
            <span class="policy-num red-text">90% ALLOCATION</span>
            <h3>Re-investment & Founders Dividend Shareout</h3>
            <p>
              90% of Net Profit is allocated for Operational Reserves, Physical Business Re-investment, and Dividend Distribution between President Director (Ilham Pradani, S.H. (Cand.)) and Financial Director (Putri Wulan, S.T.) based on agreed equity standing.
            </p>
            <div class="policy-footer">
              <span class="p-status">✓ Audited Net Distribution</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Prominent Coming Soon 2029 IPO Banner -->
    <section class="fullwidth-section ipo-banner-section">
      <div class="container">
        <div class="ipo-coming-soon-card">
          <div class="ipo-badge-row">
            <span class="ipo-tag red-bg">INITIAL PUBLIC OFFERING (IPO) ROADMAP</span>
            <span class="ipo-year red-text">COMING SOON 2029</span>
          </div>
          <h2>Transforming towards Public Listed Corporation (Tbk)</h2>
          <p>
            As a registered Individual Limited Liability Company (PT Perorangan) under SK Kemenkumham AHU-A117353.AH.01.30.Year 2026, <strong>PT CHAIN ASIA CONECT</strong> is executing a strategic multi-year roadmap. We are establishing audit frameworks, corporate secretary functions, and financial accounting standards targeting public listing (Tbk) on Bursa Efek Indonesia (IDX) in <strong>2029</strong>.
          </p>

          <div class="roadmap-grid">
            <div class="roadmap-step">
              <span class="step-num red-text">PHASE 01 (2026)</span>
              <h4>Entity Establishment</h4>
              <p>Legal foundation, SK Kemenkumham, NIB 0709260109599, and initial business ecosystem setup.</p>
            </div>
            <div class="roadmap-step">
              <span class="step-num red-text">PHASE 02 (2027-2028)</span>
              <h4>Ecosystem Expansion & Audit</h4>
              <p>Scaling medical machine engineering, PACS software cloud licensing, and annual KAP auditing.</p>
            </div>
            <div class="roadmap-step featured-step">
              <span class="step-num red-text">PHASE 03 (2029)</span>
              <h4>Tbk Transformation (IPO)</h4>
              <p>Registration filing with OJK and Bursa Efek Indonesia (BEI / IDX) for Initial Public Offering.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 4rem 0 3rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Profit Policy Section */
  .profit-policy-section {
    padding: 3.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
  }

  .section-header-clean {
    max-width: 800px;
    margin-bottom: 2rem;
  }

  .section-header-clean h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-top: 0.35rem;
  }

  .section-header-clean p {
    font-size: 1rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  .profit-policy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .policy-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .policy-card.featured-ml {
    border-left: 4px solid var(--red-primary);
    background: #fef2f2;
  }

  .policy-num {
    font-size: 0.775rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .policy-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.5rem 0;
  }

  .policy-card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .policy-footer {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .green-text {
    color: #16a34a !important;
  }

  /* IPO Banner Section */
  .ipo-banner-section {
    background: #f8fafc;
    padding: 3.5rem 0;
  }

  .ipo-coming-soon-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 2.5rem;
  }

  .ipo-badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .ipo-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
  }

  .ipo-tag.red-bg {
    background: var(--red-primary);
    color: #ffffff;
  }

  .ipo-year {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .ipo-coming-soon-card h2 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .ipo-coming-soon-card p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-body);
    max-width: 900px;
    margin-bottom: 2rem;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .roadmap-step {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 1.5rem;
  }

  .roadmap-step.featured-step {
    border-color: var(--red-primary);
    background: #fef2f2;
  }

  .step-num {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .roadmap-step h4 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.5rem 0;
  }

  .roadmap-step p {
    font-size: 0.9rem;
    color: var(--text-body);
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .profit-policy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
