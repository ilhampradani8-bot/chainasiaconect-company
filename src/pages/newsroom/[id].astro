---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchAllNews, formatImageUrl, parseDateToISO } from '../../lib/news';

export async function getStaticPaths() {
  const { news } = await fetchAllNews();
  const paths = [];
  for (const item of news) {
    // Generate route for SEO Title Slug
    paths.push({
      params: { id: item.slug },
      props: { article: item, allNews: news }
    });
    // Juga dukung route numeric id agar backwards-compatible
    if (item.id && item.id !== item.slug) {
      paths.push({
        params: { id: String(item.id) },
        props: { article: item, allNews: news }
      });
    }
  }
  return paths;
}

const { id } = Astro.params;

// Ambil data terbaru secara live dan dinamis langsung dari Google Sheets
const { news } = await fetchAllNews();
const article = news.find((n) => n.slug === id || String(n.id) === String(id)) || Astro.props.article;

if (!article) {
  return Astro.redirect('/newsroom');
}

// Canonical URL SEO ramah Google
const canonicalUrl = `https://www.chainasiaconnect.co.id/newsroom/${article.slug}`;

// Pastikan gambar artikel menggunakan URL dinamis yang valid
const dynamicArticleImage = formatImageUrl(article.imageUrl);

// Konversi tanggal berita ke format standar ISO 8601 untuk Google News & Search Console
const isoPublishedDate = parseDateToISO(article.date);

// Filter saran berita (kecuali berita saat ini), maksimal 5 artikel
const suggestions = news
  .filter((n) => n.slug !== article.slug && String(n.id) !== String(article.id))
  .slice(0, 5);

// Format paragraf isi berita
const rawContent = article.content && article.content.trim().length > 0 ? article.content : article.excerpt;
const paragraphs = rawContent.split(/\n\n+/).filter((p) => p.trim().length > 0);

// Rich Schema.org NewsArticle Structured Data untuk Google Search & Google News
const newsArticleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.title,
  "description": article.excerpt,
  "image": [dynamicArticleImage],
  "datePublished": isoPublishedDate,
  "dateModified": isoPublishedDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": [
    {
      "@type": "Organization",
      "name": "PT CHAIN ASIA CONECT Corporate Communications",
      "url": "https://www.chainasiaconnect.co.id"
    }
  ],
  "publisher": {
    "@type": "Organization",
    "name": "PT CHAIN ASIA CONECT",
    "url": "https://www.chainasiaconnect.co.id",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.chainasiaconnect.co.id/images/CAC-LOGO.jpg"
    }
  }
};

---

<Layout 
  title={`${article.title} | Newsroom PT CHAIN ASIA CONECT`}
  description={article.excerpt || article.title}
  canonical={canonicalUrl}
  image={dynamicArticleImage}
  ogType="article"
  articleMeta={{
    publishedTime: isoPublishedDate,
    author: "PT CHAIN ASIA CONECT Corporate Communications",
    section: article.tag
  }}
  extraSchema={newsArticleSchema}
>
  <Header />

  <main class="reading-page-main">
    <!-- Top Nav & Breadcrumb Bar -->
    <nav class="reading-nav-bar" aria-label="Navigasi Berita">
      <div class="container nav-bar-inner">
        <a href="/newsroom" class="back-link">
          <svg viewBox="0 0 20 20" fill="currentColor" class="nav-arrow">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
          </svg>
          <span>Kembali ke Newsroom</span>
        </a>

        <div class="breadcrumb-trail">
          <a href="/">Beranda</a>
          <span class="sep">/</span>
          <a href="/newsroom">Newsroom</a>
          <span class="sep">/</span>
          <span class="current-crumb">{article.tag}</span>
        </div>
      </div>
    </nav>

    <!-- Article Core Container -->
    <article class="article-container" itemscope itemtype="https://schema.org/NewsArticle">
      <div class="container article-inner">
        
        <!-- Header Info -->
        <header class="article-header">
          <div class="article-badge-row">
            <span class="article-cat-badge">{article.tag}</span>
            <time class="article-date-meta" datetime="2026-10-14">{article.date}</time>
            <span class="read-estimate">• {article.readTime || '3 min baca'}</span>
          </div>

          <h1 class="article-headline" itemprop="headline">{article.title}</h1>

          {article.excerpt && (
            <p class="article-lead" itemprop="description">{article.excerpt}</p>
          )}

          <div class="author-source-bar">
            <div class="source-avatar" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
              </svg>
            </div>
            <div class="source-info">
              <span class="source-name" itemprop="author">PT CHAIN ASIA CONECT Corporate Communications</span>
              <span class="source-desk">Divisi Media & Keterbukaan Informasi Publik</span>
            </div>
          </div>
        </header>

        <!-- Featured Media Banner (100% Dinamis dari Spreadsheet) -->
        {dynamicArticleImage && (
          <figure class="article-featured-media">
            <img 
              src={dynamicArticleImage} 
              alt={article.title} 
              class="featured-img" 
              loading="eager"
              referrerpolicy="no-referrer"
              itemprop="image"
            />
            <figcaption class="media-caption">
              Dokumentasi Publikasi Resmi — PT CHAIN ASIA CONECT
            </figcaption>
          </figure>
        )}

        <!-- Article Prose Body -->
        <div class="article-prose" itemprop="articleBody">
          {paragraphs.map((p) => (
            <p>{p}</p>
          ))}

          {article.link && article.link !== '#' && (
            <div class="article-external-box">
              <div class="ext-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div class="ext-content">
                <h4>Dokumen / Rilis Resmi Eksternal Terkait</h4>
                <p>Akses dokumen rujukan, arsip PDF, atau portal sumber rilis pers resmi berikut ini.</p>
                <a href={article.link} target="_blank" rel="noopener noreferrer" class="ext-btn">
                  Buka Dokumen Resmi →
                </a>
              </div>
            </div>
          )}
        </div>

        <!-- Corporate Stamp / Sign-off (Clean Imprint - No Card) -->
        <div class="article-signoff-clean">
          <span class="signoff-tag">OFFICIAL CORPORATE PORTAL</span>
          <span class="signoff-comp">PT CHAIN ASIA CONECT</span>
          <span class="signoff-meta">SK AHU-A117353.AH.01.30.Tahun 2026 • NIB 0709260109599</span>
        </div>

      </div>
    </article>

    <!-- Saran News Section (Full-Width Clean Newspaper List - No Sidebar, No Boxed Card) -->
    {suggestions.length > 0 && (
      <section class="suggestions-section" aria-label="Berita Rekomendasi">
        <div class="container suggestions-fullwidth-wrap">
          <div class="suggestions-header-bar">
            <h2 class="suggestions-heading">Berita Rekomendasi</h2>
            <span class="suggestions-sub">Pembaruan korporasi, pencapaian, dan agenda kemitraan terkini PT CHAIN ASIA CONECT.</span>
          </div>
          
          <div class="articles-clean-list">
            {suggestions.map((sug) => (
              <a href={`/newsroom/${sug.slug}`} class="article-row-link">
                <article class="article-row">
                  <div class="article-thumb-box">
                    <img 
                      src={formatImageUrl(sug.imageUrl)} 
                      alt={sug.title} 
                      loading="lazy" 
                      referrerpolicy="no-referrer"
                      class="article-thumb-img"
                    />
                  </div>
                  <div class="article-content-box">
                    <div class="article-meta-line">
                      <span class="meta-tag red-text">{sug.tag}</span>
                      <span class="meta-date">{sug.date}</span>
                      <span class="meta-readtime">• {sug.readTime}</span>
                    </div>
                    <h3 class="article-title">{sug.title}</h3>
                    <p class="article-excerpt">{sug.excerpt || sug.content}</p>
                    <span class="article-arrow-cta red-text">Baca Selengkapnya →</span>
                  </div>
                </article>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>



<style>
  .reading-page-main {
    background: #ffffff;
    padding-top: 5.5rem;
  }

  /* Navigation Bar */
  .reading-nav-bar {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 1rem 0;
  }

  .nav-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--red-primary, #dc2626);
  }

  .nav-arrow {
    width: 18px;
    height: 18px;
  }

  .breadcrumb-trail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .breadcrumb-trail a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-trail a:hover {
    color: var(--text-dark);
    text-decoration: underline;
  }

  .current-crumb {
    color: var(--red-primary, #dc2626);
    font-weight: 700;
  }

  /* Article Layout */
  .article-container {
    padding: 3.5rem 0 4.5rem 0;
  }

  .article-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  /* Header */
  .article-badge-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .article-cat-badge {
    background: transparent;
    color: var(--red-primary, #dc2626);
    border: none;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0;
    text-transform: uppercase;
  }

  .article-date-meta, .read-estimate {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .article-headline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .article-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #334155;
    margin-bottom: 2rem;
    font-style: italic;
  }

  /* Author Source Bar */
  .author-source-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .source-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fee2e2;
    color: var(--red-primary, #dc2626);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .source-avatar svg {
    width: 24px;
    height: 24px;
  }

  .source-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 200px;
  }

  .source-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .source-desk {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  /* Featured Image */
  .article-featured-media {
    margin-bottom: 2.5rem;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    background: #f1f5f9;
  }

  .featured-img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    display: block;
  }

  .media-caption {
    padding: 0.75rem 1rem;
    font-size: 0.775rem;
    color: var(--text-muted);
    background: #fafafa;
    border-top: 1px solid var(--border-light);
    text-align: center;
  }

  /* Prose Body */
  .article-prose {
    font-size: 1.125rem;
    line-height: 1.85;
    color: #1e293b;
    margin-bottom: 3.5rem;
  }

  .article-prose p {
    margin-bottom: 1.6rem;
  }

  /* External Resource Box */
  .article-external-box {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--red-primary, #dc2626);
    border-radius: 6px;
    margin: 2.5rem 0;
  }

  .ext-icon {
    color: var(--red-primary, #dc2626);
    margin-top: 2px;
  }

  .ext-content h4 {
    font-size: 1rem;
    color: var(--text-dark);
    margin-bottom: 0.35rem;
  }

  .ext-content p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    line-height: 1.5;
  }

  .ext-btn {
    display: inline-flex;
    padding: 0.45rem 1rem;
    background: var(--red-primary, #dc2626);
    color: #ffffff;
    font-size: 0.825rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s ease;
  }

  .ext-btn:hover {
    opacity: 0.9;
  }

  /* Signoff Clean (No Card Box) */
  .article-signoff-clean {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .signoff-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--red-primary, #dc2626);
    margin-bottom: 0.15rem;
  }

  .signoff-comp {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .signoff-meta {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Suggestions Section (Full-Width Clean Newspaper List - No Sidebar, No Boxed Card) */
  .suggestions-section {
    background-color: #fafafa;
    padding: 3.5rem 0 5rem 0;
    border-top: 1px solid var(--border-light, #e2e8f0);
    width: 100%;
  }

  .suggestions-fullwidth-wrap {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .suggestions-header-bar {
    margin-bottom: 2rem;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid #222;
  }

  .suggestions-heading {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    font-weight: 800;
    color: #111;
    margin: 0 0 0.35rem 0;
    line-height: 1.2;
  }

  .suggestions-sub {
    font-size: 0.95rem;
    color: var(--text-muted, #64748b);
  }

  .articles-clean-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .article-row-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
  }

  .article-row {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #e5e7eb;
    transition: background-color 0.15s ease;
  }

  .article-row-link:hover .article-row {
    background-color: #f4f4f5;
  }

  .article-thumb-box {
    flex: 0 0 180px;
    width: 180px;
    height: 120px;
    border-radius: 4px;
    overflow: hidden;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
  }

  .article-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .article-row-link:hover .article-thumb-img {
    transform: scale(1.03);
  }

  .article-content-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .article-meta-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
  }

  .article-meta-line .meta-tag {
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .article-meta-line .meta-date,
  .article-meta-line .meta-readtime {
    color: var(--text-muted, #64748b);
    font-weight: 500;
  }

  .article-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: #1e293b;
    margin: 0 0 0.4rem 0;
    transition: color 0.15s ease;
  }

  .article-row-link:hover .article-title {
    color: var(--red-primary, #dc2626);
  }

  .article-excerpt {
    font-size: 0.925rem;
    line-height: 1.5;
    color: #475569;
    margin: 0 0 0.5rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-arrow-cta {
    font-size: 0.8rem;
    font-weight: 700;
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .article-row {
      flex-direction: column;
      gap: 1rem;
    }

    .article-thumb-box {
      flex: none;
      width: 100%;
      height: 180px;
    }
  }

  @media (max-width: 640px) {
    .author-source-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
    .article-headline {
      font-size: 1.75rem;
    }
  }
</style>
