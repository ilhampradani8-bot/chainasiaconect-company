---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Google Sheets Published CSV Endpoint dari link publik Anda
const GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQa2Ih5iXjRYbgKJsIFlUTwPw4hl0xDIRn5MCTWd6g7UecdJi8jQLj8qKO_GvBG-JWIQ7n5pju2ZG47/pub?gid=0&single=true&output=csv";

interface NewsItem {
  id?: string;
  tag: string;
  date: string;
  title: string;
  excerpt: string;
  content?: string;
  imageUrl?: string;
  link?: string;
  status?: string;
}

// Fallback berita default jika spreadsheet kosong / offline
const defaultNews: NewsItem[] = [
  {
    id: "1",
    tag: "PRESS RELEASE",
    date: "SEPTEMBER 18, 2026",
    title: "PT CHAIN ASIA CONECT Expands Diagnostic PACS Cloud Software Licensing Partnerships",
    excerpt: "PT CHAIN ASIA CONECT officially announces the deployment expansion of DICOM PACS diagnostic cloud software systems, strengthening regional health center digital infrastructure across Indonesia.",
    content: "Official operational deployment across regional health hubs.",
    imageUrl: "/images/visualization-tutorial-data-loading-and-3d-visualization.png",
    link: "#",
    status: "published"
  },
  {
    id: "2",
    tag: "CORPORATE MILESTONE",
    date: "SEPTEMBER 1, 2026",
    title: "Formal Entity Registration Completed Under SK Kemenkumham AHU-A117353.AH.01.30.Year 2026",
    excerpt: "The company achieves complete legal standing as a registered Individual Limited Liability Company (PT Perorangan) under the Ministry of Law and Human Rights RI and NIB 0709260109599.",
    content: "The establishment decree is recognized under Indonesian law as an officially incorporated commercial entity.",
    imageUrl: "/images/ornate-bg.jpg",
    link: "#",
    status: "published"
  }
];

function parseCSV(text: string): Record<string, string>[] {
  const lines = text.split(/\r?\n/).filter(line => line.trim().length > 0);
  if (lines.length < 2) return [];

  const parseRow = (row: string): string[] => {
    const result: string[] = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < row.length; i++) {
      const c = row[i];
      if (c === '"') {
        if (inQuotes && row[i + 1] === '"') {
          cur += '"';
          i++;
        } else {
          inQuotes = !inQuotes;
        }
      } else if (c === ',' && !inQuotes) {
        result.push(cur.trim());
        cur = '';
      } else {
        cur += c;
      }
    }
    result.push(cur.trim());
    return result;
  };

  const headers = parseRow(lines[0]).map(h => h.toLowerCase().replace(/[\s\-_]+/g, ''));
  const rows: Record<string, string>[] = [];

  for (let i = 1; i < lines.length; i++) {
    const values = parseRow(lines[i]);
    if (values.every(v => v === '')) continue;
    const entry: Record<string, string> = {};
    headers.forEach((h, idx) => {
      entry[h] = values[idx] || '';
    });
    rows.push(entry);
  }

  return rows;
}

let newsList: NewsItem[] = defaultNews;
let isFromSpreadsheet = false;

try {
  const res = await fetch(GOOGLE_SHEET_CSV_URL, { cache: 'no-store' });
  if (res.ok) {
    const csvData = await res.text();
    if (csvData && csvData.trim().length > 0) {
      const parsedRows = parseCSV(csvData);
      if (parsedRows.length > 0) {
        const fetchedNews: NewsItem[] = parsedRows
          .map((r, idx) => {
            const rawStatus = (r.status || 'published').toLowerCase().trim();
            // Skip draft articles
            if (rawStatus === 'draft') return null;

            const contentVal = r.isiberita || r.isi || r.content || '';
            const linkVal = r.link || r.url || (contentVal.startsWith('http') ? contentVal : '#');
            const imgVal = r.gambarurl || r.gambar || r.foto || r.imageurl || r.image || '';

            return {
              id: r.id || String(idx + 1),
              tag: r.kategori || r.tag || r.category || 'MEDIA RELEASE',
              date: r.tanggal || r.date || 'RECENT',
              title: r.judul || r.title || '',
              excerpt: r.ringkasan || r.excerpt || r.deskripsi || '',
              content: contentVal,
              imageUrl: imgVal,
              link: linkVal,
              status: rawStatus
            };
          })
          .filter((item): item is NewsItem => item !== null && Boolean(item.title && item.title.trim() !== ''));

        if (fetchedNews.length > 0) {
          newsList = fetchedNews;
          isFromSpreadsheet = true;
        }
      }
    }
  }
} catch (err) {
  console.warn('Google Sheets fetch notice: Using default news list.', err);
}
---

<Layout title="Newsroom & Press Releases | PT CHAIN ASIA CONECT" description="Official press releases, corporate announcements, media relations, and company milestones from PT CHAIN ASIA CONECT.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <div class="hero-top-row">
          <span class="hero-tag red-text">MEDIA & OFFICIAL ANNOUNCEMENTS</span>
          {isFromSpreadsheet && (
            <span class="sheet-sync-pill">
              <span class="sync-dot"></span> Live Google Sheets Sync
            </span>
          )}
        </div>
        <h1 class="page-hero-title">Newsroom <span class="red-text">& Press Releases</span></h1>
        <p class="page-hero-desc">
          Official media releases, strategic announcements, corporate milestones, and institutional press coverage for PT CHAIN ASIA CONECT.
        </p>
      </div>
    </section>

    <!-- News List -->
    <section class="fullwidth-section">
      <div class="container">
        <div class="news-grid">
          {newsList.map((item) => (
            <article class="news-card">
              {item.imageUrl && (
                <div class="news-image-container">
                  <img 
                    src={item.imageUrl} 
                    alt={item.title} 
                    class="news-thumbnail" 
                    loading="lazy" 
                  />
                </div>
              )}
              
              <div class="news-content-box">
                <div class="card-meta">
                  <span class="news-tag red-text">{item.tag.toUpperCase()}</span>
                  <span class="news-date">{item.date.toUpperCase()}</span>
                </div>
                
                <h2 class="news-headline">{item.title}</h2>
                
                {item.excerpt && (
                  <p class="news-excerpt">
                    {item.excerpt}
                  </p>
                )}

                <!-- Full Content Expander if content exists and is not just a link -->
                {item.content && !item.content.startsWith('http') && item.content !== item.excerpt && (
                  <details class="news-details-block">
                    <summary class="news-details-toggle">
                      <span>Baca Isi Lengkap Berita</span>
                      <svg class="chevron-icon" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                      </svg>
                    </summary>
                    <div class="news-details-body">
                      <p>{item.content}</p>
                    </div>
                  </details>
                )}

                <!-- Action Button / Link -->
                <div class="news-action-row">
                  {item.link && item.link !== '#' ? (
                    <a href={item.link} target="_blank" rel="noopener noreferrer" class="news-link red-text">
                      <span>Buka Dokumen / Link Sumber →</span>
                    </a>
                  ) : (
                    <a href="#" class="news-link red-text" onclick="alert('Membuka arsip rilis resmi PT CHAIN ASIA CONECT...'); return false;">
                      <span>Arsip Rilis Resmi →</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: inline-block;
  }

  .sheet-sync-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #166534;
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16a34a;
    display: inline-block;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.05rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .news-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.5rem 0;
  }

  .news-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: row;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    border-color: #cbd5e1;
  }

  /* Image Thumbnail Box */
  .news-image-container {
    width: 320px;
    min-height: 220px;
    background: #f1f5f9;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  .news-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .news-card:hover .news-thumbnail {
    transform: scale(1.03);
  }

  .news-content-box {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 0.65rem;
  }

  .news-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .news-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .news-headline {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .news-excerpt {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  /* Details Dropdown */
  .news-details-block {
    margin-bottom: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    overflow: hidden;
  }

  .news-details-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.9rem;
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--red-primary, #dc2626);
    cursor: pointer;
    user-select: none;
  }

  .chevron-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .news-details-block[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .news-details-body {
    padding: 0.75rem 0.9rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-body);
    background: #ffffff;
  }

  .news-action-row {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .news-link {
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: opacity 0.2s ease;
  }

  .news-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .news-card {
      flex-direction: column;
    }

    .news-image-container {
      width: 100%;
      height: 200px;
    }

    .news-content-box {
      padding: 1.5rem;
    }
  }
</style>
