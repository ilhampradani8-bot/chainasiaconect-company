---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="SCF Platform (Securities Crowdfunding & Supply Chain Financing) | PT CHAIN ASIA CONECT" 
  description="Securities Crowdfunding & Supply Chain Financing (SCF) Platform by PT CHAIN ASIA CONECT. Connecting verified investors, healthcare supply chains, and high-growth real enterprises (Coming Soon Q4 2026 - 2027)."
>
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text" data-i18n="scf_hero_tag">FINANCIAL TECHNOLOGY & SUPPLY CHAIN ECOSYSTEM</span>
        <h1 class="page-hero-title" data-i18n="scf_hero_title">SCF Platform <span class="red-text">& Financing Ecosystem</span></h1>
        <p class="page-hero-desc" data-i18n="scf_hero_desc">
          Official Securities Crowdfunding (POJK No. 57/POJK.04/2020) & Supply Chain Financing portal by PT CHAIN ASIA CONECT. Connecting vetted retail and institutional investors with real-sector business expansion, medical supply chains, and high-impact enterprise financing.
        </p>
      </div>
    </section>

    <!-- Prominent Coming Soon & Regulatory Notice Section (Fullwidth Editorial) -->
    <section class="fullwidth-section scf-status-section">
      <div class="container">
        <div class="scf-status-editorial">
          <div class="scf-badge-row">
            <span class="scf-tag red-bg" data-i18n="scf_status_tag">DEVELOPMENT & REGULATORY ONBOARDING</span>
            <span class="scf-stage-text red-text" data-i18n="scf_status_stage">● STATUS: COMING SOON (Q4 2026 – 2027)</span>
          </div>

          <h2 class="scf-status-title" data-i18n="scf_status_title">Bridging Capital with High-Growth Real-Sector Supply Chains</h2>

          <p class="scf-status-lead" data-i18n="scf_status_lead">
            PT CHAIN ASIA CONECT is developing a comprehensive financial technology platform designed to facilitate licensed <strong>Securities Crowdfunding (SCF)</strong> and <strong>Supply Chain Invoice Financing</strong>. Our architecture combines strict OJK regulatory compliance, KSEI electronic scripless securities settlement, bank custodian escrow accounts, and direct real-asset collateral verification.
          </p>
        </div>
      </div>
    </section>

    <!-- 4 Core Pillars of the SCF Platform (Fullwidth Linear Subheadings) -->
    <section class="fullwidth-section scf-pillars-section bg-light-clean">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text" data-i18n="scf_pillars_tag">PLATFORM ARCHITECTURE & PILLARS</span>
          <h2 data-i18n="scf_pillars_title">Core Capabilities & Service Offerings</h2>
          <p data-i18n="scf_pillars_subtitle">Engineered for seamless digital compliance, transparent investor returns, and high-velocity business liquidity.</p>
        </div>

        <div class="scf-pillars-linear">
          <!-- Pillar 01: Securities Crowdfunding -->
          <div class="scf-pillar-item">
            <div class="scf-pillar-meta">
              <span class="scf-pillar-code red-text">PILLAR 01</span>
              <span class="p-status-pill green-badge" data-i18n="scf_p1_badge">✓ Equity & Sukuk</span>
            </div>
            <div class="scf-pillar-body">
              <h3 class="scf-pillar-heading" data-i18n="scf_p1_title">Securities Crowdfunding (SCF) for Real Enterprises</h3>
              <p class="scf-pillar-text" data-i18n="scf_p1_desc">
                Democratizing access to capital for high-potential SMEs and regional enterprise projects. Investors can purchase digital shares (equity crowdfunding) or Sharia-compliant bonds (Sukuk Mudharabah/Musyarakah) with clear dividend sharing schedules.
              </p>
            </div>
          </div>

          <!-- Pillar 02: Supply Chain Financing -->
          <div class="scf-pillar-item">
            <div class="scf-pillar-meta">
              <span class="scf-pillar-code red-text">PILLAR 02</span>
              <span class="p-status-pill slate-badge" data-i18n="scf_p2_badge">✓ B2B Factoring</span>
            </div>
            <div class="scf-pillar-body">
              <h3 class="scf-pillar-heading" data-i18n="scf_p2_title">Supply Chain Invoice & PO Financing</h3>
              <p class="scf-pillar-text" data-i18n="scf_p2_desc">
                Accelerating cash flow for vendors and contractors within the PT CHAIN ASIA CONECT medical engineering and supply chain ecosystem. Short-term, asset-backed funding tied directly to verified purchase orders and institutional receivables.
              </p>
            </div>
          </div>

          <!-- Pillar 03: Investor & Issuer Digital Portal -->
          <div class="scf-pillar-item">
            <div class="scf-pillar-meta">
              <span class="scf-pillar-code red-text">PILLAR 03</span>
              <span class="p-status-pill green-badge" data-i18n="scf_p3_badge">✓ Multi-Role Portal</span>
            </div>
            <div class="scf-pillar-body">
              <h3 class="scf-pillar-heading" data-i18n="scf_p3_title">Automated Investor Portal & e-KYC Integration</h3>
              <p class="scf-pillar-text" data-i18n="scf_p3_desc">
                Seamless digital onboarding with biometric e-KYC (Dukcapil verification), automated digital signature (e-Sign) for investment prospectuses, live portfolio performance tracking, and automated dividend distribution directly to registered RDN accounts.
              </p>
            </div>
          </div>

          <!-- Pillar 04: Compliance & Custody -->
          <div class="scf-pillar-item">
            <div class="scf-pillar-meta">
              <span class="scf-pillar-code red-text">PILLAR 04</span>
              <span class="p-status-pill slate-badge" data-i18n="scf_p4_badge">✓ OJK & KSEI Standard</span>
            </div>
            <div class="scf-pillar-body">
              <h3 class="scf-pillar-heading" data-i18n="scf_p4_title">Bank Escrow Custody & KSEI Central Depository</h3>
              <p class="scf-pillar-text" data-i18n="scf_p4_desc">
                Funds are strictly held in authorized Indonesian banking escrow accounts until funding campaigns reach 100% completion. All securities ownership is recorded electronically through PT Kustodian Sentral Efek Indonesia (KSEI) infrastructure.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Early Access / Priority Waitlist Form -->
    <section class="fullwidth-section scf-waitlist-section" id="waitlist">
      <div class="container">
        <div class="section-header-clean">
          <span class="section-tag red-text" data-i18n="scf_form_tag">PRIORITY ACCESS & ONBOARDING</span>
          <h2 data-i18n="scf_form_title">Join the SCF Early Access Waitlist</h2>
          <p data-i18n="scf_form_subtitle">Register your interest to receive advance notification and priority allocation when the platform officially launches.</p>
        </div>

        <div class="scf-form-container">
          <form id="scf-waitlist-form" class="scf-neu-form" onsubmit="event.preventDefault(); window.handleScfSubmit();">
            <div class="form-row-2col">
              <div class="form-group">
                <label for="scf-name" data-i18n="form_name_label">Full Name / Entity Name *</label>
                <input type="text" id="scf-name" class="neu-input" placeholder="e.g. John Doe / PT Sinar Maju" required />
              </div>
              <div class="form-group">
                <label for="scf-email" data-i18n="form_email_label">Official Business Email *</label>
                <input type="email" id="scf-email" class="neu-input" placeholder="name@company.com" required />
              </div>
            </div>

            <div class="form-row-2col">
              <div class="form-group">
                <label for="scf-phone" data-i18n="form_phone_label">WhatsApp / Mobile Number *</label>
                <input type="tel" id="scf-phone" class="neu-input" placeholder="+62 812-xxxx-xxxx" required />
              </div>
              <div class="form-group">
                <label for="scf-role" data-i18n="form_role_label">I Wish to Participate As: *</label>
                <select id="scf-role" class="neu-input" required>
                  <option value="" disabled selected>-- Select Role --</option>
                  <option value="retail_investor">Retail Investor (Pemodal Perorangan)</option>
                  <option value="institutional_investor">Institutional Investor (Pemodal Institusi / VC)</option>
                  <option value="issuer_sme">Business Issuer / SME (Penerbit Pendanaan UMKM)</option>
                  <option value="supply_chain_vendor">Supply Chain Vendor / Supplier (Mitra Rantai Pasok)</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="scf-notes" data-i18n="form_notes_label">Funding / Investment Scale & Comments (Optional)</label>
              <textarea id="scf-notes" rows="3" class="neu-input" placeholder="Briefly describe your investment capacity or business financing needs..."></textarea>
            </div>

            <div class="form-submit-row">
              <button type="submit" class="btn-more-red" id="scf-submit-btn">
                <span data-i18n="btn_join_waitlist">Join Priority Waitlist (Daftar Akses Awal) →</span>
              </button>
            </div>

            <div id="scf-form-feedback" class="scf-feedback-msg" style="display: none;">
              <span class="feedback-icon">✓</span>
              <span id="scf-feedback-text">Thank you! Your information has been registered for the SCF Priority Launch. Our investment desk will be in touch shortly.</span>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Bottom Navigation & Contact Action Band -->
    <section class="fullwidth-section expansion-banner-section" style="background: #f8fafc; padding: 4rem 0; border-top: 1px solid var(--border-light);">
      <div class="container text-center" style="max-width: 860px; margin: 0 auto; text-align: center;">
        <span class="banner-tag red-text" data-i18n="scf_cta_tag" style="font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">REGULATORY & GOVERNANCE COMPLIANCE</span>
        <h2 class="banner-title" data-i18n="scf_cta_title" style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; color: var(--text-dark); line-height: 1.2; margin-bottom: 1rem;">
          Inquire About SCF Partnerships & Co-Financing
        </h2>
        <p class="banner-text" data-i18n="scf_cta_desc" style="font-size: 1.05rem; line-height: 1.75; color: var(--text-body); margin-bottom: 2rem;">
          For institutional syndication, accredited underwriting inquiries, or corporate treasury partnerships, contact our Investor Relations & Capital Markets desk directly.
        </p>
        <div class="banner-actions" style="display: flex; align-items: center; justify-content: center; gap: 1.25rem; flex-wrap: wrap;">
          <a href="/investor-relations" class="btn-more-red" data-i18n="btn_view_ir">
            <span>Explore Investor Relations Portal →</span>
          </a>
          <a href="mailto:investor@chainasiaconect.company" class="btn-secondary-clean" data-i18n="btn_scf_desk">
            <span>Contact SCF Desk (investor@chainasiaconect.company)</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  window.handleScfSubmit = function() {
    const feedback = document.getElementById('scf-form-feedback');
    const submitBtn = document.getElementById('scf-submit-btn');
    if (feedback && submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.style.opacity = '0.7';
      feedback.style.display = 'flex';
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  };
</script>

<style>
  .page-hero-banner {
    background: #ffffff;
    padding: clamp(7.5rem, 12vh, 9rem) 0 2.5rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    color: var(--text-dark);
    line-height: 1.15;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 820px;
  }

  /* Status Section */
  .scf-status-section {
    background: #ffffff;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .scf-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .scf-tag {
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    display: inline-block;
  }

  .scf-stage-text {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .scf-status-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    color: var(--text-dark);
    margin-bottom: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .scf-status-lead {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 900px;
  }

  /* Linear Pillars Subheadings */
  .scf-pillars-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .scf-pillars-linear {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 2rem;
    border-top: 1px solid var(--border-light);
  }

  .scf-pillar-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border-light);
    align-items: flex-start;
  }

  .scf-pillar-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .scf-pillar-code {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .scf-pillar-heading {
    font-size: 1.35rem;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .scf-pillar-text {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-body);
    margin: 0;
  }

  .p-status-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .green-badge {
    background: #ecfdf5;
    color: #059669;
    border: 1px solid #a7f3d0;
  }

  .slate-badge {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }

  /* Interactive Waitlist Form */
  .scf-waitlist-section {
    background: #ffffff;
    padding: 4.5rem 0;
  }

  .scf-form-container {
    max-width: 820px;
    margin: 2rem auto 0 auto;
  }

  .scf-neu-form {
    background: #f8fafc;
    padding: 2.5rem;
    border-radius: 16px;
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 
      6px 6px 16px rgba(0, 0, 0, 0.04),
      -6px -6px 16px rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .neu-input {
    font-family: inherit;
    font-size: 0.95rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    box-shadow: inset 1.5px 1.5px 3px rgba(0, 0, 0, 0.05);
    color: var(--text-dark);
    outline: none;
    transition: all 0.2s ease;
  }

  .neu-input:focus {
    border-color: var(--red-primary);
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.15);
  }

  .form-submit-row {
    margin-top: 0.5rem;
    display: flex;
    justify-content: flex-start;
  }

  .scf-feedback-msg {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: #ecfdf5;
    border: 1px solid #6ee7b7;
    border-radius: 8px;
    color: #065f46;
    font-size: 0.95rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1.5;
  }

  .feedback-icon {
    font-size: 1.2rem;
    font-weight: 800;
    color: #059669;
  }

  @media (max-width: 860px) {
    .scf-pillar-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .form-row-2col {
      grid-template-columns: 1fr;
    }
    .scf-neu-form {
      padding: 1.5rem;
    }
  }
</style>
