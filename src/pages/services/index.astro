---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import GromacsPricingSection from '../../components/GromacsPricingSection.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="Services & GROMACS Cloud | PT CHAIN ASIA CONECT" 
  description="Explore official Enterprise Medical Engineering Machine systems, PACS diagnostic software licensing, and GROMACS Cloud Dedicated Server rental by PT CHAIN ASIA CONECT."
>
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text" data-i18n="services_hero_tag">PRODUCTS, SERVICES & CLOUD COMPUTING</span>
        <h1 class="page-hero-title">
          <span data-lang-en>Specialized</span><span data-lang-id>Layanan</span> <span class="red-text">Services & GROMACS Cloud</span>
        </h1>
        <p class="page-hero-desc" data-i18n="services_hero_desc">
          Official engineering procurement, high-precision medical machinery systems, 3D PACS diagnostic cloud licensing, and enterprise-grade GROMACS Cloud Dedicated Server infrastructure across Indonesia & Asia Region.
        </p>
      </div>
    </section>

    <!-- Services Component -->
    <ServicesSection />

    <!-- GROMACS Cloud Dedicated Server Pricing -->
    <GromacsPricingSection />
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .page-hero-desc {
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    color: var(--text-muted);
    max-width: 800px;
    line-height: 1.6;
  }
</style>
