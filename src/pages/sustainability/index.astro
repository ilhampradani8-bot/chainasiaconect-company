---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Sustainability, ESG & Mitra Langit | PT CHAIN ASIA CONECT" description="Environmental, Social, and Governance (ESG) policies, Mitra Langit (10% Net Profit Tabarru' & Sedekah), and social responsibility initiatives at PT CHAIN ASIA CONECT.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">ENVIRONMENTAL, SOCIAL & MITRA LANGIT</span>
        <h1 class="page-hero-title">Sustainability <span class="red-text">& Mitra Langit Framework</span></h1>
        <p class="page-hero-desc">
          Building long-term business blessing and economic empowerment by dedicating 10% of monthly net profit to social welfare, local micro-business growth, and community support in Krui, Pesisir Barat, Lampung.
        </p>
      </div>
    </section>

    <!-- Mitra Langit / Spiritual Marketing & 10% Tabarru' Commitment (Fullwidth Editorial, No Cards) -->
    <section class="fullwidth-section mitra-langit-section">
      <div class="container">
        
        <div class="ml-header-wrap">
          <div class="ml-badge-row">
            <span class="ml-tag red-bg">AKAD KEMITRAAN LANGIT & SOCIAL COMPACT</span>
            <span class="ml-pct red-text">10% NET PROFIT ALLOCATION</span>
          </div>
          <h2 class="ml-main-title">Mitra Utama (Mitra Langit / Dana Tabarru' & Sedekah)</h2>
          <p class="ml-intro">
            In accordance with our Founders' Commitment (MoU signed by President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Vice President Director <strong>Putri Wulandari, S.T.</strong>), PT CHAIN ASIA CONECT designates <strong>10% of monthly Net Profit</strong> as Dana Tabarru' & Sedekah to bring spiritual blessing, ethical protection, and economic empowerment to local communities.
          </p>
        </div>

        <div class="ml-focus-linear-list">
          
          <div class="ml-linear-row">
            <div class="ml-seq-col">
              <span class="ml-num red-text">01</span>
              <span class="ml-status-pill green-badge">Monthly Allocation</span>
            </div>
            <div class="ml-info-col">
              <h4 class="ml-heading">Orphan & Dhuafa Welfare</h4>
              <p class="ml-detail">Direct monthly financial and nutritional assistance for orphans and underprivileged families in Pekon Seray / Pesisir Tengah, Pesisir Barat, Lampung.</p>
            </div>
          </div>

          <div class="ml-linear-row">
            <div class="ml-seq-col">
              <span class="ml-num red-text">02</span>
              <span class="ml-status-pill slate-badge">Skill & Enterprise</span>
            </div>
            <div class="ml-info-col">
              <h4 class="ml-heading">Local Micro-Business Empowerment</h4>
              <p class="ml-detail">Mentorship, digital literacy skill development, and micro-enterprise guidance for community members and home entrepreneurs across Krui, Pesisir Barat.</p>
            </div>
          </div>

          <div class="ml-linear-row">
            <div class="ml-seq-col">
              <span class="ml-num red-text">03</span>
              <span class="ml-status-pill red-badge">Corporate Baitul Maal</span>
            </div>
            <div class="ml-info-col">
              <h4 class="ml-heading">Corporate Baitul Maal & Community Infrastructure Fund</h4>
              <p class="ml-detail">Dedicated company Baitul Maal and local mosque facility support to ensure business activities remain a continuous, sustainable act of worship.</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ESG Core Pillars (Fullwidth Editorial Layout, No Cards) -->
    <section class="fullwidth-section esg-section">
      <div class="container">
        
        <div class="section-intro">
          <span class="section-tag red-text">SUSTAINABILITY STRATEGY</span>
          <h2>3 Pillars of Our ESG Commitment</h2>
        </div>

        <div class="esg-editorial-grid">
          
          <div class="esg-column-item">
            <div class="esg-top-line">
              <span class="esg-letter red-text">E</span>
              <span class="esg-pillar-label">ENVIRONMENT</span>
            </div>
            <h3 class="esg-heading">Environmental Responsibility</h3>
            <p class="esg-text">Promoting paperless medical cloud diagnostics (PACS), reducing physical carbon footprint in logistics corridors, and supporting green technology adoption across Indonesia.</p>
          </div>

          <div class="esg-column-item">
            <div class="esg-top-line">
              <span class="esg-letter red-text">S</span>
              <span class="esg-pillar-label">SOCIAL</span>
            </div>
            <h3 class="esg-heading">Social & Human Capital</h3>
            <p class="esg-text">Empowering local workforce growth, upholding equal opportunity employment, and conducting health & educational CSR programs in regional business operational areas.</p>
          </div>

          <div class="esg-column-item">
            <div class="esg-top-line">
              <span class="esg-letter red-text">G</span>
              <span class="esg-pillar-label">GOVERNANCE</span>
            </div>
            <h3 class="esg-heading">Governance & Ethics</h3>
            <p class="esg-text">Operating under complete legal transparency with SK Kemenkumham AHU-A117353, zero-tolerance anti-bribery policies, and strict compliance with corporate regulatory oversight.</p>
          </div>

        </div>

        <!-- Neumorphic Action Buttons -->
        <div class="sustainability-actions">
          <a href="mailto:info@chainasiaconect.company" class="btn-more-red">
            <span>Inquire Sustainability & Social Compact →</span>
          </a>
          <a href="mailto:sales@chainasiaconect.company" class="btn-secondary-clean">
            <span>Business & ESG Partnership Desk</span>
          </a>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: clamp(7.5rem, 12vh, 9rem) 0 3.5rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Mitra Langit Section (Fullwidth Linear Layout) */
  .mitra-langit-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
  }

  .ml-header-wrap {
    max-width: 900px;
    margin-bottom: 3rem;
  }

  .ml-badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .ml-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }

  .ml-tag.red-bg {
    background: var(--red-primary);
    color: #ffffff;
  }

  .ml-pct {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .ml-main-title {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .ml-intro {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-body);
    margin: 0;
  }

  /* Linear List (No Cards) */
  .ml-focus-linear-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .ml-linear-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--border-light);
    align-items: flex-start;
  }

  .ml-linear-row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .ml-seq-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ml-num {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
  }

  .ml-status-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-block;
    width: fit-content;
  }

  .green-badge {
    background: #f0fdf4;
    color: #16a34a;
    border: 1px solid #dcfce7;
  }

  .slate-badge {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #e2e8f0;
  }

  .red-badge {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fee2e2;
  }

  .ml-heading {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.4rem;
  }

  .ml-detail {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.7;
    margin: 0;
  }

  /* ESG Section (Fullwidth Columns, No Cards) */
  .esg-section {
    background: #f8fafc;
    padding: 4.5rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .section-intro {
    margin-bottom: 2.5rem;
  }

  .section-intro h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin-top: 0.35rem;
    color: var(--text-dark);
  }

  .esg-editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .esg-column-item {
    display: flex;
    flex-direction: column;
  }

  .esg-top-line {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .esg-letter {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .esg-pillar-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .esg-heading {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.65rem;
  }

  .esg-text {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.75;
    margin: 0;
  }

  .sustainability-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  @media (max-width: 992px) {
    .esg-editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .ml-linear-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .sustainability-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .sustainability-actions .btn-more-red,
    .sustainability-actions .btn-secondary-clean {
      width: 100%;
      text-align: center;
    }
  }
</style>
