---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Sustainability, ESG & Mitra Langit | PT CHAIN ASIA CONECT" description="Environmental, Social, and Governance (ESG) policies, Mitra Langit (10% Net Profit Tabarru' & Sedekah), and social responsibility initiatives at PT CHAIN ASIA CONECT.">
  <Header />
  <main>
    <!-- Page Hero Banner -->
    <section class="page-hero-banner">
      <div class="container">
        <span class="hero-tag red-text">ENVIRONMENTAL, SOCIAL & MITRA LANGIT</span>
        <h1 class="page-hero-title">Sustainability <span class="red-text">& Mitra Langit Framework</span></h1>
        <p class="page-hero-desc">
          Building long-term business blessing and economic empowerment by dedicating 10% of monthly net profit to social welfare, local micro-business growth, and community support in Krui, Pesisir Barat, Lampung.
        </p>
      </div>
    </section>

    <!-- Mitra Langit / Spiritual Marketing & 10% Tabarru' Commitment -->
    <section class="fullwidth-section mitra-langit-section">
      <div class="container">
        <div class="mitra-langit-card">
          <div class="ml-badge-row">
            <span class="ml-tag red-bg">AKAD KEMITRAAN LANGIT & SOCIAL COMPACT</span>
            <span class="ml-pct red-text">10% NET PROFIT ALLOCATION</span>
          </div>
          <h2>Mitra Utama (Mitra Langit / Dana Tabarru' & Sedekah)</h2>
          <p class="ml-intro">
            In accordance with our Founders' Commitment (MoU signed by President Director <strong>Ilham Pradani, S.H. (Cand.)</strong> and Financial Director <strong>Putri Wulan, S.T.</strong>), PT CHAIN ASIA CONECT designates <strong>10% of monthly Net Profit</strong> as Dana Tabarru' & Sedekah to bring spiritual blessing, ethical protection, and economic empowerment to local communities.
          </p>

          <div class="ml-focus-grid">
            <div class="ml-focus-card">
              <span class="ml-icon red-text">01</span>
              <h4>Orphan & Dhuafa Welfare</h4>
              <p>Direct monthly assistance for orphans and underprivileged families in Pekon Seray / Pesisir Tengah, Pesisir Barat, Lampung.</p>
            </div>

            <div class="ml-focus-card">
              <span class="ml-icon red-text">02</span>
              <h4>Local Micro-Business Empowerment</h4>
              <p>Mentorship, skill development, and micro-enterprise guidance for community members in Krui, Pesisir Barat.</p>
            </div>

            <div class="ml-focus-card">
              <span class="ml-icon red-text">03</span>
              <h4>Corporate Baitul Maal & Community Fund</h4>
              <p>Dedicated company Baitul Maal and mosque fund support to ensure business activities remain a continuous act of worship.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ESG Core Pillars -->
    <section class="fullwidth-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-tag red-text">SUSTAINABILITY STRATEGY</span>
          <h2>3 Pillars of Our ESG Commitment</h2>
          <div class="esg-grid">
            <div class="esg-card">
              <span class="esg-letter red-text">E</span>
              <h3>Environmental Responsibility</h3>
              <p>Promoting paperless medical cloud diagnostics (PACS), reducing physical carbon footprint in logistics, and supporting green technology adoption across Indonesia.</p>
            </div>

            <div class="esg-card">
              <span class="esg-letter red-text">S</span>
              <h3>Social & Human Capital</h3>
              <p>Empowering local workforce growth, upholding equal opportunity employment, and conducting health & educational CSR programs in regional business areas.</p>
            </div>

            <div class="esg-card">
              <span class="esg-letter red-text">G</span>
              <h3>Governance & Ethics</h3>
              <p>Operating under complete legal transparency with SK Kemenkumham AHU-A117353, zero-tolerance anti-bribery policies, and regulatory oversight.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero-banner {
    background: #f8fafc;
    border-bottom: 1px solid var(--border-light);
    padding: 4rem 0 3rem 0;
  }

  .hero-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    color: var(--text-body);
    max-width: 800px;
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Mitra Langit Card */
  .mitra-langit-section {
    padding: 3.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
  }

  .mitra-langit-card {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--red-primary);
    border-radius: 6px;
    padding: 2.5rem;
  }

  .ml-badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .ml-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
  }

  .ml-tag.red-bg {
    background: var(--red-primary);
    color: #ffffff;
  }

  .ml-pct {
    font-size: 1.05rem;
    font-weight: 800;
  }

  .mitra-langit-card h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .ml-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-body);
    max-width: 900px;
    margin-bottom: 2rem;
  }

  .ml-focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .ml-focus-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 1.5rem;
  }

  .ml-icon {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .ml-focus-card h4 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0.35rem 0 0.5rem 0;
  }

  .ml-focus-card p {
    font-size: 0.9rem;
    color: var(--text-body);
    line-height: 1.55;
    margin: 0;
  }

  .section-intro h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.35rem 0 1.5rem 0;
    color: var(--text-dark);
  }

  .esg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .esg-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    padding: 2rem;
    border-radius: 4px;
  }

  .esg-letter {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
  }

  .esg-card h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .esg-card p {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.6;
  }
</style>
